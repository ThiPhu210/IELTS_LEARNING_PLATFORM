<div class="flex flex-col items-center justify-center px-6 pt-8 mx-auto md:h-screen dark:bg-gray-900">

  <!-- Logo -->
  <%= link_to root_path,
      class: "flex items-center justify-center mb-8 text-2xl font-semibold lg:mb-10 dark:text-white" do %>
    <%= image_tag "logo.svg", class: "mr-4 h-11", alt: "Logo" %>
    <span>IELTS Platform</span>
  <% end %>

  <!-- Card -->
  <div class="w-full max-w-xl p-6 space-y-8 sm:p-8 bg-white rounded-lg shadow dark:bg-gray-800">

    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
      Create a Free Account
    </h2>

    <!-- Error messages -->
    <% if resource.errors.any? %>
      <div class="p-4 text-sm text-red-700 bg-red-100 rounded-lg">
        <ul class="list-disc list-inside">
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Devise Form -->
    <%= form_for(resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: { class: "mt-8 space-y-6" }) do |f| %>

      <!-- Full name -->
      <div>
        <%= f.label :full_name,
            "Full name",
            class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

        <%= f.text_field :full_name,
            required: true,
            autofocus: true,
            placeholder: "Nguyen Van A",
            class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg
                    focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5
                    dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <!-- Email -->
      <div>
        <%= f.label :email,
            class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

        <%= f.email_field :email,
            required: true,
            autocomplete: "email",
            placeholder: "name@company.com",
            class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg
                    focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5
                    dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <!-- Password -->
      <div>
        <%= f.label :password,
            class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

        <%= f.password_field :password,
            required: true,
            autocomplete: "new-password",
            placeholder: "••••••••",
            class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg
                    focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5
                    dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <!-- Confirm password -->
      <div>
        <%= f.label :password_confirmation,
            "Confirm password",
            class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

        <%= f.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "••••••••",
            class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg
                    focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5
                    dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <!-- Terms -->
      <div class="flex items-start">
        <div class="flex items-center h-5">
          <input type="checkbox" required
            class="w-4 h-4 border-gray-300 rounded bg-gray-50
                   focus:ring-3 focus:ring-blue-300 dark:bg-gray-700">
        </div>
        <div class="ml-3 text-sm">
          <span class="font-medium text-gray-900 dark:text-white">
            I accept the
            <a href="#" class="text-blue-700 hover:underline">Terms and Conditions</a>
          </span>
        </div>
      </div>

      <!-- Submit -->
      <%= f.submit "Create account",
          class: "w-full px-5 py-3 text-base font-medium text-center text-white
                  bg-blue-600 rounded-lg hover:bg-blue-700
                  focus:ring-4 focus:ring-blue-300" %>

      <!-- Login link -->
      <div class="text-sm font-medium text-gray-500 dark:text-gray-400">
        Already have an account?
        <%= link_to "Login here",
            new_user_session_path,
            class: "text-blue-700 hover:underline" %>
      </div>

    <% end %>
  </div>
</div>
