<div class="flex flex-col items-center justify-center px-6 py-8 mx-auto min-h-screen bg-gray-50 dark:bg-gray-900">

  <!-- Logo -->
  <%= link_to root_path,
        class: "flex items-center mb-6 text-2xl font-semibold text-gray-900 dark:text-white" do %>
    <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" class="h-16"/>
  <% end %>

  <!-- Card -->
  <div class="w-full bg-white rounded-lg shadow sm:max-w-md dark:bg-gray-800">
    <div class="p-6 space-y-6 sm:p-8">

      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
        Forgot your password?
      </h2>

      <p class="text-sm text-gray-500 dark:text-gray-400">
        Just enter your email and we’ll send you a reset password link.
      </p>

      <%= form_for(resource,
            as: resource_name,
            url: password_path(resource_name),
            html: { method: :post, class: "space-y-6" }) do |f| %>

        <!-- Error -->
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email -->
        <div>
          <%= f.label :email,
                class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "name@email.com",
                class: "bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg
                        focus:ring-indigo-500 focus:border-indigo-500 block w-full p-2.5
                        dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
        </div>

        <!-- Submit -->
        <%= f.submit "Send reset password instructions",
              class: "w-full text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-red-500 dark:hover:bg-red-600" %>
      <% end %>

      <!-- Links -->
      <div class="text-sm text-center text-gray-500 dark:text-gray-400">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>
