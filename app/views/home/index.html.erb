  <%= image_tag "vietnam-svgrepo-com.svg", class: "icon icon-2" %>
  <%= image_tag "australia-svgrepo-com.svg", class: "icon icon-3" %>
  <%= image_tag "india-svgrepo-com.svg", class: "icon icon-4" %>
