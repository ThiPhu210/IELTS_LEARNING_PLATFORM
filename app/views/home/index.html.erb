      <%= link_to "Khóa học của tôi", students_courses_path(paid: true),
            style: "display:inline-flex;align-items:center;gap:8px;padding:12px 26px;background:transparent;color:#fff;font-size:14px;font-weight:700;border-radius:var(--r-md);text-decoration:none;border:1.5px solid rgba(255,255,255,.4);transition:all .2s;",
            onmouseover: "this.style.background='rgba(255,255,255,.1)'",
            onmouseout:  "this.style.background='transparent'" %>
    </div>
  </div>
</section>

<!-- ═══════ PAYMENT MODAL ═══════ -->
<div class="modal-overlay" id="paymentModal">
  <div class="modal-bg" onclick="closePaymentModal()"></div>
  <div class="modal-box">
    <button class="modal-close" onclick="closePaymentModal()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="modal-heading">Thanh toán</div>
    <div class="modal-course" id="modalCourseName"></div>
    <div class="modal-price"  id="modalCoursePrice"></div>
    <form id="paymentForm" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="course_id" id="modalCourseId">
      <label class="pay-method"><input type="radio" name="payment_method" value="vnpay" checked><span>💳 VNPay</span></label>
      <label class="pay-method"><input type="radio" name="payment_method" value="momo"><span>💜 MoMo</span></label>
      <button type="submit" class="modal-submit">Xác nhận thanh toán →</button>
    </form>
  </div>
</div>

<!-- ═══════ CERTIFICATE MODAL ═══════ -->
<div class="cert-modal-overlay" id="certModal">
  <div class="cert-modal-bg" onclick="closeCertModal()"></div>
  <div class="cert-modal-box">
    <button class="cert-modal-close" onclick="closeCertModal()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="cert-modal-header">
      <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" alt="IELTS">
      <h3>📜 IELTS CERTIFICATION FROM LEARNER</h3>
    </div>
    <div class="cert-modal-body" id="certModalBody"></div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {

  // ── Course slider ──
  const courseTrack = document.getElementById("courseTrack")
  const courseDots  = document.querySelectorAll("#courseDots li")
  const totalCourses = <%= courses.size %>
  const perPage = 3
  const totalPages = Math.ceil(totalCourses / perPage)

  if (courseTrack && totalCourses > perPage) {
    let ci = 1, cTimer = null
    const cStep = 100 / perPage
    courseTrack.style.transform = `translateX(-${cStep * perPage}%)`

    function moveCourse(i, a = true) {
      courseTrack.style.transition = a ? "transform .65s cubic-bezier(.4,0,.2,1)" : "none"
      courseTrack.style.transform = `translateX(-${i * cStep * perPage}%)`
    }
    function updateCourseDots(page) {
      courseDots.forEach(d => d.classList.remove("active"))
      if (courseDots[page]) courseDots[page].classList.add("active")
    }
    function startCourse() {
      cTimer = setInterval(() => {
        ci++; moveCourse(ci)
        if (ci === totalPages + 1) setTimeout(() => { ci = 1; moveCourse(ci, false) }, 700)
        updateCourseDots((ci - 1) % totalPages)
      }, 4000)
    }
    function stopCourse() { clearInterval(cTimer) }

    courseDots.forEach((dot, i) => {
      dot.addEventListener("click", () => { stopCourse(); ci = i + 1; moveCourse(ci); updateCourseDots(i); startCourse() })
    })
    courseTrack.addEventListener("mouseenter", stopCourse)
    courseTrack.addEventListener("mouseleave", startCourse)
    startCourse()
  }

  // ── Teacher slider ──
  const teacherTrack = document.getElementById("teacherTrack")
  const teacherCount = <%= teachers.size %>
  if (teacherTrack && teacherCount > 3) {
    let ti = 3, tTimer = null
    function moveTeacher(i, a = true) {
      teacherTrack.style.transition = a ? "transform .65s cubic-bezier(.4,0,.2,1)" : "none"
      teacherTrack.style.transform = `translateX(-${(i * 100) / 3}%)`
    }
    function startTeacher() {
      tTimer = setInterval(() => {
        ti++; moveTeacher(ti)
        if (ti === teacherCount + 3) setTimeout(() => { ti = 3; moveTeacher(ti, false) }, 700)
      }, 4500)
    }
    moveTeacher(ti, false)
    teacherTrack.addEventListener("mouseenter", () => clearInterval(tTimer))
    teacherTrack.addEventListener("mouseleave", startTeacher)
    startTeacher()
  }

  // ── Achievement slider ──
  const achieveTrack = document.getElementById("achieveTrack")
  const achieveCount = <%= achievements.size %>
  if (achieveTrack && achieveCount > 3) {
    let ai = 3, aTimer = null
    function moveAchieve(i, a = true) {
      achieveTrack.style.transition = a ? "transform .65s cubic-bezier(.4,0,.2,1)" : "none"
      achieveTrack.style.transform = `translateX(-${(i * 100) / 3}%)`
    }
    function startAchieve() {
      aTimer = setInterval(() => {
        ai++; moveAchieve(ai)
        if (ai === achieveCount + 3) setTimeout(() => { ai = 3; moveAchieve(ai, false) }, 700)
      }, 4200)
    }
    moveAchieve(ai, false)
    achieveTrack.addEventListener("mouseenter", () => clearInterval(aTimer))
    achieveTrack.addEventListener("mouseleave", startAchieve)
    startAchieve()
  }

  // ── Certificate modal ──
  document.querySelectorAll(".achieve-card[data-cert-url]").forEach(card => {
    card.addEventListener("click", () => {
      document.getElementById("certModalBody").innerHTML = `<img src="${card.dataset.certUrl}" alt="Certificate">`
      document.getElementById("certModal").classList.add("open")
    })
  })
})

function closePaymentModal() { document.getElementById("paymentModal").classList.remove("open") }
function closeCertModal() {
  document.getElementById("certModal").classList.remove("open")
  document.getElementById("certModalBody").innerHTML = ""
}
</script>
