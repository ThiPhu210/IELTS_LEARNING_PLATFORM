<% cache ["navbar", current_user&.role] do %>
  <%= render "home/shared/navbar" %>
<% end %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════
   DESIGN TOKENS
═══════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --ink:          #0d0e14;
  --ink-2:        #3a3d52;
  --ink-3:        #7b7f96;
  --line:         #e8eaf2;
  --bg:           #f2f4f9;
  --surface:      #ffffff;
  --surface-2:    #f7f8fc;
  --primary:      #dc2626;
  --primary-lt:   #fee2e2;
  --primary-glow: rgba(220,38,38,.18);
  --teal:         #0d9488;
  --teal-lt:      #e6faf8;
  --amber:        #d97706;
  --amber-lt:     #fef3e1;
  --rose:         #e11d48;
  --rose-lt:      #fce7ef;
  --emerald:      #059669;
  --emerald-lt:   #e6f7f1;
  --r-sm: 10px; --r-md: 16px; --r-lg: 22px; --r-xl: 28px;
  --shadow-xs: 0 1px 3px rgba(0,0,0,.06);
  --shadow-sm: 0 2px 10px rgba(0,0,0,.07);
  --shadow-md: 0 6px 24px rgba(0,0,0,.09);
  --shadow-lg: 0 16px 48px rgba(0,0,0,.12);
  --font: 'Plus Jakarta Sans', sans-serif;
  --font-serif: 'Instrument Serif', serif;
  --ease: cubic-bezier(.4,0,.2,1);
}

html { scroll-behavior: smooth; }
body { font-family: var(--font); background: var(--bg); color: var(--ink); line-height: 1.6; }

@keyframes fadeUp { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }
@keyframes float  { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }

/* ── Shared helpers ── */
.eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  padding: 4px 12px; border-radius: 20px; margin-bottom: 14px;
}
.sec-title {
  font-family: var(--font-serif);
  font-size: clamp(26px, 3vw, 38px); font-weight: 400;
  letter-spacing: -.02em; color: var(--ink); margin-bottom: 8px;
}
.sec-title em { font-style: italic; color: var(--primary); }
.sec-sub { font-size: 15px; color: var(--ink-3); }
.btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 26px; background: var(--primary); color: #fff;
  font-size: 14px; font-weight: 700; border-radius: var(--r-md);
  text-decoration: none; transition: all .2s var(--ease);
  box-shadow: 0 4px 14px var(--primary-glow); border: none; cursor: pointer; font-family: var(--font);
}
.btn-primary:hover { background: #b91c1c; transform: translateY(-1px); }
.btn-outline {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 26px; background: var(--surface); color: var(--primary);
  font-size: 14px; font-weight: 700; border-radius: var(--r-md);
  text-decoration: none; border: 1.5px solid #fca5a5; transition: all .2s var(--ease);
}
.btn-outline:hover { background: var(--primary-lt); }

/* ═══════════════════════════════════════════
   HERO
═══════════════════════════════════════════ */
.hero {
  background: var(--surface);
  border-bottom: 1.5px solid var(--line);
  padding: 88px 0 80px;
  overflow: hidden; position: relative;
}
.hero::before, .hero::after {
  content: ''; position: absolute; border-radius: 50%;
  pointer-events: none; filter: blur(90px); opacity: .3;
}
.hero::before { width: 520px; height: 520px; background: var(--primary-lt); top: -140px; left: -100px; }
.hero::after  { width: 380px; height: 380px; background: var(--teal-lt);   bottom: -100px; right: -60px; }

.hero-inner {
  max-width: 1200px; margin: 0 auto; padding: 0 32px;
  display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
  position: relative; z-index: 1;
}
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  color: var(--primary); background: var(--primary-lt);
  padding: 5px 13px; border-radius: 30px; margin-bottom: 18px;
  border: 1px solid #fca5a5;
}
.hero-title {
  font-family: var(--font-serif);
  font-size: clamp(32px, 4vw, 54px); font-weight: 400;
  line-height: 1.12; letter-spacing: -.03em; color: var(--ink); margin-bottom: 18px;
}
.hero-title em { font-style: italic; color: var(--primary); }
.hero-title strong { font-family: var(--font); font-weight: 800; color: var(--ink); }
.hero-desc { font-size: 16px; color: var(--ink-3); margin-bottom: 28px; max-width: 480px; line-height: 1.7; }

.feature-list { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 32px; }
.feature-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 14.5px; color: var(--ink-2); font-weight: 500; }
.check-dot {
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--emerald-lt); display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 1px; color: var(--emerald);
}
.hero-cta { display: flex; gap: 12px; flex-wrap: wrap; }

.hero-visual { position: relative; animation: fadeUp .5s var(--ease) .1s both; }
.hero-visual img { width: 100%; border-radius: var(--r-xl); box-shadow: var(--shadow-lg); display: block; }
.hero-float-card {
  position: absolute; bottom: -18px; left: -18px;
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); padding: 14px 18px;
  box-shadow: var(--shadow-md); display: flex; align-items: center; gap: 12px;
  animation: float 4s ease-in-out infinite;
}
.hero-float-icon {
  width: 42px; height: 42px; border-radius: var(--r-sm);
  background: var(--primary-lt); display: flex; align-items: center; justify-content: center; font-size: 20px;
}
.hero-float-card strong { display: block; font-size: 13.5px; font-weight: 700; color: var(--ink); }
.hero-float-card span   { font-size: 12px; color: var(--ink-3); }

/* ═══════════════════════════════════════════
   WHY
═══════════════════════════════════════════ */
.why-wrap { max-width: 1200px; margin: 0 auto; padding: 72px 32px; }
.why-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-top: 40px; }
.why-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); padding: 24px 20px; box-shadow: var(--shadow-xs);
  transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease);
  animation: fadeUp .5s var(--ease) both;
}
.why-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #fca5a5; }
.why-card:nth-child(1){animation-delay:.05s} .why-card:nth-child(2){animation-delay:.10s}
.why-card:nth-child(3){animation-delay:.15s} .why-card:nth-child(4){animation-delay:.20s}
.why-icon { width: 44px; height: 44px; border-radius: var(--r-md); font-size: 22px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
.why-card h3 { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 7px; }
.why-card p  { font-size: 13.5px; color: var(--ink-3); line-height: 1.6; }

/* ═══════════════════════════════════════════
   COURSES SLIDER
═══════════════════════════════════════════ */
.courses-section {
  background: var(--surface);
  border-top: 1.5px solid var(--line); border-bottom: 1.5px solid var(--line);
  padding: 72px 0;
}
.courses-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
.section-header {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin-bottom: 36px; flex-wrap: wrap; gap: 16px;
}
.slider-viewport { overflow: hidden; border-radius: var(--r-lg); }
.slider-track { display: flex; transition: transform .65s var(--ease); will-change: transform; }
.slide-item { flex-shrink: 0; width: 33.333%; padding: 0 10px; }

.course-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-xs);
  transition: transform .22s var(--ease), box-shadow .22s var(--ease), border-color .22s var(--ease);
  display: flex; flex-direction: column;
}
.course-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #fca5a5; }
.course-thumb { position: relative; height: 190px; overflow: hidden; background: var(--primary-lt); display: block; }
.course-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--ease); display: block; }
.course-card:hover .course-thumb img { transform: scale(1.04); }
.course-thumb-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 56px; font-style: italic; color: #fca5a5; }
.band-chip { position: absolute; top: 12px; left: 12px; background: rgba(255,255,255,.92); backdrop-filter: blur(6px); border: 1px solid var(--line); border-radius: 20px; padding: 3px 10px; font-size: 11px; font-weight: 700; color: var(--primary); }
.course-body { padding: 18px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
.course-title { font-size: 15px; font-weight: 700; color: var(--ink); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.course-footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 12px; border-top: 1.5px solid var(--line); gap: 10px; }
.course-price { font-family: var(--font-serif); font-size: 20px; color: var(--ink); letter-spacing: -.02em; }
.act-btn { display: inline-flex; align-items: center; gap: 5px; padding: 8px 14px; border-radius: var(--r-sm); font-size: 13px; font-weight: 700; text-decoration: none; border: none; cursor: pointer; transition: all .2s var(--ease); font-family: var(--font); }
.act-enter   { background: var(--primary); color: #fff; box-shadow: 0 2px 8px var(--primary-glow); }
.act-enter:hover { background: #b91c1c; }
.act-pay     { background: var(--emerald-lt); color: var(--emerald); border: 1.5px solid #a7f3d0; }
.act-pay:hover { background: #d1fae5; }
.act-pending { background: var(--amber-lt); color: var(--amber); border: 1.5px solid #fcd34d; cursor: default; }

.slider-dots { display: flex; justify-content: center; gap: 8px; margin-top: 28px; list-style: none; }
.slider-dots li button { width: 8px; height: 8px; border-radius: 4px; background: var(--line); border: none; cursor: pointer; padding: 0; transition: all .2s var(--ease); }
.slider-dots li.active button { background: var(--primary); width: 22px; }

/* ═══════════════════════════════════════════
   FEATURE / AI PLATFORM
═══════════════════════════════════════════ */
.features-section { background: var(--bg); padding: 72px 0; }
.features-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
.feature-flip-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-xl); padding: 40px;
  display: flex; align-items: center; gap: 48px;
  box-shadow: var(--shadow-sm); position: relative; overflow: hidden;
  transition: box-shadow .3s var(--ease), transform .3s var(--ease);
}
.feature-flip-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.feature-flip-card::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at right, rgba(220,38,38,.06), transparent 60%);
  opacity: 0; transition: opacity .4s var(--ease);
}
.feature-flip-card:hover::before { opacity: 1; }
.feature-text { flex: 1; }
.feature-text h3 { font-family: var(--font-serif); font-size: clamp(22px,2.5vw,30px); margin-bottom: 10px; }
.feature-text h3 em { font-style: italic; color: var(--primary); }
.feature-text p { font-size: 14.5px; color: var(--ink-3); margin-bottom: 24px; line-height: 1.7; }
.feat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.feat-item { display: flex; align-items: center; gap: 9px; font-size: 13.5px; font-weight: 600; color: var(--ink-2); }
.feat-icon { width: 20px; height: 20px; border-radius: 50%; background: var(--primary-lt); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--primary); }
.feature-media { width: 320px; flex-shrink: 0; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-md); position: relative; height: 240px; }
.feature-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .55s ease, transform .55s ease; }
.feature-media .img-after { opacity: 0; transform: scale(1.04); }
.feature-flip-card:hover .img-before { opacity: 0; transform: scale(1.04); }
.feature-flip-card:hover .img-after  { opacity: 1; transform: scale(1); }

/* ═══════════════════════════════════════════
   TEACHERS
═══════════════════════════════════════════ */
.teachers-wrap { max-width: 1200px; margin: 0 auto; padding: 72px 32px; }
.teacher-viewport { overflow: hidden; margin-top: 36px; }
.teacher-track { display: flex; transition: transform .65s var(--ease); will-change: transform; }
.teacher-slide { flex-shrink: 0; width: 33.333%; padding: 0 14px; }
.teacher-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-xl); padding: 28px 22px; text-align: center;
  box-shadow: var(--shadow-xs); transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease);
}
.teacher-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #fca5a5; }
.teacher-avatar { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; margin: 0 auto 16px; border: 3px solid var(--primary-lt); display: block; }
.teacher-avatar-ph { width: 88px; height: 88px; border-radius: 50%; background: var(--primary-lt); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-family: var(--font-serif); font-size: 32px; font-style: italic; color: var(--primary); }
.teacher-name { font-size: 15.5px; font-weight: 800; color: var(--ink); letter-spacing: -.01em; }
.teacher-tag { display: inline-block; margin-top: 7px; font-size: 11.5px; font-weight: 700; color: var(--teal); background: var(--teal-lt); padding: 3px 10px; border-radius: 20px; }
.teacher-exp { font-size: 12px; color: var(--ink-3); margin-top: 7px; }
.teacher-bio { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; margin-top: 12px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

/* ═══════════════════════════════════════════
   ACHIEVEMENTS
═══════════════════════════════════════════ */
.achievements-section {
  background: var(--surface);
  border-top: 1.5px solid var(--line); border-bottom: 1.5px solid var(--line);
  padding: 72px 0;
}
.achievements-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
.achieve-viewport { overflow: hidden; margin-top: 36px; }
.achieve-track { display: flex; transition: transform .65s var(--ease); will-change: transform; }
.achieve-slide { flex-shrink: 0; width: 33.333%; padding: 0 14px; }
.achieve-card {
  background: var(--bg); border: 1.5px solid var(--line);
  border-radius: var(--r-xl); padding: 28px 22px; text-align: center;
  box-shadow: var(--shadow-xs); transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease);
  cursor: pointer;
}
.achieve-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #fca5a5; }
.achieve-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin: 0 auto 14px; border: 3px solid var(--primary-lt); display: block; }
.achieve-avatar-ph { width: 80px; height: 80px; border-radius: 50%; background: var(--amber-lt); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-family: var(--font-serif); font-size: 28px; font-style: italic; color: var(--amber); }
.achieve-name { font-size: 15px; font-weight: 800; color: var(--ink); }
.achieve-title-tag { display: inline-block; margin-top: 6px; font-size: 11.5px; font-weight: 700; color: var(--primary); background: var(--primary-lt); padding: 3px 10px; border-radius: 20px; }
.achieve-year { font-size: 12px; color: var(--ink-3); margin-top: 6px; }
.achieve-desc { font-size: 13.5px; color: var(--ink-2); line-height: 1.6; margin-top: 10px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.band-badge { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; padding: 4px 12px; border-radius: 20px; background: var(--emerald-lt); color: var(--emerald); font-size: 12px; font-weight: 700; border: 1px solid #a7f3d0; }

/* ═══════════════════════════════════════════
   TESTIMONIALS
═══════════════════════════════════════════ */
.testimonials-section { background: var(--bg); padding: 72px 0; }
.testimonials-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
.testi-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-top: 40px; }
.testi-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); padding: 22px 18px; box-shadow: var(--shadow-xs);
  transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease);
  animation: fadeUp .5s var(--ease) both;
}
.testi-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: #fca5a5; }
.testi-card:nth-child(1){animation-delay:.05s} .testi-card:nth-child(2){animation-delay:.10s}
.testi-card:nth-child(3){animation-delay:.15s} .testi-card:nth-child(4){animation-delay:.20s}
.testi-user { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.testi-user img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary-lt); flex-shrink: 0; }
.testi-user-name { font-size: 13.5px; font-weight: 700; color: var(--ink); }
.testi-stars { font-size: 11px; color: var(--amber); letter-spacing: 1px; }
.testi-quote { font-size: 13.5px; color: var(--ink-2); line-height: 1.65; font-style: italic; }
.testi-quote::before { content: '\201C'; font-family: var(--font-serif); font-size: 24px; color: var(--primary); line-height: 0; vertical-align: -8px; margin-right: 2px; }

/* ═══════════════════════════════════════════
   PRESS LOGOS
═══════════════════════════════════════════ */
.press-section {
  background: var(--surface);
  border-top: 1.5px solid var(--line); border-bottom: 1.5px solid var(--line);
  padding: 56px 0;
}
.press-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
.press-header { text-align: center; margin-bottom: 36px; }
.press-header .press-sub { font-size: 13px; font-weight: 600; color: var(--ink-3); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 6px; }
.press-header .press-heading { font-family: var(--font-serif); font-size: 28px; color: var(--ink); }
.press-heading em { font-style: italic; color: var(--primary); }
.press-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; }
.press-item {
  background: var(--surface-2); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); height: 80px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-xs); transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease);
  text-decoration: none;
}
.press-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: #fca5a5; }
.press-item img { max-height: 36px; max-width: 70%; object-fit: contain; filter: grayscale(100%); opacity: .7; transition: filter .2s, opacity .2s; }
.press-item:hover img { filter: grayscale(0%); opacity: 1; }

/* ═══════════════════════════════════════════
   BANNER CTA
═══════════════════════════════════════════ */
.banner-cta { position: relative; overflow: hidden; height: 220px; background: var(--ink); }
.banner-cta-bg { position: absolute; inset: 0; }
.banner-cta-bg img { width: 100%; height: 100%; object-fit: cover; }
.banner-cta-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(13,14,20,.85) 50%, rgba(220,38,38,.4));
  z-index: 1;
}
.banner-cta-content {
  position: absolute; inset: 0; z-index: 2;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column; gap: 20px; text-align: center; padding: 0 24px;
}
.banner-cta-content h2 { font-family: var(--font-serif); font-size: clamp(24px,3vw,40px); font-weight: 400; color: #fff; letter-spacing: -.02em; }
.banner-cta-content h2 em { font-style: italic; color: #fca5a5; }
.banner-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

/* ═══════════════════════════════════════════
   PAYMENT MODAL
═══════════════════════════════════════════ */
.modal-overlay { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; }
.modal-overlay.open { display: flex; }
.modal-bg { position: absolute; inset: 0; background: rgba(13,14,20,.5); backdrop-filter: blur(4px); }
.modal-box {
  position: relative; z-index: 1; background: var(--surface);
  border: 1.5px solid var(--line); border-radius: var(--r-xl);
  box-shadow: var(--shadow-lg); max-width: 440px; width: 90%;
  padding: 36px 32px 32px; animation: fadeUp .25s var(--ease);
}
.modal-close {
  position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; border-radius: 50%;
  background: var(--surface-2); border: 1.5px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--ink-3); transition: all .2s var(--ease);
}
.modal-close:hover { background: var(--rose-lt); color: var(--rose); }
.modal-heading { font-family: var(--font-serif); font-size: 26px; margin-bottom: 4px; }
.modal-course  { font-size: 13.5px; font-weight: 600; color: var(--ink-2); margin-bottom: 4px; }
.modal-price   { font-family: var(--font-serif); font-size: 32px; color: var(--primary); letter-spacing: -.02em; margin-bottom: 22px; }
.pay-method { display: flex; align-items: center; gap: 12px; padding: 13px 16px; border: 1.5px solid var(--line); border-radius: var(--r-md); cursor: pointer; margin-bottom: 10px; background: var(--surface-2); transition: all .2s var(--ease); }
.pay-method:has(input:checked) { border-color: var(--primary); background: var(--primary-lt); }
.pay-method input { accent-color: var(--primary); }
.pay-method span { font-size: 14px; font-weight: 600; color: var(--ink-2); }
.modal-submit { width: 100%; padding: 14px; background: var(--primary); color: #fff; border: none; border-radius: var(--r-md); font-size: 15px; font-weight: 700; font-family: var(--font); cursor: pointer; margin-top: 18px; transition: all .2s var(--ease); box-shadow: 0 4px 14px var(--primary-glow); }
.modal-submit:hover { background: #b91c1c; transform: translateY(-1px); }

/* Certificate Modal */
.cert-modal-overlay { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; }
.cert-modal-overlay.open { display: flex; }
.cert-modal-bg { position: absolute; inset: 0; background: rgba(13,14,20,.6); backdrop-filter: blur(4px); }
.cert-modal-box { position: relative; z-index: 1; background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--r-xl); box-shadow: var(--shadow-lg); max-width: 560px; width: 90%; overflow: hidden; animation: fadeUp .25s var(--ease); }
.cert-modal-header { padding: 20px 24px 16px; border-bottom: 1.5px solid var(--line); display: flex; flex-direction: column; align-items: center; gap: 8px; }
.cert-modal-header img { height: 36px; object-fit: contain; }
.cert-modal-header h3 { font-size: 14px; font-weight: 700; color: var(--ink-2); }
.cert-modal-body { padding: 20px; display: flex; justify-content: center; }
.cert-modal-body img { max-height: 70vh; border-radius: var(--r-md); box-shadow: var(--shadow-md); }
.cert-modal-close { position: absolute; top: 14px; right: 14px; width: 30px; height: 30px; border-radius: 50%; background: var(--surface-2); border: 1.5px solid var(--line); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--ink-3); transition: all .2s var(--ease); }
.cert-modal-close:hover { background: var(--rose-lt); color: var(--rose); }

/* ═══════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════ */
@media (max-width: 1024px) {
  .testi-grid { grid-template-columns: repeat(2,1fr); }
  .why-grid   { grid-template-columns: repeat(2,1fr); }
  .press-grid { grid-template-columns: repeat(4,1fr); }
}
@media (max-width: 960px) {
  .hero-inner { grid-template-columns: 1fr; gap: 40px; }
  .feature-flip-card { flex-direction: column; }
  .feature-media { width: 100%; }
}
@media (max-width: 640px) {
  .hero { padding: 52px 0 44px; }
  .hero-inner, .why-wrap, .courses-inner, .features-inner,
  .teachers-wrap, .achievements-inner, .testimonials-inner,
  .press-inner { padding-left: 20px; padding-right: 20px; }
  .why-grid { grid-template-columns: 1fr; }
  .testi-grid { grid-template-columns: 1fr; }
  .press-grid { grid-template-columns: repeat(2,1fr); }
  .slide-item { width: 88%; }
  .teacher-slide, .achieve-slide { width: 90%; }
  .feat-grid { grid-template-columns: 1fr; }
}
</style>

<!-- ═══════ HERO ═══════ -->
