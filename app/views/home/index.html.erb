<% cache ["navbar", current_user&.role] do %>
  <%= render "home/shared/navbar" %>
<% end %>
<section class="pt-32 pb-24">
  <div class="max-w-7xl mx-auto px-6
              grid grid-cols-2 gap-12 items-start">

    <!-- LEFT -->
    <div class = "bg-pink-50 p-8 rounded-xl shadow-lg">
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight mb-6">

        Learning Speaking with <br> IELTS Expert
        and AI-Integration
      </h1>

      <ul class="text-red-600 space-y-3 text-lg">
        <li class="flex items-start gap-3">
    <%= image_tag "check-circle-svgrepo-com.svg",
      class: "w-5 h-5 mt-1" %>
    <span>Easily to improve your Speaking ability</span>
  </li>

          <li class="flex items-start gap-3">
    <%= image_tag "check-circle-svgrepo-com.svg",
      class: "w-5 h-5 mt-1" %>
    <span>Auto-graded Speaking Test by AI-Integration</span>
  </li>
          <li class="flex items-start gap-3">
    <%= image_tag "check-circle-svgrepo-com.svg",
      class: "w-5 h-5 mt-1" %>
    <span>Ensure your IELTS Speaking goal</span>
  </li>
            <li class="flex items-start gap-3">
    <%= image_tag "check-circle-svgrepo-com.svg",
      class: "w-5 h-5 mt-1" %>
    <span>Improve your Speaking fluency</span>
  </li>
              <li class="flex items-start gap-3">
    <%= image_tag "check-circle-svgrepo-com.svg",
      class: "w-5 h-5 mt-1" %>
    <span>Improve your Speaking </span>
  </li>
  </ul>
  <div class="mt-10 bg-white p-8 rounded-xl shadow-md border border-pink-100">

  <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4">
    Why choose our IELTS Learning Platform?
  </h2>

  <p class="text-gray-600 mb-6 max-w-2xl">
    Our platform combines experienced IELTS experts with Artificial Intelligence
    to help you improve Speaking faster, smarter, and more confidently.
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">

    <div class="flex gap-3">
      <%= image_tag "check-circle-svgrepo-com.svg", class: "w-5 h-5 mt-1" %>
      <span>Real IELTS Speaking topics updated frequently</span>
    </div>

    <div class="flex gap-3">
      <%= image_tag "check-circle-svgrepo-com.svg", class: "w-5 h-5 mt-1" %>
      <span>AI feedback based on IELTS Band Descriptors</span>
    </div>

    <div class="flex gap-3">
      <%= image_tag "check-circle-svgrepo-com.svg", class: "w-5 h-5 mt-1" %>
      <span>Personalized learning path for each learner</span>
    </div>

    <div class="flex gap-3">
      <%= image_tag "check-circle-svgrepo-com.svg", class: "w-5 h-5 mt-1" %>
      <span>Track your Speaking progress over time</span>
    </div>

  </div>

  <!-- CTA -->
  <div class="flex flex-col sm:flex-row gap-4">
    <%= link_to "Start Learning Now",
      students_courses_path(paid:true),
      class: "inline-flex justify-center items-center
              px-8 py-3 rounded-lg bg-red-600 text-white
              font-semibold hover:bg-red-700 transition" %>

    <%= link_to "View All Courses",
      students_courses_path,
      class: "inline-flex justify-center items-center
              px-8 py-3 rounded-lg border border-red-600
              text-red-600 font-semibold hover:bg-red-50 transition" %>
  </div>

</div>

    </div>

    <!-- RIGHT -->
    <div class="flex justify-end">
      <img
        src="https://img.freepik.com/premium-photo/large-language-model-ai-machine-learning_446633-77708.jpg"
        class="w-full max-w-xl rounded-xl shadow-lg"
        alt="AI Learning"
      >
    </div>

  </div>
</section>
<section class="container mx-auto mt-[50px] mb-10">

  <h1 class="text-3xl font-semibold text-gray-900 mt-12 mb-6">
    Popular Courses
  </h1>

  <% courses = @courses.to_a %>
  <% per_page = 3 %>

  <% if courses.any? %>

  <!-- ================= SLIDER VIEWPORT ================= -->
  <div id="slider"
       class="relative overflow-hidden mx-auto"
       style="width: 960px"> <!-- 320 * 3 -->

    <!-- ================= TRACK ================= -->
    <div id="course-track"
         class="flex transition-transform duration-700 ease-in-out"
         style="will-change: transform">

      <% slides = courses.last(per_page) + courses + courses.first(per_page) %>

      <% slides.each do |course| %>
        <div class="flex-shrink-0 px-2" style="width: 320px">


        <div class="bg-white border border-gray-200
        shadow-sm hover:shadow-md
        transition-all duration-300
        overflow-hidden">



            <!-- IMAGE -->
            <%= link_to students_course_path(course) do %>
              <% if course.thumbnail.attached? %>
                <%= image_tag course.thumbnail.variant(resize_to_fill: [320, 180]),
                  class: "w-full h-[180px] object-cover rounded-none" %>
              <% else %>
                <div class="w-full h-[180px] bg-pink-50 flex items-center justify-center">
                  <span class="text-gray-400 text-sm">No image</span>
                </div>
              <% end %>
            <% end %>

            <!-- CONTENT -->
            <div class="p-5">

              <% if course.band_min.present? && course.band_max.present? %>
                <p class="text-xs font-semibold text-blue-600 mb-1">
                  IELTS <%= course.band_min %> – <%= course.band_max %>
                </p>
              <% end %>

              <h3 class="text-base font-semibold text-gray-900 line-clamp-2 mb-3">
                <%= course.title %>
              </h3>

              <div class="flex items-center justify-between">
                <span class="text-lg font-bold text-gray-900">
                  <%= number_to_currency(course.price, unit: "₫", precision: 0) %>
                </span>

           
              </div>
            </div>
          </div>

        </div>
      <% end %>

    </div>
  </div>

  <!-- ================= DOTS ================= -->
  <ul id="slick-dots"
      class="slick-dots flex justify-center gap-3 mt-6 list-none">
    <% (courses.size / per_page.to_f).ceil.times do |i| %>
      <li class="<%= 'slick-active' if i == 0 %>">
        <button class="w-3 h-3 rounded-full"></button>
      </li>
    <% end %>
  </ul>

  <% end %>
</section>
  <!-- ================= TEACHERS SECTION ================= -->
 <section class="container mx-auto px-6 py-20">

  <div class="mb-10">
    <h2 class="text-3xl font-semibold text-gray-900">
      Đội ngũ giáo viên
    </h2>
    <p class="text-gray-500 mt-2">
      Những giảng viên giàu kinh nghiệm, đồng hành cùng bạn
    </p>
  </div>

  <% teachers = @teacher_profiles.to_a %>
  <% if teachers.any? %>

    <div id="teacher-slider"
         class="relative overflow-hidden mx-auto mt-10 mb-10"
         style="max-width: 1200px">

      <div id="teacher-track"
           class="flex transition-transform duration-700 ease-in-out">

        <% slides = teachers.last(3) + teachers + teachers.first(3) %>

        <% slides.each do |teacher| %>
          <div class="w-1/3 px-4 flex-shrink-0 text-center">

            <% if teacher.avatar.attached? %>
              <%= image_tag teacher.avatar.variant(resize_to_fill: [120,120]),
                class: "w-28 h-28 mx-auto rounded-full object-cover mb-4" %>
            <% else %>
              <div class="w-28 h-28 mx-auto rounded-full bg-gray-200
                          flex items-center justify-center mb-4">
                <span class="text-gray-400 text-xs">No avatar</span>
              </div>
            <% end %>

            <h3 class="text-lg font-semibold text-gray-900">
              <%= teacher.full_name&.upcase || "IELTS SPEAKING TEACHER" %>

            </h3>

            <p class="text-sm text-blue-600 font-medium mt-1">
              <%= teacher.expertise %>
            </p>

            <p class="text-sm text-gray-500 mt-1">
              <%= teacher.experience_years %> năm kinh nghiệm
            </p>

            <p class="text-sm text-gray-600 mt-4 line-clamp-3">
              <%= teacher.bio %>
            </p>

          </div>
        <% end %>

      </div>
    </div>

  <% end %>
</section>
<section class="feature-section">

    <div class="card-left">
    <h3>Unlock Global Opportunities with IELTS</h3>
<p>
  IELTS is more than a test score — it is your passport to study, work, and live globally.
  A strong IELTS foundation opens doors to world-class universities, multinational companies, and international communities.
</p>

