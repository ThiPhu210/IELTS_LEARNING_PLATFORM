      <p class="hero-desc">
        Nền tảng luyện nói IELTS kết hợp giáo viên chuyên môn và AI, giúp bạn cải thiện Speaking nhanh hơn, thông minh hơn.
      </p>
      <ul class="feature-list">
        <% [
          "Easily improve your Speaking ability",
          "Auto-graded Speaking Test by AI",
          "Ensure your IELTS Speaking goal",
          "Personalized feedback & corrections",
          "Track your Speaking progress over time"
        ].each do |f| %>
          <li>
            <div class="check-dot">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <%= f %>
          </li>
        <% end %>
      </ul>
      <div class="hero-cta">
        <%= link_to students_courses_path(paid: true), class: "btn-primary" do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Start Learning Now
        <% end %>
        <%= link_to "View All Courses", students_courses_path, class: "btn-outline" %>
      </div>
    </div>

    <div class="hero-visual">
      <img src="https://img.freepik.com/premium-photo/large-language-model-ai-machine-learning_446633-77708.jpg" alt="AI Learning">
      <div class="hero-float-card">
        <div class="hero-float-icon">🎤</div>
        <div>
          <strong>AI Speaking Scorer</strong>
          <span>IELTS Band 0 – 9.0</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════ WHY ═══════ -->
<section>
  <div class="why-wrap">
    <div class="eyebrow" style="color:var(--teal);background:var(--teal-lt);">Why us</div>
    <h2 class="sec-title">Why choose our <em>IELTS Platform?</em></h2>
    <p class="sec-sub">Kết hợp giáo viên IELTS giàu kinh nghiệm với công nghệ AI tiên tiến.</p>
    <div class="why-grid">
      <% [
        { icon: "📝", bg: "var(--primary-lt)", title: "Real IELTS Topics",    desc: "Speaking topics cập nhật thường xuyên theo đề thi thực tế." },
        { icon: "🤖", bg: "var(--teal-lt)",   title: "AI Feedback",          desc: "Chấm điểm tự động theo IELTS Band Descriptors 4 kỹ năng." },
        { icon: "🎯", bg: "var(--amber-lt)",  title: "Personalized Path",    desc: "Lộ trình học cá nhân hoá theo band mục tiêu của bạn." },
        { icon: "📊", bg: "var(--rose-lt)",   title: "Progress Tracking",    desc: "Biểu đồ tiến độ, lịch sử bài thi và phân tích kỹ năng." },
      ].each do |c| %>
        <div class="why-card">
          <div class="why-icon" style="background:<%= c[:bg] %>"><%= c[:icon] %></div>
          <h3><%= c[:title] %></h3>
          <p><%= c[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════ COURSES ═══════ -->
<section class="courses-section">
  <div class="courses-inner">
    <div class="section-header">
      <div>
        <div class="eyebrow" style="color:var(--primary);background:var(--primary-lt);">Popular Courses</div>
        <h2 class="sec-title" style="margin-bottom:0">Khóa học <em>nổi bật</em></h2>
      </div>
      <%= link_to students_courses_path, class: "btn-outline" do %>
        Xem tất cả
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      <% end %>
    </div>

    <% courses = @courses.to_a %>
    <% per_page = 3 %>

    <% if courses.any? %>
      <div class="slider-viewport">
        <div class="slider-track" id="courseTrack">
          <% (courses.last(per_page) + courses + courses.first(per_page)).each do |course| %>
            <div class="slide-item">
              <div class="course-card">
                <%= link_to students_course_path(course), class: "course-thumb" do %>
                  <% if course.thumbnail.attached? %>
                    <%= image_tag url_for(course.thumbnail), alt: course.title %>
                  <% else %>
                    <div class="course-thumb-ph"><%= course.title[0] %></div>
                  <% end %>
                  <% if course.band_min.present? && course.band_max.present? %>
                    <div class="band-chip">Band <%= course.band_min %> – <%= course.band_max %></div>
                  <% end %>
                <% end %>
                <div class="course-body">
                  <div class="course-title"><%= course.title %></div>
                  <div class="course-footer">
                    <div class="course-price"><%= number_to_currency(course.price, unit: "₫", precision: 0, delimiter: ".") %></div>
                    <% if current_user %>
                      <%
                        access  = current_user.course_accesses.active_status.find_by(course: course)
                        pending = current_user.orders.pending_status.where("created_at > ?", 1.minute.ago).find_by(course: course)
                      %>
                      <% if access %>
                        <%= link_to "Vào học", students_course_path(course), class: "act-btn act-enter" %>
                      <% elsif pending %>
                        <span class="act-btn act-pending">⏳ Đang chờ</span>
                      <% else %>
                        <%= button_to "Đăng ký", students_course_orders_path(course), method: :post, class: "act-btn act-pay" %>
                      <% end %>
                    <% else %>
                      <%= link_to "Đăng ký", new_user_session_path, class: "act-btn act-pay" %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <ul class="slider-dots" id="courseDots">
        <% (courses.size / per_page.to_f).ceil.times do |i| %>
          <li class="<%= 'active' if i == 0 %>"><button></button></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>

