  </div>      
  <div class="card-content">
  <h3>Global IELTS Success Platform</h3>
<p>
  Practice with AI, get real exam feedback, and unlock worldwide opportunities.
</p>
  </div>
<%= image_tag "success-achievement-award-medal-winner-svgrepo-com.svg", class: "icon icon-5" %>
</div>
