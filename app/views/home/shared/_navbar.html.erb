<% navbar_courses = defined?(@navbar_courses) ? @navbar_courses : Course.limit(12) %>

<style>
.nav-root {
  position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
  height: 64px; background: #fff;
  border-bottom: 1px solid #e5e7eb;
  font-family: 'Plus Jakarta Sans', sans-serif;
}
.nav-inner {
  max-width: 1200px; margin: 0 auto; height: 100%;
  padding: 0 24px; display: flex; align-items: center; justify-content: space-between;
}
.nav-left { display: flex; align-items: center; gap: 32px; }
.nav-logo img { height: 32px; display: block; }

/* Explore trigger */
.nav-explore-btn {
  display: flex; align-items: center; gap: 5px;
  font-size: 13.5px; font-weight: 600; color: #374151;
  cursor: pointer; border: none; background: none;
  padding: 6px 2px; transition: color .15s;
  font-family: inherit;
}
.nav-explore-btn:hover { color: #dc2626; }
.nav-explore-btn svg { transition: transform .2s; }
.nav-explore-btn.open svg { transform: rotate(180deg); }

.nav-link {
  font-size: 13.5px; font-weight: 600; color: #374151;
  text-decoration: none; transition: color .15s;
}
.nav-link:hover { color: #dc2626; }

/* Right buttons */
.nav-right { display: flex; align-items: center; gap: 8px; }
.btn-login {
  padding: 7px 18px; font-size: 13.5px; font-weight: 600;
  color: #374151; background: transparent;
  border: 1.5px solid #d1d5db; border-radius: 8px;
  text-decoration: none; transition: all .15s; white-space: nowrap;
}
.btn-login:hover { border-color: #dc2626; color: #dc2626; }
.btn-signup {
  padding: 7px 18px; font-size: 13.5px; font-weight: 700;
  color: #fff; background: #dc2626;
  border: 1.5px solid #dc2626; border-radius: 8px;
  text-decoration: none; transition: all .15s; white-space: nowrap;
}
.btn-signup:hover { background: #b91c1c; border-color: #b91c1c; }

/* Dropdown */
.nav-dropdown {
  position: fixed; top: 64px; left: 0; right: 0; z-index: 9998;
  background: #fff; border-top: 1px solid #f3f4f6;
  box-shadow: 0 20px 40px rgba(0,0,0,.10);
  opacity: 0; pointer-events: none;
  transform: translateY(-6px);
  transition: opacity .18s ease, transform .18s ease;
}
.nav-dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
.nav-dropdown-inner { max-width: 1200px; margin: 0 auto; padding: 32px 24px; }

/* Dropdown header */
.dd-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.dd-title { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #9ca3af; }
.dd-viewall { font-size: 13px; font-weight: 700; color: #dc2626; text-decoration: none; }
.dd-viewall:hover { color: #b91c1c; }

/* Course list - Coursera style */
.dd-courses-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px;
}
.dd-course-item {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 14px; border-radius: 10px;
  text-decoration: none; color: inherit;
  transition: background .12s;
  cursor: pointer;
}
.dd-course-item:hover { background: #fef2f2; }
.dd-course-icon {
  width: 36px; height: 36px; border-radius: 8px;
  background: #fee2e2; display: flex; align-items: center; justify-content: center;
  font-family: 'Instrument Serif', serif; font-style: italic;
  font-size: 16px; color: #dc2626; flex-shrink: 0;
}
.dd-course-info { min-width: 0; }
.dd-course-name {
  font-size: 13px; font-weight: 600; color: #111827;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  display: block;
}
.dd-course-meta { font-size: 11.5px; color: #9ca3af; margin-top: 1px; }

/* Divider + sidebar */
.dd-body { display: flex; gap: 0; }
.dd-courses-wrap { flex: 1; }
.dd-sidebar {
  width: 220px; flex-shrink: 0;
  border-left: 1px solid #f3f4f6; padding-left: 28px; margin-left: 28px;
}
.dd-sidebar-section { margin-bottom: 20px; }
.dd-sidebar-label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #9ca3af; margin-bottom: 10px; }
.dd-sidebar-link {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 0; font-size: 13px; font-weight: 500; color: #374151;
  text-decoration: none; transition: color .12s; border-bottom: none;
}
.dd-sidebar-link:hover { color: #dc2626; }
.dd-sidebar-link .icon { font-size: 15px; }
</style>

<nav class="nav-root">
  <div class="nav-inner">
    <div class="nav-left">
      <a href="<%= root_path %>" class="nav-logo">
        <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" alt="IELTS">
      </a>

      <button class="nav-explore-btn" id="navExploreBtn">
        Courses
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <a href="#" class="nav-link">Teachers</a>
      <a href="#" class="nav-link">Blog</a>
    </div>

    <div class="nav-right">
      <a href="<%= new_user_session_path %>" class="btn-login">Log in</a>
      <a href="<%= new_user_registration_path %>" class="btn-signup">Sign up free</a>
    </div>
  </div>
</nav>

<div class="nav-dropdown" id="navDropdown">
  <div class="nav-dropdown-inner">
    <div class="dd-body">
      <div class="dd-courses-wrap">
        <div class="dd-header">
          <span class="dd-title">All Courses</span>
          <%= link_to "Browse all →", students_courses_path, class: "dd-viewall" %>
        </div>
        <div class="dd-courses-grid">
          <% navbar_courses.each do |course| %>
            <%= link_to students_course_path(course), class: "dd-course-item" do %>
              <div class="dd-course-icon"><%= course.title[0].upcase %></div>
              <div class="dd-course-info">
                <span class="dd-course-name"><%= course.title %></span>
                <% if course.respond_to?(:band_min) && course.band_min.present? %>
                  <div class="dd-course-meta">Band <%= course.band_min %>–<%= course.band_max %></div>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% if navbar_courses.empty? %>
            <p style="color:#9ca3af;font-size:13px;padding:12px;grid-column:1/-1">Chưa có khóa học nào.</p>
          <% end %>
        </div>
      </div>

      <div class="dd-sidebar">
        <div class="dd-sidebar-section">
          <div class="dd-sidebar-label">Practice</div>
          <a href="#" class="dd-sidebar-link"><span class="icon">🤖</span> AI Mock Test</a>
          <a href="#" class="dd-sidebar-link"><span class="icon">🎤</span> Speaking AI</a>
          <a href="#" class="dd-sidebar-link"><span class="icon">✍️</span> Writing Checker</a>
        </div>
        <div class="dd-sidebar-section">
          <div class="dd-sidebar-label">Resources</div>
          <a href="#" class="dd-sidebar-link"><span class="icon">🗺️</span> Study Roadmap</a>
          <a href="#" class="dd-sidebar-link"><span class="icon">📖</span> Blog</a>
          <a href="#" class="dd-sidebar-link"><span class="icon">👥</span> Community</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const btn = document.getElementById("navExploreBtn");
  const dd  = document.getElementById("navDropdown");
  let hoveringBtn = false, hoveringDd = false;

  function open()  { dd.classList.add("open"); btn.classList.add("open"); }
  function close() { dd.classList.remove("open"); btn.classList.remove("open"); }

  btn.addEventListener("mouseenter", () => { hoveringBtn = true; open(); });
  btn.addEventListener("mouseleave", () => { hoveringBtn = false; setTimeout(() => { if (!hoveringDd) close(); }, 80); });
  dd.addEventListener("mouseenter",  () => { hoveringDd = true; });
  dd.addEventListener("mouseleave",  () => { hoveringDd = false; setTimeout(() => { if (!hoveringBtn) close(); }, 80); });
})();
</script>
