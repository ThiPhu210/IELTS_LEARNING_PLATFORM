<% navbar_courses = defined?(@navbar_courses) ? @navbar_courses : Course.limit(12) %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  .ielts-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
    height: 60px; background: #fff;
    border-bottom: 1px solid #f0f0f0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    box-shadow: 0 1px 0 rgba(0,0,0,.06);
  }
  .ielts-nav-inner {
    max-width: 1240px; margin: 0 auto; height: 100%;
    padding: 0 24px; display: flex; align-items: center; gap: 0;
  }

  /* Logo */
  .nav-logo { display: flex; align-items: center; margin-right: 32px; flex-shrink: 0; }
  .nav-logo img { height: 30px; width: auto; display: block; }

  /* Nav items */
  .nav-items { display: flex; align-items: center; gap: 2px; flex: 1; }

  .nav-item {
    position: relative;
    display: flex; align-items: center; gap: 4px;
    padding: 0 12px; height: 60px;
    font-size: 14px; font-weight: 600; color: #1c1d1f;
    text-decoration: none; cursor: pointer;
    border: none; background: none; font-family: inherit;
    white-space: nowrap; transition: color .15s;
  }
  .nav-item:hover { color: #dc2626; }
  .nav-item svg { transition: transform .2s; flex-shrink: 0; }
  .nav-item.dd-open { color: #dc2626; }
  .nav-item.dd-open svg { transform: rotate(180deg); }
  .nav-item.dd-open::after {
    content: ''; position: absolute; bottom: -1px; left: 0; right: 0;
    height: 2px; background: #dc2626;
  }

  /* Auth buttons */
  .nav-auth { display: flex; align-items: center; gap: 10px; margin-left: auto; flex-shrink: 0; }

  .btn-nav-login {
    padding: 8px 20px; font-size: 14px; font-weight: 700;
    color: #1c1d1f; background: transparent;
    border: 1.5px solid #1c1d1f; border-radius: 4px;
    text-decoration: none; cursor: pointer;
    font-family: inherit; transition: all .15s; white-space: nowrap;
  }
  .btn-nav-login:hover { border-color: #dc2626; color: #dc2626; }

  .btn-nav-signup {
    padding: 8px 20px; font-size: 14px; font-weight: 700;
    color: #fff; background: #dc2626;
    border: 1.5px solid #dc2626; border-radius: 4px;
    text-decoration: none; cursor: pointer;
    font-family: inherit; transition: all .15s; white-space: nowrap;
  }
  .btn-nav-signup:hover { background: #b91c1c; border-color: #b91c1c; }

  /* ── DROPDOWN ── */
  .nav-dropdown {
    position: fixed; top: 60px; left: 0; right: 0; z-index: 9998;
    background: #fff; border-bottom: 1px solid #e5e7eb;
    box-shadow: 0 8px 32px rgba(0,0,0,.12);
    opacity: 0; pointer-events: none;
    transform: translateY(-4px);
    transition: opacity .18s ease, transform .18s ease;
  }
  .nav-dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .nav-dropdown-inner { max-width: 1240px; margin: 0 auto; padding: 28px 24px; display: flex; gap: 32px; }

  /* Left: course list */
  .dd-courses { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }

  .dd-course-link {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 12px; border-radius: 4px;
    text-decoration: none; color: inherit;
    transition: background .1s;
    cursor: pointer;
  }
  .dd-course-link:hover { background: #fef2f2; }

  .dd-course-letter {
    width: 32px; height: 32px; border-radius: 4px; flex-shrink: 0;
    background: #fee2e2; display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; color: #dc2626;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .dd-course-text { min-width: 0; padding-top: 1px; }
  .dd-course-name {
    font-size: 13.5px; font-weight: 600; color: #1c1d1f; line-height: 1.35;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .dd-course-link:hover .dd-course-name { color: #dc2626; }
  .dd-course-band { font-size: 11px; font-weight: 600; color: #9ca3af; margin-top: 2px; }

  .dd-viewall-row {
    padding: 12px 0 0; grid-column: 1/-1;
    border-top: 1px solid #f3f4f6; margin-top: 4px;
  }
  .dd-viewall-link {
    font-size: 13.5px; font-weight: 700; color: #dc2626; text-decoration: none;
    display: inline-flex; align-items: center; gap: 5px;
  }
  .dd-viewall-link:hover { color: #b91c1c; }

  /* Right: sidebar */
  .dd-sidebar {
    width: 200px; flex-shrink: 0;
    border-left: 1px solid #f3f4f6; padding-left: 28px;
  }
  .dd-sidebar-section + .dd-sidebar-section { margin-top: 20px; }
  .dd-sidebar-label {
    font-size: 11px; font-weight: 800; letter-spacing: .07em;
    text-transform: uppercase; color: #9ca3af; margin-bottom: 8px;
  }
  .dd-sidebar-link {
    display: flex; align-items: center; gap: 8px; padding: 6px 0;
    font-size: 13.5px; font-weight: 600; color: #374151;
    text-decoration: none; transition: color .12s;
  }
  .dd-sidebar-link:hover { color: #dc2626; }
  .dd-sidebar-link .slink-icon {
    font-size: 14px; width: 18px; text-align: center; flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .dd-courses { grid-template-columns: 1fr 1fr; }
    .nav-item span.chevron-label { display: none; }
  }
  @media (max-width: 540px) {
    .dd-courses { grid-template-columns: 1fr; }
    .btn-nav-login { display: none; }
  }
</style>

<nav class="ielts-nav">
  <div class="ielts-nav-inner">
    <a href="<%= root_path %>" class="nav-logo">
      <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" alt="IELTS">
    </a>

    <div class="nav-items">
      <button class="nav-item" id="ddTrigger">
        Courses
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <a href="#" class="nav-item">Teachers</a>
      <a href="#" class="nav-item">Blog</a>
    </div>

    <div class="nav-auth">
      <a href="<%= new_user_session_path %>" class="btn-nav-login">Log in</a>
      <a href="<%= new_user_registration_path %>" class="btn-nav-signup">Sign up free</a>
    </div>
  </div>
</nav>

<div class="nav-dropdown" id="navDropdown">
  <div class="nav-dropdown-inner">
    <div class="dd-courses">
      <% navbar_courses.each do |course| %>
        <%= link_to students_course_path(course), class: "dd-course-link" do %>
          <div class="dd-course-letter"><%= course.title[0].upcase %></div>
          <div class="dd-course-text">
            <div class="dd-course-name"><%= course.title %></div>
            <% if course.band_min.present? && course.band_max.present? %>
              <div class="dd-course-band">Band <%= course.band_min %> – <%= course.band_max %></div>
            <% elsif course.respond_to?(:price) && course.price.present? %>
              <div class="dd-course-band"><%= number_to_currency(course.price, unit: "₫", precision: 0, delimiter: ".") %></div>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if navbar_courses.empty? %>
        <p style="color:#9ca3af;font-size:13px;padding:10px;grid-column:1/-1">Chưa có khóa học nào.</p>
      <% end %>

      <div class="dd-viewall-row">
        <%= link_to students_courses_path, class: "dd-viewall-link" do %>
          Xem tất cả khóa học
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        <% end %>
      </div>
    </div>

    <div class="dd-sidebar">
      <div class="dd-sidebar-section">
        <div class="dd-sidebar-label">Practice</div>
        <a href="#" class="dd-sidebar-link"><span class="slink-icon">🤖</span>AI Mock Test</a>
        <a href="#" class="dd-sidebar-link"><span class="slink-icon">🎤</span>Speaking AI</a>
        <a href="#" class="dd-sidebar-link"><span class="slink-icon">✍️</span>Writing Checker</a>
      </div>
      <div class="dd-sidebar-section">
        <div class="dd-sidebar-label">Resources</div>
        <a href="#" class="dd-sidebar-link"><span class="slink-icon">🗺️</span>Study Roadmap</a>
        <a href="#" class="dd-sidebar-link"><span class="slink-icon">📖</span>Blog</a>
        <a href="#" class="dd-sidebar-link"><span class="slink-icon">👥</span>Community</a>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const trigger  = document.getElementById('ddTrigger');
  const dropdown = document.getElementById('navDropdown');
  let hoveringDd = false;

  function open()  { dropdown.classList.add('open'); trigger.classList.add('dd-open'); }
  function close() { dropdown.classList.remove('open'); trigger.classList.remove('dd-open'); }

  trigger.addEventListener('mouseenter', open);
  trigger.addEventListener('mouseleave', () => setTimeout(() => { if (!hoveringDd) close(); }, 80));
  dropdown.addEventListener('mouseenter', () => { hoveringDd = true; });
  dropdown.addEventListener('mouseleave', () => { hoveringDd = false; close(); });
  document.addEventListener('click', e => { if (!trigger.contains(e.target) && !dropdown.contains(e.target)) close(); });
})();
</script>
