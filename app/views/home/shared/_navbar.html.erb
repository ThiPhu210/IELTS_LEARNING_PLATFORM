<% navbar_courses = @navbar_courses || Course.limit(8) %>

<nav class="fixed top-0 left-0 z-[9999] w-full h-[68px] bg-white border-b border-gray-100 shadow-sm">
  <div class="max-w-7xl mx-auto h-full px-6 flex items-center justify-between">

    <!-- LEFT -->
    <div class="flex items-center gap-10">
      <a href="<%= root_path %>" class="flex items-center shrink-0">
        <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" class="h-8 w-auto"/>
      </a>

      <!-- Explore trigger -->
      <div id="exploreTrigger" class="flex items-center gap-1.5 cursor-pointer select-none text-sm font-semibold text-gray-700 hover:text-red-600 transition-colors duration-150">
        Courses
        <svg id="exploreIcon" class="w-3.5 h-3.5 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>

      <a href="#" class="text-sm font-semibold text-gray-600 hover:text-red-600 transition-colors">Teachers</a>
      <a href="#" class="text-sm font-semibold text-gray-600 hover:text-red-600 transition-colors">Blog</a>
    </div>

    <!-- RIGHT -->
    <div class="flex items-center gap-3 shrink-0">
      <a href="<%= new_user_session_path %>" class="px-4 py-2 text-sm font-semibold text-gray-700 hover:text-red-600 transition-colors">Login</a>
      <a href="<%= new_user_registration_path %>" class="px-5 py-2.5 text-sm font-semibold text-white bg-red-600 rounded-xl hover:bg-red-700 shadow-sm transition-colors">Sign Up</a>
    </div>
  </div>
</nav>

<!-- DROPDOWN -->
<div id="exploreDropdown"
     class="fixed left-0 top-[68px] w-screen bg-white border-t border-gray-100 shadow-2xl
            opacity-0 pointer-events-none transition-all duration-200 z-[9998]">
  <div class="max-w-7xl mx-auto px-8 py-8">
    <div class="flex gap-10">

      <!-- Course grid - main area -->
      <div class="flex-1">
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest">Popular Courses</h3>
          <%= link_to "View all →", students_courses_path, class: "text-xs font-bold text-red-600 hover:text-red-700" %>
        </div>
        <div class="grid grid-cols-4 gap-3">
          <% navbar_courses.each do |course| %>
            <%= link_to students_course_path(course), class: "group flex flex-col rounded-xl border border-gray-100 hover:border-red-200 hover:shadow-md transition-all duration-200 overflow-hidden bg-white" do %>
              <!-- Thumb -->
              <div class="h-28 bg-red-50 overflow-hidden flex items-center justify-center relative">
                <% if course.thumbnail.attached? %>
                  <%= image_tag url_for(course.thumbnail), class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
                <% else %>
                  <span class="font-serif text-4xl italic text-red-300"><%= course.title[0] %></span>
                <% end %>
                <% if course.respond_to?(:band_min) && course.band_min.present? %>
                  <div class="absolute top-2 left-2 bg-white/90 backdrop-blur text-red-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-red-100">
                    Band <%= course.band_min %>–<%= course.band_max %>
                  </div>
                <% end %>
              </div>
              <!-- Info -->
              <div class="p-3">
                <p class="text-xs font-bold text-gray-800 leading-snug line-clamp-2 group-hover:text-red-600 transition-colors"><%= course.title %></p>
                <% if course.respond_to?(:price) && course.price.present? %>
                  <p class="text-xs text-gray-400 mt-1.5 font-medium"><%= number_to_currency(course.price, unit: "₫", precision: 0, delimiter: ".") %></p>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% if navbar_courses.empty? %>
            <p class="text-sm text-gray-400 col-span-4 py-4 text-center">Chưa có khóa học nào</p>
          <% end %>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="w-52 shrink-0 border-l border-gray-100 pl-8">
        <div class="mb-6">
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Practice</h3>
          <ul class="space-y-2">
            <li><a href="#" class="flex items-center gap-2 text-sm text-gray-600 hover:text-red-600 transition-colors font-medium"><span class="text-base">🤖</span> AI Mock Test</a></li>
            <li><a href="#" class="flex items-center gap-2 text-sm text-gray-600 hover:text-red-600 transition-colors font-medium"><span class="text-base">🎤</span> Speaking AI</a></li>
            <li><a href="#" class="flex items-center gap-2 text-sm text-gray-600 hover:text-red-600 transition-colors font-medium"><span class="text-base">✍️</span> Writing Check</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">Resources</h3>
          <ul class="space-y-2">
            <li><a href="#" class="flex items-center gap-2 text-sm text-gray-600 hover:text-red-600 transition-colors font-medium"><span class="text-base">🗺️</span> Roadmap</a></li>
            <li><a href="#" class="flex items-center gap-2 text-sm text-gray-600 hover:text-red-600 transition-colors font-medium"><span class="text-base">📖</span> Blog</a></li>
            <li><a href="#" class="flex items-center gap-2 text-sm text-gray-600 hover:text-red-600 transition-colors font-medium"><span class="text-base">👥</span> Community</a></li>
          </ul>
        </div>

        <!-- CTA -->
        <div class="mt-6 p-4 bg-red-50 rounded-xl border border-red-100">
          <p class="text-xs font-bold text-red-700 mb-1">🎯 Free Trial</p>
          <p class="text-xs text-red-500 mb-3">Thử học miễn phí ngay hôm nay</p>
          <%= link_to "Bắt đầu ngay →", students_courses_path, class: "block text-center text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-lg py-2 transition-colors" %>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById("exploreTrigger");
  const dropdown = document.getElementById("exploreDropdown");
  const icon = document.getElementById("exploreIcon");
  let hovering = false;

  const show = () => {
    dropdown.classList.remove("opacity-0", "pointer-events-none");
    icon.classList.add("rotate-180");
  };
  const hide = () => {
    dropdown.classList.add("opacity-0", "pointer-events-none");
    icon.classList.remove("rotate-180");
  };

  trigger.addEventListener("mouseenter", show);
  trigger.addEventListener("mouseleave", () => setTimeout(() => { if (!hovering) hide(); }, 80));
  dropdown.addEventListener("mouseenter", () => { hovering = true; show(); });
  dropdown.addEventListener("mouseleave", () => { hovering = false; hide(); });
</script>
