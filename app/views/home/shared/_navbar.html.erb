<nav class="fixed top-0 left-0 z-50 w-full h-16 bg-white border-b border-gray-200">
  <div class="h-full px-3 lg:px-5 lg:pl-3 flex items-center">
    <div class="flex items-center justify-between w-full py-2">

      <!-- Logo -->
      <div class="flex items-center justify-between">
        <a href="<%= admin_dashboard_path %>" class="flex ml-2 md:mr-24">
          <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" class="h-10"/>
        </a>
      </div>

      <!-- Right side -->
      <div class="flex items-center space-x-4">
        
        <!-- Login Button -->
        <a href="<%= new_user_session_path %>" class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 focus:ring-4 focus:ring-red-300">
          Login
        </a>

        <!-- Sign Up Button -->
        <a href="<%= new_user_registration_path %>"  class="px-4 py-2 text-sm font-medium text-blue-600 border border-blue-600 rounded-lg hover:bg-blue-50 focus:ring-4 focus:ring-blue-300">
          Sign Up
        </a>

        <!-- Profile -->
        <div class="flex items-center ml-3">
          <div>
            <button type="button" class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600" id="user-menu-button-2" aria-expanded="false" data-dropdown-toggle="dropdown-2">
              <span class="sr-only">Open user menu</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>


<!-- Flowbite JS -->
<script src="https://unpkg.com/flowbite@latest/dist/flowbite.min.js"></script>
document.addEventListener("DOMContentLoaded", () => {
  const dropdownBtn = document.getElementById("user-menu-button-2");
  const dropdown = document.getElementById("dropdown-2");

  dropdownBtn.addEventListener("click", () => {
    dropdown.classList.toggle("hidden");
  });

  document.addEventListener("click", (e) => {
    if (!dropdown.contains(e.target) && !dropdownBtn.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });
});
