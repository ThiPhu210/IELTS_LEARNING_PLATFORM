<% navbar_courses = defined?(@navbar_courses) ? @navbar_courses : Course.limit(12) %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

.hn-root {
  position: fixed; top: 0; left: 0; right: 0; z-index: 9999;
  height: 62px;
  background: #fff;
  border-bottom: 1px solid #f0f0f0;
  box-shadow: 0 1px 0 rgba(0,0,0,.04);
  font-family: 'Plus Jakarta Sans', sans-serif;
}
.hn-inner {
  max-width: 1200px; margin: 0 auto; height: 100%;
  padding: 0 28px; display: flex; align-items: center; justify-content: space-between;
}
.hn-left  { display: flex; align-items: center; gap: 6px; }
.hn-right { display: flex; align-items: center; gap: 6px; }

/* Logo */
.hn-logo img { height: 30px; display: block; }

/* Nav links */
.hn-trigger, .hn-link {
  display: flex; align-items: center; gap: 4px;
  padding: 7px 12px; border-radius: 8px;
  font-size: 13.5px; font-weight: 600; color: #1f2937;
  background: none; border: none; cursor: pointer;
  text-decoration: none; font-family: inherit;
  transition: background .12s, color .12s;
}
.hn-trigger:hover, .hn-link:hover { background: #f5f5f5; color: #111; }
.hn-trigger.active { background: #fef2f2; color: #dc2626; }
.hn-trigger svg { transition: transform .2s; color: #9ca3af; }
.hn-trigger.active svg { transform: rotate(180deg); color: #dc2626; }

/* Buttons */
.hn-btn-login {
  padding: 7px 16px; font-size: 13.5px; font-weight: 600;
  color: #374151; background: transparent;
  border: 1.5px solid #e5e7eb; border-radius: 9px;
  text-decoration: none; transition: border-color .15s, color .15s;
  font-family: inherit;
}
.hn-btn-login:hover { border-color: #9ca3af; color: #111; }

.hn-btn-signup {
  padding: 7px 18px; font-size: 13.5px; font-weight: 700;
  color: #fff; background: #dc2626;
  border: none; border-radius: 9px;
  text-decoration: none; transition: background .15s;
  font-family: inherit;
}
.hn-btn-signup:hover { background: #b91c1c; }

/* Separator */
.hn-sep { width: 1px; height: 22px; background: #e5e7eb; margin: 0 4px; }

/* ── DROPDOWN ── */
.hn-dropdown {
  position: fixed; top: 62px; left: 0; right: 0; z-index: 9998;
  background: #fff;
  border-top: 1px solid #f3f4f6;
  box-shadow: 0 8px 30px rgba(0,0,0,.09), 0 2px 8px rgba(0,0,0,.04);
  opacity: 0; pointer-events: none; transform: translateY(-4px);
  transition: opacity .15s ease, transform .15s ease;
}
.hn-dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }

.hn-dd-inner {
  max-width: 1200px; margin: 0 auto;
  padding: 28px 28px 24px;
  display: flex; gap: 0;
}

/* Course list */
.hn-dd-courses { flex: 1; min-width: 0; }
.hn-dd-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16px;
}
.hn-dd-label {
  font-size: 10.5px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: #9ca3af;
}
.hn-dd-viewall {
  font-size: 12.5px; font-weight: 700; color: #dc2626;
  text-decoration: none; transition: color .12s;
}
.hn-dd-viewall:hover { color: #b91c1c; }

/* Course grid — Coursera style */
.hn-course-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
}
.hn-course-item {
  display: flex; align-items: flex-start; gap: 11px;
  padding: 10px 12px; border-radius: 10px;
  text-decoration: none; color: inherit;
  transition: background .1s; cursor: pointer;
}
.hn-course-item:hover { background: #fef2f2; }
.hn-course-icon {
  width: 38px; height: 38px; border-radius: 8px; flex-shrink: 0;
  background: #fee2e2;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Instrument Serif', serif; font-style: italic;
  font-size: 18px; font-weight: 400; color: #dc2626;
  margin-top: 1px;
}
.hn-course-info { min-width: 0; }
.hn-course-name {
  font-size: 13px; font-weight: 600; color: #111827;
  line-height: 1.35;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.hn-course-meta { font-size: 11px; color: #9ca3af; margin-top: 3px; font-weight: 500; }
.hn-course-item:hover .hn-course-name { color: #dc2626; }

/* Sidebar */
.hn-dd-sidebar {
  width: 200px; flex-shrink: 0;
  border-left: 1px solid #f3f4f6;
  padding-left: 28px; margin-left: 28px;
}
.hn-sidebar-section { margin-bottom: 22px; }
.hn-sidebar-section:last-child { margin-bottom: 0; }
.hn-sidebar-label {
  font-size: 10.5px; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: #9ca3af; margin-bottom: 10px;
}
.hn-sidebar-link {
  display: flex; align-items: center; gap: 9px;
  padding: 7px 9px; border-radius: 8px;
  font-size: 13px; font-weight: 500; color: #374151;
  text-decoration: none; transition: background .1s, color .1s;
  margin-bottom: 2px;
}
.hn-sidebar-link:hover { background: #fef2f2; color: #dc2626; }
.hn-sidebar-link .si { font-size: 15px; line-height: 1; }

/* CTA box */
.hn-cta-box {
  margin-top: 20px; padding: 14px;
  background: linear-gradient(135deg, #fef2f2, #fff5f5);
  border: 1px solid #fecaca; border-radius: 12px;
}
.hn-cta-box p { font-size: 12px; font-weight: 700; color: #dc2626; margin-bottom: 2px; }
.hn-cta-box span { font-size: 11.5px; color: #ef4444; display: block; margin-bottom: 10px; }
.hn-cta-btn {
  display: block; text-align: center;
  font-size: 12px; font-weight: 700; color: #fff;
  background: #dc2626; padding: 8px; border-radius: 8px;
  text-decoration: none; transition: background .12s;
}
.hn-cta-btn:hover { background: #b91c1c; }

/* Empty state */
.hn-empty { font-size: 13px; color: #9ca3af; padding: 12px; grid-column: 1/-1; text-align: center; }
</style>

<nav class="hn-root">
  <div class="hn-inner">
    <div class="hn-left">
      <a href="<%= root_path %>" class="hn-logo" style="margin-right:8px">
        <img src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png" alt="IELTS">
      </a>

      <button class="hn-trigger" id="hnTrigger">
        Courses
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <a href="#" class="hn-link">Teachers</a>
      <a href="#" class="hn-link">Blog</a>
    </div>

    <div class="hn-right">
      <a href="<%= new_user_session_path %>" class="hn-btn-login">Log in</a>
      <a href="<%= new_user_registration_path %>" class="hn-btn-signup">Get started</a>
    </div>
  </div>
</nav>

<div class="hn-dropdown" id="hnDropdown">
  <div class="hn-dd-inner">

    <!-- Courses -->
    <div class="hn-dd-courses">
      <div class="hn-dd-header">
        <span class="hn-dd-label">All Courses</span>
        <%= link_to "Browse all →", students_courses_path, class: "hn-dd-viewall" %>
      </div>

      <div class="hn-course-grid">
        <% if navbar_courses.any? %>
          <% navbar_courses.each do |course| %>
            <%= link_to students_course_path(course), class: "hn-course-item" do %>
              <div class="hn-course-icon"><%= course.title[0].upcase %></div>
              <div class="hn-course-info">
                <div class="hn-course-name"><%= course.title %></div>
                <div class="hn-course-meta">
                  <% if course.band_min.present? %>Band <%= course.band_min %>–<%= course.band_max %> · <% end %>IELTS Speaking
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <p class="hn-empty">No courses yet.</p>
        <% end %>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="hn-dd-sidebar">
      <div class="hn-sidebar-section">
        <div class="hn-sidebar-label">Practice</div>
        <a href="#" class="hn-sidebar-link"><span class="si">🤖</span> AI Mock Test</a>
        <a href="#" class="hn-sidebar-link"><span class="si">🎤</span> Speaking AI</a>
        <a href="#" class="hn-sidebar-link"><span class="si">✍️</span> Writing Checker</a>
      </div>
      <div class="hn-sidebar-section">
        <div class="hn-sidebar-label">Resources</div>
        <a href="#" class="hn-sidebar-link"><span class="si">🗺️</span> Study Roadmap</a>
        <a href="#" class="hn-sidebar-link"><span class="si">📖</span> Blog</a>
        <a href="#" class="hn-sidebar-link"><span class="si">👥</span> Community</a>
      </div>

      <div class="hn-cta-box">
        <p>🎯 Start for free</p>
        <span>Thử học miễn phí hôm nay</span>
        <%= link_to "Bắt đầu ngay →", students_courses_path, class: "hn-cta-btn" %>
      </div>
    </div>

  </div>
</div>

<script>
(function() {
  const trigger  = document.getElementById('hnTrigger');
  const dropdown = document.getElementById('hnDropdown');
  let ddHover = false;

  function open()  { dropdown.classList.add('open');    trigger.classList.add('active'); }
  function close() { dropdown.classList.remove('open'); trigger.classList.remove('active'); }

  trigger.addEventListener('mouseenter', open);
  trigger.addEventListener('mouseleave', () => setTimeout(() => { if (!ddHover) close(); }, 80));
  dropdown.addEventListener('mouseenter', () => { ddHover = true; });
  dropdown.addEventListener('mouseleave', () => { ddHover = false; close(); });

  document.addEventListener('click', e => {
    if (!trigger.contains(e.target) && !dropdown.contains(e.target)) close();
  });
})();
</script>
