          src="https://vectorseek.com/wp-content/uploads/2023/08/Ielts-Logo-Vector.svg-.png"
          class="h-9 w-auto"
        />
      </a>

      <!-- Explore -->
      <div
        id="exploreTrigger"
        class="flex items-center gap-1 cursor-pointer select-none
               text-sm font-semibold text-gray-700 hover:text-red-600 transition"
      >
        Explore
        <svg id="exploreIcon"
             class="w-4 h-4 transition-transform duration-200"
             fill="none" stroke="currentColor" stroke-width="2"
             viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M19 9l-7 7-7-7" />
        </svg>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="flex items-center gap-4 shrink-0">

      <a href="<%= new_user_session_path %>"
         class="px-5 py-2.5 text-sm font-semibold text-gray-700
                hover:text-red-600 transition">
        Login
      </a>

      <a href="<%= new_user_registration_path %>"
         class="px-6 py-2.5 text-sm font-semibold text-white
                bg-red-600 rounded-xl hover:bg-red-700
                shadow-sm transition">
        Sign Up
      </a>

    </div>

  </div>
</nav>
<!-- FULL SCREEN DROPDOWN -->
<div
  id="exploreDropdown"
  class="fixed left-0 top-20 w-screen bg-white border-t shadow-xl
         opacity-0 pointer-events-none transition-opacity duration-200 z-[9998]"
>
  <div class="max-w-7xl mx-auto px-8 py-10">
    <div class="grid grid-cols-4 gap-8 text-sm">

      <div>
        <h3 class="mb-3 font-semibold text-gray-900">Courses</h3>
        <ul class="space-y-2 text-gray-600">
          <li><a href="#" class="hover:text-red-600">IELTS Foundation</a></li>
          <li><a href="#" class="hover:text-red-600">IELTS Intensive</a></li>
          <li><a href="#" class="hover:text-red-600">IELTS 6.5+</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 font-semibold text-gray-900">Practice</h3>
        <ul class="space-y-2 text-gray-600">
          <li><a href="#" class="hover:text-red-600">Mock Tests</a></li>
          <li><a href="#" class="hover:text-red-600">Writing Checker</a></li>
          <li><a href="#" class="hover:text-red-600">Speaking AI</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 font-semibold text-gray-900">Teachers</h3>
        <ul class="space-y-2 text-gray-600">
          <li><a href="#" class="hover:text-red-600">Vietnamese</a></li>
          <li><a href="#" class="hover:text-red-600">Native</a></li>
        </ul>
      </div>

      <div>
        <h3 class="mb-3 font-semibold text-gray-900">Resources</h3>
        <ul class="space-y-2 text-gray-600">
          <li><a href="#" class="hover:text-red-600">Roadmap</a></li>
          <li><a href="#" class="hover:text-red-600">Blog</a></li>
          <li><a href="#" class="hover:text-red-600">Community</a></li>
        </ul>
      </div>

    </div>
  </div>
</div>
<script>
  const trigger = document.getElementById("exploreTrigger");
  const dropdown = document.getElementById("exploreDropdown");
  const icon = document.getElementById("exploreIcon");

  let isHovering = false;

  const show = () => {
    dropdown.classList.remove("opacity-0", "pointer-events-none");
    icon.classList.add("rotate-180");
  };

  const hide = () => {
    dropdown.classList.add("opacity-0", "pointer-events-none");
    icon.classList.remove("rotate-180");
  };

  trigger.addEventListener("mouseenter", show);
  trigger.addEventListener("mouseleave", () => {
    setTimeout(() => { if (!isHovering) hide(); }, 100);
  });

  dropdown.addEventListener("mouseenter", () => {
    isHovering = true;
    show();
  });

  dropdown.addEventListener("mouseleave", () => {
    isHovering = false;
    hide();
  });
</script>
