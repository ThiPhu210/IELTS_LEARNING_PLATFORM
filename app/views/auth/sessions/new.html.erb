<div
  class="min-h-screen flex items-center justify-center bg-cover bg-center"
  style="background-image: url('<%= asset_path("notus/register_bg_2.png") %>')"

<div class="min-h-screen flex items-center justify-center bg-slate-200 px-4">
  <div class="bg-white rounded-lg shadow-lg relative overflow-hidden w-full max-w-3xl min-h-[420px]">

    <!-- LOGIN FORM -->
    <div class="absolute inset-y-0 left-0 w-full md:w-1/2 flex items-center justify-center">
      <div class="w-full px-10">

        <h2 class="text-2xl font-bold text-center mb-6 text-slate-800">
          Sign In
        </h2>

        <% if flash[:alert] %>
          <div class="mb-4 rounded bg-red-100 text-red-700 px-4 py-2 text-sm">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <%= form_with url: login_path, method: :post, local: true, class: "space-y-4" do %>

          <!-- Email -->
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
              <i class="fas fa-envelope"></i>
            </span>
            <%= email_field_tag :email, params[:email],
              placeholder: "Email",
              required: true,
              class: "pl-10 w-full rounded-md border border-slate-300 px-3 py-2 text-sm
                      focus:outline-none focus:ring-1 focus:ring-lightBlue-500" %>
          </div>

          <!-- Password -->
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
              <i class="fas fa-lock"></i>
            </span>
            <%= password_field_tag :password, nil,
              placeholder: "Password",
              required: true,
              class: "pl-10 w-full rounded-md border border-slate-300 px-3 py-2 text-sm
                      focus:outline-none focus:ring-1 focus:ring-lightBlue-500" %>
          </div>

          <!-- Submit -->
          <div>
            <%= submit_tag "Sign In",
              class: "w-full bg-slate-800 text-white font-bold uppercase
                      px-6 py-2 rounded-md shadow hover:bg-slate-900 transition" %>
          </div>

        <% end %>

        <!-- Register link -->
        <p class="mt-6 text-center text-sm text-slate-600">
          Don’t have an account?
          <a href="<%= register_path %>"
             class="font-semibold text-lightBlue-600 hover:underline">
            Register
          </a>
        </p>

      </div>
    </div>

    <!-- RIGHT PANEL (STATIC TEXT – Notus style) -->
    <div class="hidden md:flex absolute inset-y-0 right-0 w-1/2 bg-slate-800 text-white items-center justify-center">
      <div class="text-center px-8">
        <h3 class="text-2xl font-bold mb-4">Welcome back!</h3>
        <p class="text-slate-200 mb-6">
          Enter your personal details and start your journey with us.
        </p>
      </div>
    </div>

  </div>
</div>
