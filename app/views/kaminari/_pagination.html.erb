<nav class="block">
  <ul class="flex pl-0 rounded list-none flex-wrap">
    <%= paginator.render do %>
      <%= prev_page_tag unless current_page.first? %>

      <% each_page do |page| %>
        <% if page.display_tag? %>
          <% if page.current? %>
            <li>
              <span class="w-8 h-8 text-xs font-semibold flex mx-1 rounded-full
                           items-center justify-center border
                           bg-pink-500 border-pink-500 text-white">
                <%= page %>
              </span>
            </li>
          <% else %>
            <li>
              <%= link_to page, url_for(page: page),
                class: "w-8 h-8 text-xs font-semibold flex mx-1 rounded-full
                        items-center justify-center border
                        bg-transparent border-pink-500 text-pink-500
                        hover:bg-pink-700 hover:text-white" %>
            </li>
          <% end %>
        <% elsif page.gap? %>
          <li>
            <span class="w-8 h-8 mx-1 flex items-center justify-center
                         rounded-full bg-pink-200 text-white pointer-events-none">
              …
            </span>
          </li>
        <% end %>
      <% end %>

      <%= next_page_tag unless current_page.last? %>
    <% end %>
  </ul>
</nav>
