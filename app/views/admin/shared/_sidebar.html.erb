<%# ============================================================
    app/views/admin/shared/_sidebar.html.erb
    Design: Red + Ink — synced with LMS design system
    ============================================================ %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════
   SIDEBAR VARIABLES (inherit from design system)
═══════════════════════════════════════════ */
:root {
  --sb-bg:        #0d0e14;
  --sb-surface:   #13141d;
  --sb-line:      rgba(255,255,255,.07);
  --sb-text:      rgba(255,255,255,.55);
  --sb-text-hover:#ffffff;
  --sb-primary:   #dc2626;
  --sb-primary-lt:rgba(220,38,38,.15);
  --sb-primary-brd:rgba(252,165,165,.2);
  --sb-active-bg: rgba(220,38,38,.12);
  --sb-w:         256px;
  --font:         'Plus Jakarta Sans', sans-serif;
  --font-mono:    'JetBrains Mono', monospace;
  --ease:         cubic-bezier(.4,0,.2,1);
}

/* ═══════════════════════════════════════════
   BASE SIDEBAR
═══════════════════════════════════════════ */
#admin-sidebar {
  position: fixed; top: 64px; left: 0; bottom: 0; z-index: 40;
  width: var(--sb-w);
  background: var(--sb-bg);
  border-right: 1.5px solid var(--sb-line);
  display: flex; flex-direction: column;
  overflow: hidden;
  transition: transform .3s var(--ease);
}

/* Subtle noise texture */
#admin-sidebar::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  opacity: .025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 180px;
}

/* ── Brand / App name strip ── */
.sb-brand {
  display: flex; align-items: center; gap: 10px;
  padding: 16px 18px 14px;
  border-bottom: 1.5px solid var(--sb-line);
  flex-shrink: 0; position: relative; z-index: 1;
}
.sb-brand-icon {
  width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
  background: var(--sb-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
  box-shadow: 0 2px 8px rgba(220,38,38,.4);
}
.sb-brand-name {
  font-family: 'Instrument Serif', serif;
  font-size: 17px; font-style: italic; color: #fff; line-height: 1;
}
.sb-brand-sub {
  font-family: var(--font-mono); font-size: 9px; font-weight: 500;
  color: rgba(255,255,255,.3); letter-spacing: .06em; text-transform: uppercase;
  margin-top: 2px;
}

/* ── Scroll area ── */
.sb-scroll {
  flex: 1; overflow-y: auto; padding: 14px 10px;
  position: relative; z-index: 1;
}
.sb-scroll::-webkit-scrollbar { width: 3px; }
.sb-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.08); border-radius: 2px; }

/* ── Section label ── */
.sb-section-label {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase;
  color: rgba(255,255,255,.22);
  padding: 14px 10px 6px;
}
.sb-section-label:first-child { padding-top: 2px; }

/* ── Nav item ── */
.sb-item {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 10px; border-radius: 10px; margin-bottom: 2px;
  color: var(--sb-text); text-decoration: none;
  font-family: var(--font); font-size: 13px; font-weight: 600;
  transition: background .15s, color .15s;
  cursor: pointer; border: none; background: transparent; width: 100%;
  text-align: left; position: relative;
}
.sb-item:hover {
  background: rgba(255,255,255,.06);
  color: var(--sb-text-hover);
}
.sb-item.active {
  background: var(--sb-active-bg);
  color: #fff;
  border: 1px solid var(--sb-primary-brd);
}
.sb-item.active .sb-item-icon { color: #fca5a5; }
.sb-item.active::before {
  content: '';
  position: absolute; left: 0; top: 20%; bottom: 20%;
  width: 3px; border-radius: 0 2px 2px 0;
  background: var(--sb-primary);
}

/* ── Item icon ── */
.sb-item-icon {
  width: 18px; height: 18px; flex-shrink: 0;
  color: rgba(255,255,255,.3);
  transition: color .15s;
}
.sb-item:hover .sb-item-icon { color: rgba(255,255,255,.65); }

/* ── Item label ── */
.sb-item-label { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ── Item count badge ── */
.sb-item-count {
  font-family: var(--font-mono); font-size: 10px; font-weight: 700;
  padding: 1px 7px; border-radius: 20px;
  background: rgba(255,255,255,.07); color: rgba(255,255,255,.35);
  border: 1px solid rgba(255,255,255,.1);
  flex-shrink: 0;
}
.sb-item.active .sb-item-count {
  background: var(--sb-primary-lt); color: #fca5a5; border-color: var(--sb-primary-brd);
}

/* ── Chevron for dropdowns ── */
.sb-chevron {
  width: 14px; height: 14px; flex-shrink: 0;
  color: rgba(255,255,255,.25);
  transition: transform .25s var(--ease), color .15s;
}
.sb-item[aria-expanded="true"] .sb-chevron {
  transform: rotate(180deg);
  color: rgba(255,255,255,.5);
}

/* ── Dropdown sub-menu ── */
.sb-dropdown {
  overflow: hidden;
  max-height: 0;
  transition: max-height .3s var(--ease), opacity .2s;
  opacity: 0;
}
.sb-dropdown.open {
  max-height: 400px;
  opacity: 1;
}
.sb-sub-item {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 10px 7px 38px; border-radius: 8px; margin-bottom: 1px;
  color: rgba(255,255,255,.4); text-decoration: none;
  font-family: var(--font); font-size: 12.5px; font-weight: 600;
  transition: background .15s, color .15s;
  position: relative;
}
.sb-sub-item::before {
  content: '';
  position: absolute; left: 20px; top: 50%; transform: translateY(-50%);
  width: 4px; height: 4px; border-radius: 50%;
  background: rgba(255,255,255,.2);
  transition: background .15s;
}
.sb-sub-item:hover { background: rgba(255,255,255,.05); color: rgba(255,255,255,.8); }
.sb-sub-item:hover::before { background: #fca5a5; }
.sb-sub-item.active { color: #fca5a5; }
.sb-sub-item.active::before { background: var(--sb-primary); }

/* ── Divider ── */
.sb-divider {
  height: 1.5px; background: var(--sb-line);
  margin: 10px 0;
}

/* ── Bottom user strip ── */
.sb-footer {
  padding: 12px 14px;
  border-top: 1.5px solid var(--sb-line);
  background: rgba(0,0,0,.2);
  flex-shrink: 0; position: relative; z-index: 1;
}
.sb-user {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 10px; border-radius: 10px;
  transition: background .15s; cursor: pointer;
  text-decoration: none;
}
.sb-user:hover { background: rgba(255,255,255,.05); }
.sb-user-avatar {
  width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
  background: var(--sb-primary-lt); border: 1.5px solid var(--sb-primary-brd);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Instrument Serif', serif; font-size: 13px; font-style: italic;
  color: #fca5a5;
}
.sb-user-name  { font-size: 13px; font-weight: 700; color: rgba(255,255,255,.8); line-height: 1.2; }
.sb-user-role  { font-size: 10px; font-family: var(--font-mono); color: rgba(255,255,255,.3); margin-top: 1px; }
.sb-user-arrow { margin-left: auto; color: rgba(255,255,255,.2); flex-shrink: 0; }

/* ── Mobile overlay ── */
#sb-overlay {
  position: fixed; inset: 0; z-index: 39;
  background: rgba(13,14,20,.6); backdrop-filter: blur(4px);
  display: none;
}
#sb-overlay.open { display: block; }

/* ── Responsive ── */
@media (max-width: 640px) {
  #admin-sidebar { transform: translateX(-100%); }
  #admin-sidebar.open { transform: translateX(0); }
}
</style>

<!-- ═══════ SIDEBAR ═══════ -->
<aside id="admin-sidebar">

  <!-- Brand -->
  <div class="sb-brand">
    <div class="sb-brand-icon">🎓</div>
    <div>
      <div class="sb-brand-name">LMS Admin</div>
      <div class="sb-brand-sub">Control Panel</div>
    </div>
  </div>

  <!-- Scrollable nav -->
  <nav class="sb-scroll">

    <!-- OVERVIEW -->
    <div class="sb-section-label">Overview</div>

    <%= link_to admin_dashboard_path rescue link_to("#"),
        class: "sb-item #{current_page?(admin_dashboard_path rescue '#') ? 'active' : ''}",
        title: "Dashboard" do %>
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="3" width="7" height="7" rx="1.5"/>
        <rect x="14" y="14" width="7" height="7" rx="1.5"/>
        <rect x="3" y="14" width="7" height="7" rx="1.5"/>
      </svg>
      <span class="sb-item-label">Dashboard</span>
    <% end %>

    <!-- CONTENT -->
    <div class="sb-section-label">Content</div>

    <!-- Courses (collapsible) -->
    <button class="sb-item" onclick="toggleSbDropdown('dd-courses', this)" aria-expanded="false">
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M12 6.25278V19.2528M12 6.25278C10.8321 5.47686 9.24649 5 7.5 5C5.75351 5 4.16789 5.47686 3 6.25278V19.2528C4.16789 18.4769 5.75351 18 7.5 18C9.24649 18 10.8321 18.4769 12 19.2528M12 6.25278C13.1679 5.47686 14.7535 5 16.5 5C18.2465 5 19.8321 5.47686 21 6.25278V19.2528C19.8321 18.4769 18.2465 18 16.5 18C14.7535 18 13.1679 18.4769 12 19.2528"/>
      </svg>
      <span class="sb-item-label">Courses</span>
      <svg class="sb-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="sb-dropdown" id="dd-courses">
      <%= link_to "All Courses",  admin_courses_path,     class: "sb-sub-item #{current_page?(admin_courses_path) ? 'active' : ''}" %>
      <%= link_to "New Course",   new_admin_course_path,  class: "sb-sub-item #{current_page?(new_admin_course_path) ? 'active' : ''}" %>
    </div>

    <!-- Teachers -->
    <button class="sb-item" onclick="toggleSbDropdown('dd-teachers', this)" aria-expanded="false">
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span class="sb-item-label">Teachers</span>
      <svg class="sb-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="sb-dropdown" id="dd-teachers">
      <%= link_to "All Teachers", admin_teachers_path,    class: "sb-sub-item #{current_page?(admin_teachers_path) ? 'active' : ''}" rescue "" %>
      <%= link_to "New Teacher",  new_admin_teacher_path, class: "sb-sub-item #{current_page?(new_admin_teacher_path) ? 'active' : ''}" rescue "" %>
    </div>

    <!-- Students -->
    <button class="sb-item" onclick="toggleSbDropdown('dd-students', this)" aria-expanded="false">
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span class="sb-item-label">Students</span>
      <svg class="sb-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="sb-dropdown" id="dd-students">
      <%= link_to "All Students", admin_students_path,    class: "sb-sub-item #{current_page?(admin_students_path) ? 'active' : ''}" rescue "" %>
    </div>

    <!-- Achievements -->
    <%= link_to admin_achievements_path rescue "#",
        class: "sb-item #{current_page?(admin_achievements_path rescue '#') ? 'active' : ''}" do %>
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
      </svg>
      <span class="sb-item-label">Achievements</span>
    <% end %>

    <!-- MANAGEMENT -->
    <div class="sb-section-label">Management</div>

    <!-- Orders -->
    <%= link_to (admin_orders_path rescue "#"),
        class: "sb-item #{current_page?(admin_orders_path rescue '#') ? 'active' : ''}" do %>
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span class="sb-item-label">Orders</span>
    <% end %>

    <!-- Payments -->
    <%= link_to (admin_payments_path rescue "#"),
        class: "sb-item #{current_page?(admin_payments_path rescue '#') ? 'active' : ''}" do %>
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      <span class="sb-item-label">Payments</span>
    <% end %>

    <!-- Speaking Attempts -->
    <%= link_to (admin_speaking_attempts_path rescue "#"),
        class: "sb-item #{current_page?(admin_speaking_attempts_path rescue '#') ? 'active' : ''}" do %>
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/>
      </svg>
      <span class="sb-item-label">Speaking Attempts</span>
    <% end %>

    <div class="sb-divider"></div>

    <!-- SYSTEM -->
    <div class="sb-section-label">System</div>

    <!-- Settings -->
    <button class="sb-item" onclick="toggleSbDropdown('dd-settings', this)" aria-expanded="false">
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/>
      </svg>
      <span class="sb-item-label">Settings</span>
      <svg class="sb-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="sb-dropdown" id="dd-settings">
      <a href="#" class="sb-sub-item">General</a>
      <a href="#" class="sb-sub-item">Security</a>
    </div>

    <!-- Sign out -->
    <div class="sb-divider"></div>
    <%= link_to destroy_user_session_path, method: :delete,
        class: "sb-item",
        style: "color:rgba(252,165,165,.6)" do %>
      <svg class="sb-item-icon" fill="none" viewBox="0 0 24 24" stroke="#fca5a5" stroke-width="1.8">
        <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      <span class="sb-item-label" style="color:rgba(252,165,165,.7)">Sign Out</span>
    <% end %>

  </nav>

  <!-- Footer: current user -->
  <div class="sb-footer">
    <div class="sb-user">
      <div class="sb-user-avatar">
        <%= current_user&.full_name&.first&.upcase || 'A' %>
      </div>
      <div>
        <div class="sb-user-name"><%= current_user&.full_name&.truncate(18) || 'Admin' %></div>
        <div class="sb-user-role">Admin</div>
      </div>
      <svg class="sb-user-arrow" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </div>
  </div>

</aside>

<!-- Mobile overlay -->
<div id="sb-overlay" onclick="closeSidebar()"></div>

<script>
/* ── Dropdown toggle ── */
function toggleSbDropdown(id, btn) {
  const dd  = document.getElementById(id);
  const open = dd.classList.contains('open');
  /* Close all */
  document.querySelectorAll('.sb-dropdown.open').forEach(el => el.classList.remove('open'));
  document.querySelectorAll('.sb-item[aria-expanded="true"]').forEach(el => el.setAttribute('aria-expanded','false'));
  if (!open) {
    dd.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
  }
}

/* Auto-open dropdown if a child link is active */
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.sb-dropdown').forEach(dd => {
    if (dd.querySelector('.sb-sub-item.active')) {
      dd.classList.add('open');
      const btn = dd.previousElementSibling;
      if (btn) btn.setAttribute('aria-expanded', 'true');
    }
  });
});

/* ── Mobile sidebar toggle ── */
function openSidebar() {
  document.getElementById('admin-sidebar').classList.add('open');
  document.getElementById('sb-overlay').classList.add('open');
}
function closeSidebar() {
  document.getElementById('admin-sidebar').classList.remove('open');
  document.getElementById('sb-overlay').classList.remove('open');
}

/* Hook into existing hamburger button if present */
const hamburger = document.getElementById('toggleSidebarMobile');
if (hamburger) hamburger.addEventListener('click', openSidebar);
</script>
