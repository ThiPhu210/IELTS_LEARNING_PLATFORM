<h2 class="text-xl font-bold mb-4">Thông tin Học viên</h2>

<%= form_with model: student,
              url: admin_student_path(student),
              method: :patch,
              local: true do |f| %>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :full_name, "Họ tên", class: "label" %>
      <%= f.text_field :full_name, class: "input" %>
    </div>

    <div>
      <%= f.label :email, "Email", class: "label" %>
      <%= f.email_field :email, class: "input" %>
    </div>
  </div>

  <div class="mt-6">
    <%= f.label :thumbnail, "Ảnh đại diện", class: "label" %>
    <% if student.thumbnail.attached? %>
      <div class="mb-3">
        <%= image_tag student.thumbnail.variant(resize_to_fill: [80, 80]).processed,
            class: "rounded-full object-cover border",
            alt: "Thumbnail",
            srcset: "#{url_for(student.thumbnail.variant(resize_to_fill: [80, 80]).processed)}?#{Time.current.to_i}" %>
      </div>
    <% end %>
    <%= f.file_field :thumbnail, class: "input" %>
  </div>

  <div class="mt-6">
    <%= f.label :phone, "Số điện thoại", class: "label" %>
    <%= f.text_field :phone, class: "input" %>
  </div>

  <div class="mt-4">
    <%= f.label :bio, "Giới thiệu", class: "label" %>
    <%= f.text_area :bio, rows: 4, class: "input" %>
  </div>

  <div class="mt-8 text-right">
    <%= f.submit "💾 Lưu thay đổi",
          class: "px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-500" %>
  </div>
<% end %>

<% if student.errors.any? %>
  <div class="bg-red-100 text-red-700 p-4 rounded mb-4">
    <ul>
      <% student.errors.full_messages.each do |msg| %>
        <li>• <%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<style>
.label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
}

.input {
  width: 100%;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #ddd;
}
</style>
