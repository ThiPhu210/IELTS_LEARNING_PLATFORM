<%# app/views/admin/students/_form.html.erb %>

<style>
.sf-grid    { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.sf-field   { display: flex; flex-direction: column; gap: 5px; }
.sf-field.full { grid-column: 1 / -1; }
.sf-label {
  font-size: 11px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .07em; color: #7b7f96;
}
.sf-input, .sf-textarea {
  padding: 9px 13px; border-radius: 10px;
  border: 1.5px solid #e8eaf2; background: #f7f8fc;
  font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13.5px; color: #0d0e14;
  outline: none; transition: border-color .15s, box-shadow .15s; width: 100%;
}
.sf-input:focus, .sf-textarea:focus {
  border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.08);
  background: #fff;
}
.sf-textarea { resize: vertical; min-height: 88px; }

/* Avatar upload section */
.sf-avatar-wrap {
  display: flex; align-items: center; gap: 16px;
  padding: 14px; background: #f7f8fc; border: 1.5px solid #e8eaf2;
  border-radius: 12px;
}
.sf-avatar-preview {
  width: 56px; height: 56px; border-radius: 50%; flex-shrink: 0;
  background: #fee2e2; border: 2px solid #fca5a5;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Instrument Serif', serif; font-size: 22px; font-style: italic;
  color: #dc2626; overflow: hidden;
}
.sf-avatar-preview img { width: 100%; height: 100%; object-fit: cover; }
.sf-avatar-info { flex: 1; min-width: 0; }
.sf-avatar-name { font-size: 13px; font-weight: 800; color: #0d0e14; margin-bottom: 2px; }
.sf-avatar-sub  { font-size: 11px; color: #7b7f96; margin-bottom: 8px; }
.sf-file-label {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 8px;
  background: #fff; border: 1.5px solid #e8eaf2;
  font-size: 11.5px; font-weight: 700; color: #3a3d52; cursor: pointer;
  transition: border-color .15s, color .15s;
}
.sf-file-label:hover { border-color: #dc2626; color: #dc2626; }
.sf-file-input { display: none; }

/* Error box */
.sf-errors {
  background: #fef2f2; border: 1.5px solid #fca5a5;
  border-radius: 10px; padding: 12px 16px; margin-bottom: 16px;
}
.sf-errors li { font-size: 12.5px; color: #dc2626; font-weight: 600; margin-bottom: 2px; }

/* Submit */
.sf-submit {
  padding: 10px 24px; border-radius: 10px;
  background: #dc2626; color: #fff; border: none;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 13px; font-weight: 800; cursor: pointer;
  transition: background .15s, transform .1s;
  display: inline-flex; align-items: center; gap: 6px;
}
.sf-submit:hover { background: #b91c1c; transform: translateY(-1px); }
.sf-submit:active { transform: none; }

.sf-section-title {
  font-size: 10px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .10em; color: #7b7f96;
  padding-bottom: 8px; border-bottom: 1.5px solid #e8eaf2;
  margin-bottom: 14px; margin-top: 20px;
}
.sf-section-title:first-of-type { margin-top: 0; }
</style>

<% if student.errors.any? %>
  <div class="sf-errors">
    <ul>
      <% student.errors.full_messages.each do |msg| %>
        <li>• <%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: student,
              url: admin_student_path(student),
              method: :patch,
              local: true,
              html: { enctype: "multipart/form-data" } do |f| %>

  <!-- Avatar -->
  <div class="sf-section-title">Profile Photo</div>
  <div class="sf-avatar-wrap" style="margin-bottom:20px">
    <div class="sf-avatar-preview" id="avatar-preview">
      <% if student.thumbnail&.attached? %>
        <%= image_tag student.thumbnail.variant(resize_to_fill: [56, 56]), id: "avatar-img" %>
      <% else %>
        <span id="avatar-initial"><%= student.full_name&.first&.upcase || '?' %></span>
      <% end %>
    </div>
    <div class="sf-avatar-info">
      <div class="sf-avatar-name"><%= student.full_name %></div>
      <div class="sf-avatar-sub">JPG, PNG or GIF · max 2MB</div>
      <label class="sf-file-label" for="avatar-file-input">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
        </svg>
        Choose photo
      </label>
      <%= f.file_field :thumbnail, id: "avatar-file-input", class: "sf-file-input",
          accept: "image/*",
          onchange: "previewAvatar(this)" %>
    </div>
  </div>

  <!-- Basic info -->
  <div class="sf-section-title">Basic Information</div>
  <div class="sf-grid" style="margin-bottom:16px">
    <div class="sf-field">
      <%= f.label :full_name, "Full Name", class: "sf-label" %>
      <%= f.text_field :full_name, class: "sf-input", placeholder: "Enter full name" %>
    </div>
    <div class="sf-field">
      <%= f.label :email, "Email Address", class: "sf-label" %>
      <%= f.email_field :email, class: "sf-input", placeholder: "email@example.com" %>
    </div>
    <div class="sf-field">
      <%= f.label :phone, "Phone Number", class: "sf-label" %>
      <%= f.text_field :phone, class: "sf-input", placeholder: "+84 xxx xxx xxx" %>
    </div>
    <div class="sf-field">
      <%= f.label :school, "School / Institution", class: "sf-label" %>
      <%= f.text_field :school, class: "sf-input", placeholder: "University name" %>
    </div>
    <div class="sf-field full">
      <%= f.label :bio, "Bio", class: "sf-label" %>
      <%= f.text_area :bio, class: "sf-textarea", placeholder: "Short introduction about the student…" %>
    </div>
  </div>

  <!-- Location -->
  <div class="sf-section-title">Location</div>
  <div class="sf-grid" style="margin-bottom:20px">
    <div class="sf-field">
      <%= f.label :country, "Country", class: "sf-label" %>
      <%= f.text_field :country, class: "sf-input", placeholder: "Vietnam" %>
    </div>
    <div class="sf-field">
      <%= f.label :city, "City", class: "sf-label" %>
      <%= f.text_field :city, class: "sf-input", placeholder: "Ho Chi Minh City" %>
    </div>
    <div class="sf-field">
      <%= f.label :province, "Province", class: "sf-label" %>
      <%= f.text_field :province, class: "sf-input", placeholder: "Province" %>
    </div>
    <div class="sf-field">
      <%= f.label :postal_code, "Postal Code", class: "sf-label" %>
      <%= f.text_field :postal_code, class: "sf-input", placeholder: "700000" %>
    </div>
  </div>

  <div style="display:flex;justify-content:flex-end">
    <%= f.submit class: "sf-submit" do %>
      Save Changes
    <% end %>
    <%= f.submit "💾 Save Changes", class: "sf-submit" %>
  </div>

<% end %>

<script>
function previewAvatar(input) {
  if (!input.files || !input.files[0]) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var preview = document.getElementById('avatar-preview');
    var initial = document.getElementById('avatar-initial');
    var img     = document.getElementById('avatar-img');
    if (initial) initial.style.display = 'none';
    if (img) {
      img.src = e.target.result;
    } else {
      var newImg = document.createElement('img');
      newImg.id  = 'avatar-img';
      newImg.src = e.target.result;
      newImg.style.cssText = 'width:100%;height:100%;object-fit:cover;';
      preview.appendChild(newImg);
    }
  };
  reader.readAsDataURL(input.files[0]);
}
</script>
