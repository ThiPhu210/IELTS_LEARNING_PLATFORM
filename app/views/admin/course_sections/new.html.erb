<h2 class="text-2xl font-semibold mb-6">
  Sections – <%= @course.title %>
</h2>

<%= link_to "+ Add Section",
  new_admin_course_course_section_path(@course),
  class: "mb-4 inline-block px-4 py-2 bg-emerald-500 text-white rounded-md" %>

<% @sections.each do |section| %>
  <div class="bg-white p-4 rounded shadow mb-4">
    <%= section.title.to_plain_text %>

    <%= link_to "Lessons",
      admin_course_section_lessons_path(section),
      class: "ml-4 text-lightBlue-600 underline" %>
  </div>
<% end %>
