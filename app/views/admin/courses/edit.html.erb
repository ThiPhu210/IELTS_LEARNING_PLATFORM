<!-- NAVBAR -->
<%= render "admin/shared/navbar" %>
<div id="alert-container"
     class="fixed top-20 right-6 z-50 w-full max-w-md space-y-3">
</div>
<div class="pt-24 px-8 pb-16 bg-slate-100 min-h-screen">
<div class="max-w-6xl mx-auto">
<h1 class="text-3xl font-bold text-slate-800 mb-10">
🎓 Admin Course Editor
</h1>

<%= form_with model: [:admin,@course], local:true, multipart:true do |f| %>

<!-- COURSE INFO -->
<div class="bg-white rounded-2xl shadow-lg p-8 mb-10 space-y-6">

<h2 class="text-xl font-semibold border-b pb-3">📘 Course Information</h2>

<%= f.text_field :title,class:"w-full border rounded-lg px-4 py-2",placeholder:"Course Title"%>

<%= f.text_area :description,rows:4,class:"w-full border rounded-lg px-4 py-2",placeholder:"Description"%>

<div class="grid grid-cols-2 gap-6">

<%= f.number_field :price,min:0,step:1000,class:"w-full border rounded-lg px-4 py-2"%>

<div>
<% if @course.thumbnail.attached? && @course.thumbnail.persisted? %>

  <%= image_tag(
        @course.thumbnail.variant(resize_to_limit:[260,160]),
        class:"rounded-lg mb-3 border"
      ) %>

<% end %>

<%= f.file_field :thumbnail %>
</div>

</div>
</div>

<!-- COURSE STRUCTURE -->
<div class="bg-white rounded-2xl shadow-lg p-8">

<h2 class="text-xl font-semibold mb-8 border-b pb-3">
📚 Course Structure
</h2>

<button type="button"
onclick="addSection()"
class="mb-6 px-5 py-2 bg-indigo-600 text-white rounded-lg">
➕ Add Section
</button>

<div id="sections" class="space-y-8">

<%= f.fields_for :course_sections do |section| %>

<div class="bg-slate-50 border rounded-xl p-6 section-item">

<%= section.hidden_field :_destroy %>

<%= section.text_field :title,
placeholder:"Section Title",
class:"border rounded px-3 py-2 w-full mb-6"%>

<div class="lessons space-y-6">

<%= section.fields_for :lessons do |lesson| %>

<div class="lesson-item bg-white border rounded-xl p-6 shadow-sm">

<h4 class="font-semibold mb-4">🎬 Lesson</h4>

<div class="grid grid-cols-2 gap-4 mb-4">

<%= lesson.text_field :title,class:"border rounded px-3 py-2"%>

<%= lesson.number_field :duration,class:"border rounded px-3 py-2"%>

</div>

<label class="text-sm font-semibold">🎬 Video Upload</label>
<%= lesson.file_field :video,accept:"video/mp4",class:"mt-2",
onchange:"handleVideoUpload(this)" %>
<% if lesson.object.video.attached? %>
  <video controls class="mt-3 w-64 rounded">
    <source src="<%= url_for(lesson.object.video) %>" type="video/mp4">
  </video>
<% end %>


<label class="text-sm font-semibold mt-4 block">📄 PDF Materials</label>
<%= lesson.file_field :pdfs,multiple:true,accept:"application/pdf",class:"mt-2",onchange:"handlePDFUpload(this)"%>
<% if lesson.object.pdfs.attached? %>
  <ul class="mt-3 space-y-1 text-sm">
    <% lesson.object.pdfs.each do |pdf| %>
      <li>
        📄 <%= link_to pdf.filename,
            url_for(pdf),
            target:"_blank",
            class:"text-indigo-600 underline" %>
      </li>
    <% end %>
  </ul>
<% end %>

<!-- SPEAKING -->
<div class="bg-yellow-50 border rounded-xl p-5 mt-6">

<h5 class="font-bold text-yellow-700 mb-4">
🎤 Speaking Exercises
</h5>

<%= lesson.fields_for :speaking_topics do |topic| %>

<div class="topic-box bg-white border rounded-lg p-4 mb-4">

<div class="grid grid-cols-2 gap-3 mb-3">

<%= topic.text_field :title,class:"border px-3 py-2"%>

<%= topic.select :part,
SpeakingTopic.parts.keys.map{|p|[p.upcase,p]},
{},
class:"border px-3 py-2 part-select",
onchange:"toggleCueCard(this)"%>

</div>

<div class="questions">

<%= topic.fields_for :speaking_questions do |q| %>

<div class="question-item border rounded-lg p-4 mb-3 bg-slate-50">

<label class="text-xs font-semibold">Question</label>

<%= q.text_area :question_text,class:"border w-full px-3 py-2 mb-3"%>

<div class="cue-card-field hidden">

<label class="text-xs font-semibold">Cue Card</label>
<%= q.text_area :cue_card,class:"border w-full px-3 py-2 mb-3"%>
</div>

<div class="grid grid-cols-2 gap-3">

<%= q.number_field :preparation_time,class:"border px-3 py-2 w-full"%>

<%= q.number_field :speaking_time,class:"border px-3 py-2 w-full"%>

</div>

</div>

<% end %>

</div>
</div>

<% end %>

</div>

</div>

<% end %>

</div>

<button type="button"
onclick="removeSection(this)"
class="text-red-500 mt-4">
🗑 Remove Section
</button>

</div>

<% end %>

</div>
</div>

<!-- TEMPLATE -->
<template id="section-template">

<div class="bg-slate-50 border rounded-xl p-6 mt-8 section-item">

<h3 class="font-bold text-lg mb-4 text-indigo-700">
📂 Section
</h3>

<button type="button"
onclick="removeSection(this)"
class="text-sm text-red-500 mb-4">
🗑 Remove Section
</button>

<input type="text"
name="course[course_sections_attributes][NEW_SECTION][title]"
placeholder="Section Title"
class="border rounded px-3 py-2 w-full mb-6"/>

<div class="lesson-item bg-white border rounded-xl p-6 shadow-sm">

<h4 class="font-semibold mb-4">🎬 Lesson</h4>

<div class="grid grid-cols-2 gap-4 mb-4">

<input type="text"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][title]"
placeholder="Lesson Title"
class="border rounded px-3 py-2"/>

<input type="number"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][duration]"
placeholder="Duration"
class="border rounded px-3 py-2"/>

</div>

<label class="text-sm font-semibold">
🎬 Admin Video Upload
</label>

<input type="file"
accept="video/mp4"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][video]"
class="video-input mt-2"
onchange="handleVideoUpload(this)"
/>

<label class="text-sm font-semibold mt-4 block">
📄 Admin PDF Materials
</label>

<input type="file"
multiple
accept="application/pdf"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][pdfs][]"
class="pdf-input mt-2"
onchange="handlePDFUpload(this)"
/>

<!-- SPEAKING -->
<div class="bg-yellow-50 border rounded-xl p-5 mt-6">

<h5 class="font-bold text-yellow-700 mb-4">
🎤 Speaking Exercises (Admin)
</h5>

<div class="topic-box bg-white border rounded-lg p-4 mb-4">

<div class="grid grid-cols-2 gap-3 mb-3">

<input type="text"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][speaking_topics_attributes][0][title]"
placeholder="Topic Title"
class="border px-3 py-2"/>

<select
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][speaking_topics_attributes][0][part]"
class="border px-3 py-2 part-select"
onchange="toggleCueCard(this)">


<option value="part1">PART1</option>
<option value="part2">PART2</option>
<option value="part3">PART3</option>

</select>

</div>

<div class="question-item border rounded-lg p-4 mb-3 bg-slate-50">

<label class="text-xs font-semibold">Question</label>

<textarea
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][speaking_topics_attributes][0][speaking_questions_attributes][0][question_text]"
class="border w-full px-3 py-2 mb-3"></textarea>

<label class="text-xs font-semibold">Cue Card</label>

<textarea
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][speaking_topics_attributes][0][speaking_questions_attributes][0][cue_card]"
class="border w-full px-3 py-2 mb-3"></textarea>

<div class="grid grid-cols-2 gap-3">

<input type="number"
placeholder="Preparation Time"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][speaking_topics_attributes][0][speaking_questions_attributes][0][preparation_time]"
class="border px-3 py-2"/>

<input type="number"
placeholder="Speaking Time"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][speaking_topics_attributes][0][speaking_questions_attributes][0][speaking_time]"
class="border px-3 py-2"/>

</div>

</div>

</div>

</div>

</div>

</template>


<div class="flex justify-end gap-4 mt-10">

<%= link_to "Cancel",admin_courses_path,class:"px-6 py-2 border rounded-lg bg-white"%>

<%= f.submit "💾 Save Course",
class:"px-8 py-3 bg-indigo-600 text-white rounded-xl shadow hover:bg-indigo-700"%>

</div>

<% end %>

</div>
</div>

<script>

function addSection(){
let template=document.getElementById("section-template").innerHTML
let uniq=Date.now()
template=template.replace(/NEW_SECTION/g,uniq)
document.getElementById("sections").insertAdjacentHTML("beforeend",template)
}

function removeSection(btn){
let section=btn.closest(".section-item")
let destroyInput=section.querySelector("input[name*='_destroy']")
if(destroyInput){
destroyInput.value="1"
section.style.display="none"
}else{
section.remove()
}
}

function toggleCueCard(select){

  const box = select.closest(".topic-box")
  const cue = box.querySelector(".cue-card-field")

  if(select.value==="part2"){
    cue.classList.remove("hidden")
  }else{
    cue.classList.add("hidden")
  }
}


function handleVideoUpload(input){

const file = input.files[0]
if(!file) return

if(file.size > 5*1024*1024){
alert("Video must be under 5MB")
input.value=""
return
}

if(file.type !== "video/mp4"){
alert("Only MP4 allowed")
input.value=""
return
}

let preview = document.createElement("video")
preview.controls = true
preview.className = "mt-3 rounded border w-full"
preview.src = URL.createObjectURL(file)

input.parentNode.appendChild(preview)

}

</script>

<script>

const MAX_VIDEO = 5 * 1024 * 1024
const MAX_PDF   = 500 * 1024
function showAlert(type, message){

  const container = document.getElementById("alert-container")
  if(!container) return

  const div = document.createElement("div")

  if(type==="danger"){
    div.className="flex items-start sm:items-center p-4 text-sm text-pink-800 rounded-xl bg-pink-100 border border-pink-200 shadow"
    div.innerHTML=`
      <svg class="w-4 h-4 me-2 shrink-0"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor">
      <path stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
      <p><span class="font-semibold me-1">Error:</span>${message}</p>
    `
  }

  if(type==="success"){
    div.className="flex items-start sm:items-center p-4 text-sm text-emerald-800 rounded-xl bg-emerald-100 border border-emerald-200 shadow"
    div.innerHTML=`
      <svg class="w-4 h-4 me-2 shrink-0"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor">
      <path stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M5 13l4 4L19 7"/>
      </svg>
      <p><span class="font-semibold me-1">Success:</span>${message}</p>
    `
  }

  container.appendChild(div)

  setTimeout(()=>{
    div.remove()
  },4000)
}


function handleVideoUpload(input){
const file=input.files[0]
if(!file)return

if(!file.type.includes("mp4")){
showAlert("danger","❌ Video phải là MP4")
input.value=""
return
}

if(file.size>MAX_VIDEO){
showAlert("danger","❌ Video vượt quá 5MB")
input.value=""
return
}

showAlert("success",`🎬 Upload video: <b>${file.name}</b>`)
}

function handlePDFUpload(input){

const files=Array.from(input.files)
if(files.length===0)return

for(const file of files){

if(file.type!=="application/pdf"){
showAlert("danger",`❌ ${file.name} không phải PDF`)
input.value=""
return
}

if(file.size>MAX_PDF){
showAlert("danger",`❌ ${file.name} vượt quá 500KB`)
input.value=""
return
}

}

showAlert("success",`📄 Upload ${files.length} file PDF`)
}
</script>
<script>
document.addEventListener("DOMContentLoaded",()=>{

  document.querySelectorAll(".part-select").forEach(select=>{
    toggleCueCard(select)
  })

})

</script>

