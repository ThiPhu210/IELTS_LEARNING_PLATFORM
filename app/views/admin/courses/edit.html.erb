<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Course Editor</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
<style>
:root {
  --bg: #ffffff;
  --surface: #ffffff;
  --surface2: #f5f6f8;
  --surface3: #eceef2;
  --border: rgba(0,0,0,0.13);
  --border-hover: rgba(0,0,0,0.24);
  --text: #1a1a2e;
  --text-muted: #5a5a7a;
  --text-dim: #9a9ab0;
  --accent: #5b4fe0;
  --accent2: #7c6af7;
  --accent-glow: rgba(91,79,224,0.12);
  --green: #059669;
  --green-dim: rgba(5,150,105,0.1);
  --red: #dc2626;
  --red-dim: rgba(220,38,38,0.08);
  --radius: 12px;
  --radius-sm: 8px;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  line-height: 1.5;
}
#alert-container {
  position: fixed; top: 20px; right: 20px; z-index: 9999;
  display: flex; flex-direction: column; gap: 8px; max-width: 360px;
}
.alert {
  display: flex; align-items: center; gap: 8px;
  padding: 12px 16px; border-radius: 10px; font-size: 13px; font-weight: 500;
  border: 1px solid; box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  animation: slideIn 0.25s ease; transition: opacity 0.3s, transform 0.3s;
}
.alert-danger  { background:#fef2f2; border-color:#fecaca; color:#991b1b; }
.alert-success { background:#f0fdf4; border-color:#bbf7d0; color:#166534; }
@keyframes slideIn { from{opacity:0;transform:translateX(12px)} to{opacity:1;transform:translateX(0)} }
.page { max-width: 900px; margin: 0 auto; padding: 36px 24px 60px; }
.breadcrumb { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-dim); margin-bottom:10px; }
.breadcrumb a { color:var(--text-muted); text-decoration:none; }
.breadcrumb a:hover { color:var(--text); }
.page-title { font-size:26px; font-weight:700; color:var(--text); margin-bottom:4px; letter-spacing:-0.4px; }
.page-subtitle { font-size:13px; color:var(--text-muted); margin-bottom:28px; }
.card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); margin-bottom:20px; overflow:hidden; }
.card-header { display:flex; align-items:center; gap:10px; padding:16px 20px; border-bottom:1px solid var(--border); background:var(--surface2); }
.card-title { font-size:13px; font-weight:600; color:var(--text); }
.card-body { padding:20px; }
.field { margin-bottom:16px; }
.field label { display:block; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted); margin-bottom:6px; }
.input,.textarea,.select { width:100%; background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius-sm); padding:9px 12px; font-family:inherit; font-size:14px; color:var(--text); outline:none; transition:border-color 0.15s, box-shadow 0.15s; }
.input:focus,.textarea:focus,.select:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-glow); background:#fff; }
.input::placeholder,.textarea::placeholder { color:var(--text-dim); }
.textarea { resize:vertical; min-height:80px; }
.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.upload-zone { position:relative; border:1.5px dashed var(--border); border-radius:var(--radius-sm); padding:16px; cursor:pointer; transition:border-color 0.15s,background 0.15s; background:var(--surface2); display:flex; align-items:center; gap:12px; }
.upload-zone:hover { border-color:var(--accent); background:var(--accent-glow); }
.upload-zone input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; }
.upload-zone-icon { font-size:20px; flex-shrink:0; }
.upload-zone-text { font-size:13px; font-weight:500; color:var(--text-muted); }
.upload-zone-hint { font-size:11px; color:var(--text-dim); margin-top:2px; }
#sections { display:flex; flex-direction:column; gap:14px; }
.section-item { border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; background:var(--surface); transition:box-shadow 0.2s; }
.section-item.sortable-ghost { opacity:0.35; border:1.5px dashed var(--accent2); }
.section-item.sortable-chosen { box-shadow:0 8px 30px rgba(0,0,0,0.12); }
.section-header { display:flex; align-items:center; gap:10px; padding:12px 16px; background:var(--surface2); border-bottom:1px solid var(--border); }
.drag-handle { display:flex; flex-direction:column; gap:3px; cursor:grab; padding:4px 2px; opacity:0.35; transition:opacity 0.15s; flex-shrink:0; }
.drag-handle:hover { opacity:0.8; }
.drag-handle:active { cursor:grabbing; }
.drag-handle span { display:block; width:14px; height:2px; background:var(--text-muted); border-radius:2px; }
.section-badge { width:24px; height:24px; border-radius:6px; background:rgba(91,79,224,0.1); border:1px solid rgba(91,79,224,0.18); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; color:var(--accent); flex-shrink:0; }
.section-title-inline { flex:1; background:transparent; border:none; border-bottom:1.5px solid transparent; outline:none; font-family:inherit; font-size:14px; font-weight:600; color:var(--text); padding:2px 0; transition:border-color 0.15s; }
.section-title-inline:focus { border-bottom-color:var(--accent); }
.section-title-inline::placeholder { color:var(--text-dim); font-weight:400; }
.section-actions { display:flex; align-items:center; gap:4px; margin-left:auto; }
.btn-icon { width:28px; height:28px; border-radius:6px; display:flex; align-items:center; justify-content:center; cursor:pointer; border:none; font-size:13px; background:transparent; color:var(--text-muted); transition:background 0.15s,color 0.15s; }
.btn-icon:hover { background:var(--surface3); color:var(--text); }
.btn-icon.danger:hover { background:var(--red-dim); color:var(--red); }
.section-toggle { font-size:10px; color:var(--text-dim); transition:transform 0.2s; }
.section-item.collapsed .section-toggle { transform:rotate(-90deg); }
.section-item.collapsed .section-body { display:none; }
.section-body { padding:16px; }
.lessons-list { display:flex; flex-direction:column; gap:10px; margin-bottom:10px; }
.lesson-item { background:var(--surface2); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
.lesson-item.sortable-ghost { opacity:0.3; border:1.5px dashed rgba(5,150,105,0.4); }
.lesson-item.sortable-chosen { box-shadow:0 4px 16px rgba(0,0,0,0.1); }
.lesson-header { display:flex; align-items:center; gap:8px; padding:10px 14px; border-bottom:1px solid var(--border); background:#fff; }
.lesson-drag { cursor:grab; opacity:0.3; transition:opacity 0.15s; display:flex; flex-direction:column; gap:2px; flex-shrink:0; }
.lesson-drag:hover { opacity:0.7; }
.lesson-drag:active { cursor:grabbing; }
.lesson-drag span { width:12px; height:2px; background:var(--text-muted); border-radius:2px; display:block; }
.lesson-type-badge { font-size:10px; padding:2px 8px; border-radius:4px; font-weight:600; text-transform:uppercase; letter-spacing:0.4px; transition:all 0.2s; flex-shrink:0; }
.badge-video    { background:var(--green-dim); color:var(--green); border:1px solid rgba(5,150,105,0.2); }
.badge-pdf      { background:var(--red-dim); color:var(--red); border:1px solid rgba(220,38,38,0.2); }
.badge-speaking { background:rgba(91,79,224,0.09); color:var(--accent); border:1px solid rgba(91,79,224,0.2); }
.lesson-name-inline { flex:1; background:transparent; border:none; border-bottom:1.5px solid transparent; outline:none; font-family:inherit; font-size:13px; font-weight:500; color:var(--text); padding:1px 0; transition:border-color 0.15s; }
.lesson-name-inline:focus { border-bottom-color:var(--green); }
.lesson-name-inline::placeholder { color:var(--text-dim); font-weight:400; }
.lesson-body { padding:14px; }
.tabs { display:flex; gap:2px; background:var(--surface3); padding:3px; border-radius:8px; margin-bottom:14px; width:fit-content; }
.tab { padding:5px 12px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; color:var(--text-dim); transition:all 0.15s; border:none; background:transparent; font-family:inherit; }
.tab:hover { color:var(--text-muted); }
.tab.active { background:#fff; color:var(--text); box-shadow:0 1px 4px rgba(0,0,0,0.1); }
.tab-panel { display:none; }
.tab-panel.active { display:block; }
.video-preview { width:100%; max-width:300px; border-radius:var(--radius-sm); border:1px solid var(--border); margin-top:10px; }
.pdf-list { margin-top:10px; display:flex; flex-direction:column; gap:6px; }
.pdf-item { display:flex; align-items:center; gap:8px; padding:7px 12px; background:#fff; border-radius:7px; border:1px solid var(--border); font-size:12px; color:var(--text-muted); }
.speaking-section { background:#fffbeb; border:1px solid rgba(251,191,36,0.25); border-radius:var(--radius-sm); padding:14px; }
.speaking-label { font-size:11px; font-weight:700; color:#92400e; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:12px; display:flex; align-items:center; gap:5px; }
.topic-box { background:#fff; border:1px solid rgba(251,191,36,0.2); border-radius:8px; padding:12px; margin-bottom:8px; }
.question-item { background:var(--surface2); border:1px solid var(--border); border-radius:7px; padding:12px; margin-top:8px; }
.question-item label { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-dim); margin-bottom:5px; display:block; }
.cue-card-field { margin-top:8px; }
.hidden { display:none !important; }
.btn { display:inline-flex; align-items:center; gap:6px; padding:8px 16px; border-radius:var(--radius-sm); font-family:inherit; font-size:13px; font-weight:600; cursor:pointer; border:none; transition:all 0.15s; text-decoration:none; }
.btn-outline { background:transparent; color:var(--text-muted); border:1px solid var(--border); }
.btn-outline:hover { background:var(--surface2); color:var(--text); border-color:var(--border-hover); }
.btn-add { width:100%; justify-content:center; background:transparent; color:var(--text-dim); border:1.5px dashed var(--border); font-size:12px; padding:7px; border-radius:var(--radius-sm); }
.btn-add:hover { border-color:var(--accent); color:var(--accent); background:var(--accent-glow); }
.btn-save { background:var(--accent); color:#fff; padding:10px 28px; font-size:14px; border-radius:var(--radius-sm); box-shadow:0 2px 10px rgba(91,79,224,0.3); }
.btn-save:hover { background:#4a3fcf; transform:translateY(-1px); }
.add-section-zone { width:100%; border:1.5px dashed var(--border); border-radius:var(--radius); padding:20px; text-align:center; cursor:pointer; transition:all 0.15s; background:transparent; color:var(--text-dim); font-size:13px; font-weight:500; font-family:inherit; display:flex; align-items:center; justify-content:center; gap:6px; margin-top:14px; }
.add-section-zone:hover { border-color:var(--accent); color:var(--accent); background:var(--accent-glow); }
.order-hint { font-size:11px; color:var(--text-dim); margin-bottom:12px; }
.form-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:24px; }
::-webkit-scrollbar { width:5px; }
::-webkit-scrollbar-track { background:#f1f1f1; }
::-webkit-scrollbar-thumb { background:#ccc; border-radius:3px; }
</style>
</head>
<body>

<%= render "admin/shared/navbar" %> 
<%= form_with model: [:admin,@course], local:true, multipart:true do |f| %>
<div id="alert-container"></div>
<div class="page">
  <div class="breadcrumb">
    <a href="#">Admin</a> › <a href="#">Courses</a> › Edit
  </div>
  <div class="page-title">🎓 Course Editor</div>
  <div class="page-subtitle">Manage course content, lessons, and speaking exercises</div>

  <!-- COURSE INFO -->
  <div class="card">
    <div class="card-header">
      <span>📘</span>
      <span class="card-title">Course Information</span>
    </div>
    <div class="card-body">
      <div class="field">
        <label>Course Title</label>
        <input type="text" class="input" name="course[title]" placeholder="e.g. IELTS Complete Preparation">
      </div>
      <div class="field">
        <label>Description</label>
        <textarea class="textarea" name="course[description]" placeholder="Describe what students will learn..."></textarea>
      </div>
      <div class="grid-2">
        <div class="field">
          <label>Price (VND)</label>
          <input type="number" class="input" name="course[price]" placeholder="0" min="0" step="1000">
        </div>
        <div class="field">
          <label>Thumbnail</label>
          <div class="upload-zone" id="thumbnail-zone">
            <input type="file" accept="image/*" onchange="previewThumbnail(this)">
            <span class="upload-zone-icon">🖼️</span>
            <div>
              <div class="upload-zone-text">Drop image or click to browse</div>
              <div class="upload-zone-hint">JPG, PNG · Max 2MB</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- COURSE STRUCTURE -->
  <div class="card">
    <div class="card-header">
      <span>📚</span>
      <span class="card-title">Course Structure</span>
    </div>
    <div class="card-body">
      <div class="order-hint">⠿ Drag to reorder sections and lessons</div>
      <div id="sections"></div>
      <button type="button" class="add-section-zone" onclick="addSection()">＋ Add Section</button>
    </div>
  </div>

  <!-- ACTIONS -->
<div class="form-actions">
  <%= link_to "Cancel",
      admin_courses_path,
      class: "btn btn-outline" %>

  <%= submit_tag "💾 Save Course",
      class: "btn btn-save" %>
</div>
</div>

<template id="section-tpl">
  <div class="section-item" data-section-id="__SID__">
    <div class="section-header">
      <div class="drag-handle section-drag"><span></span><span></span><span></span></div>
      <div class="section-badge">1</div>
      <input type="hidden" name="course[course_sections_attributes][__SID__][_destroy]" value="0">
      <input type="text" class="section-title-inline" name="course[course_sections_attributes][__SID__][title]" placeholder="Section title…">
      <div class="section-actions">
        <button type="button" class="btn-icon" onclick="toggleSection(this)"><span class="section-toggle">▾</span></button>
        <button type="button" class="btn-icon danger" onclick="removeSection(this)">🗑</button>
      </div>
    </div>
    <div class="section-body">
      <div class="lessons-list"></div>
      <button type="button" class="btn btn-add" onclick="addLesson(this)">＋ Add Lesson</button>
    </div>
  </div>
</template>

<template id="lesson-tpl">
  <div class="lesson-item" data-lesson-id="__LID__">
    <div class="lesson-header">
      <div class="lesson-drag"><span></span><span></span></div>
      <span class="lesson-type-badge badge-video">Video</span>
      <input type="hidden" name="__LPREFIX__[_destroy]" value="0">
      <input type="text" class="lesson-name-inline" name="__LPREFIX__[title]" placeholder="Lesson title…">
      <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
        <input type="number" class="input" style="width:72px;padding:5px 8px;font-size:12px;" name="__LPREFIX__[duration]" placeholder="min">
        <span style="font-size:11px;color:var(--text-dim);">min</span>
        <button type="button" class="btn-icon danger" onclick="removeLesson(this)">🗑</button>
      </div>
    </div>
    <div class="lesson-body">
      <div class="tabs">
        <button class="tab active" onclick="switchTab(this,'video')">🎬 Video</button>
        <button class="tab" onclick="switchTab(this,'pdf')">📄 PDF</button>
        <button class="tab" onclick="switchTab(this,'speaking')">🎤 Speaking</button>
      </div>
      <div class="tab-panel active" data-tab="video">
        <div class="upload-zone">
          <input type="file" accept="video/mp4" name="__LPREFIX__[video]" onchange="handleVideoUpload(this)">
          <span class="upload-zone-icon">🎬</span>
          <div>
            <div class="upload-zone-text">Upload video lesson</div>
            <div class="upload-zone-hint">MP4 · Max 5MB</div>
          </div>
        </div>
        <div class="video-preview-wrap"></div>
      </div>
      <div class="tab-panel" data-tab="pdf">
        <div class="upload-zone">
          <input type="file" multiple accept="application/pdf" name="__LPREFIX__[pdfs][]" onchange="handlePDFUpload(this)">
          <span class="upload-zone-icon">📄</span>
          <div>
            <div class="upload-zone-text">Upload PDF materials</div>
            <div class="upload-zone-hint">PDF · Max 500KB each · Multiple OK</div>
          </div>
        </div>
        <div class="pdf-list"></div>
      </div>
      <div class="tab-panel" data-tab="speaking">
        <div class="speaking-section">
          <div class="speaking-label">🎤 Speaking Exercises</div>
          <div class="topics-container"></div>
          <button type="button" class="btn btn-add" style="margin-top:8px;" onclick="addTopic(this)">＋ Add Topic</button>
        </div>
      </div>
    </div>
  </div>
</template>

<template id="topic-tpl">
  <div class="topic-box">
    <div class="grid-2" style="margin-bottom:10px;">
      <input type="text" class="input" name="__TPREFIX__[title]" placeholder="Topic title…">
      <select class="select part-select" name="__TPREFIX__[part]" onchange="toggleCueCard(this)">
        <option value="part1">PART 1</option>
        <option value="part2">PART 2</option>
        <option value="part3">PART 3</option>
      </select>
    </div>
    <div class="questions-container"></div>
    <button type="button" class="btn btn-add" style="margin-top:6px;font-size:11px;" onclick="addQuestion(this)">＋ Add Question</button>
  </div>
</template>

<template id="question-tpl">
  <div class="question-item">
    <label>Question</label>
    <textarea class="textarea" style="font-size:13px;min-height:56px;" name="__QPREFIX__[question_text]" placeholder="Enter your question…"></textarea>
    <div class="cue-card-field hidden" style="margin-top:8px;">
      <label>Cue Card</label>
      <textarea class="textarea" style="font-size:13px;min-height:56px;" name="__QPREFIX__[cue_card]" placeholder="Cue card instructions…"></textarea>
    </div>
    <div class="grid-2" style="margin-top:10px;">
      <div>
        <label>Prep Time (sec)</label>
        <input type="number" class="input" name="__QPREFIX__[preparation_time]" placeholder="30">
      </div>
      <div>
        <label>Speaking Time (sec)</label>
        <input type="number" class="input" name="__QPREFIX__[speaking_time]" placeholder="120">
      </div>
    </div>
  </div>
</template>

<script>
const MAX_VIDEO = 5 * 1024 * 1024
const MAX_PDF   = 500 * 1024
let lessonCounters = {}

const sectionsEl = document.getElementById('sections')
Sortable.create(sectionsEl, {
  animation: 160, handle: '.section-drag',
  ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
  easing: 'cubic-bezier(0.25,1,0.5,1)', onEnd: updateSectionBadges
})

function updateSectionBadges() {
  let count = 0
  document.querySelectorAll('.section-item').forEach(el => {
    const d = el.querySelector("input[name*='_destroy']")
    if (el.style.display !== 'none' && !(d && d.value === '1')) {
      count++
      const badge = el.querySelector('.section-badge')
      if (badge) badge.textContent = count
    }
  })
}

function addSection() {
  const sid = 'S' + Date.now()
  const wrap = document.createElement('div')
  wrap.innerHTML = document.getElementById('section-tpl').innerHTML.replace(/__SID__/g, sid)
  const el = wrap.firstElementChild
  el.dataset.sectionId = sid
  sectionsEl.appendChild(el)
  updateSectionBadges()
  Sortable.create(el.querySelector('.lessons-list'), {
    animation: 140, handle: '.lesson-drag',
    ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
    easing: 'cubic-bezier(0.25,1,0.5,1)'
  })
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  el.querySelector('.section-title-inline').focus()
}

function addLesson(btn) {
  const section = btn.closest('.section-item')
  const sid = section.dataset.sectionId
  if (!lessonCounters[sid]) lessonCounters[sid] = 0
  const idx = lessonCounters[sid]++
  const prefix = `course[course_sections_attributes][${sid}][lessons_attributes][${idx}]`
  const lid = Date.now()
  const wrap = document.createElement('div')
  wrap.innerHTML = document.getElementById('lesson-tpl').innerHTML
    .replace(/__LID__/g, lid).replace(/__LPREFIX__/g, prefix)
  const el = wrap.firstElementChild
  el.dataset.lessonId = lid
  section.querySelector('.lessons-list').appendChild(el)
  el.querySelector('.lesson-name-inline').focus()
}

function removeSection(btn) {
  const section = btn.closest('.section-item')
  const destroy = section.querySelector("input[name*='_destroy']")
  section.style.transition = 'opacity 0.2s, transform 0.2s'
  section.style.opacity = '0'
  section.style.transform = 'scale(0.98)'
  setTimeout(() => {
    if (destroy) { destroy.value = '1'; section.style.display = 'none' }
    else section.remove()
    updateSectionBadges()
  }, 200)
}

function removeLesson(btn) {
  const lesson = btn.closest('.lesson-item')
  const destroy = lesson.querySelector("input[name*='_destroy']")
  lesson.style.transition = 'opacity 0.2s'
  lesson.style.opacity = '0'
  setTimeout(() => {
    if (destroy) { destroy.value = '1'; lesson.style.display = 'none' }
    else lesson.remove()
  }, 200)
}

function toggleSection(btn) {
  btn.closest('.section-item').classList.toggle('collapsed')
}

function switchTab(btn, tab) {
  const lesson = btn.closest('.lesson-item')
  lesson.querySelectorAll('.tab').forEach(t => t.classList.remove('active'))
  lesson.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'))
  btn.classList.add('active')
  lesson.querySelector('[data-tab="' + tab + '"]').classList.add('active')
  const badge = lesson.querySelector('.lesson-type-badge')
  if (badge) {
    badge.className = 'lesson-type-badge badge-' + tab
    badge.textContent = {video:'Video', pdf:'PDF', speaking:'Speaking'}[tab]
  }
}

function addTopic(btn) {
  const lesson = btn.closest('.lesson-item')
  const container = btn.previousElementSibling
  const idx = container.children.length
  const base = lesson.querySelector("input[name*='_destroy']").name
    .replace('[_destroy]', '[speaking_topics_attributes][' + idx + ']')
  const wrap = document.createElement('div')
  wrap.innerHTML = document.getElementById('topic-tpl').innerHTML.replace(/__TPREFIX__/g, base)
  container.appendChild(wrap.firstElementChild)
}

function addQuestion(btn) {
  const topic = btn.closest('.topic-box')
  const container = topic.querySelector('.questions-container')
  const idx = container.children.length
  const base = topic.querySelector('select').name
    .replace('[part]', '[speaking_questions_attributes][' + idx + ']')
  const wrap = document.createElement('div')
  wrap.innerHTML = document.getElementById('question-tpl').innerHTML.replace(/__QPREFIX__/g, base)
  container.appendChild(wrap.firstElementChild)
}

function toggleCueCard(select) {
  const cue = select.closest('.topic-box').querySelector('.cue-card-field')
  select.value === 'part2' ? cue.classList.remove('hidden') : cue.classList.add('hidden')
}

function handleVideoUpload(input) {
  const file = input.files[0]
  if (!file) return
  if (!file.type.includes('mp4')) { showAlert('danger','Video must be MP4'); input.value=''; return }
  if (file.size > MAX_VIDEO) { showAlert('danger','Video exceeds 5MB limit'); input.value=''; return }
  const wrap = input.closest('.lesson-item').querySelector('.video-preview-wrap')
  wrap.innerHTML = '<video controls class="video-preview"><source src="' + URL.createObjectURL(file) + '" type="video/mp4"></video>'
  showAlert('success', 'Video ready: ' + file.name)
}

function handlePDFUpload(input) {
  const files = Array.from(input.files)
  if (!files.length) return
  for (const f of files) {
    if (f.type !== 'application/pdf') { showAlert('danger', f.name + ' is not PDF'); input.value=''; return }
    if (f.size > MAX_PDF) { showAlert('danger', f.name + ' exceeds 500KB'); input.value=''; return }
  }
  const list = input.closest('.lesson-item').querySelector('.pdf-list')
  list.innerHTML = ''
  files.forEach(f => {
    const item = document.createElement('div')
    item.className = 'pdf-item'
    item.innerHTML = '📄 ' + f.name + '<span style="margin-left:auto;font-size:10px;color:var(--text-dim)">' + (f.size/1024).toFixed(0) + ' KB</span>'
    list.appendChild(item)
  })
  showAlert('success', files.length + ' PDF file' + (files.length>1?'s':'') + ' selected')
}

function previewThumbnail(input) {
  const file = input.files[0]
  if (!file) return
  const zone = input.closest('.upload-zone')
  zone.innerHTML = '<img src="' + URL.createObjectURL(file) + '" style="width:100%;height:100px;object-fit:cover;border-radius:6px;">'
}

function saveCourse() { showAlert('success', 'Course saved successfully!') }

function showAlert(type, message) {
  const c = document.getElementById('alert-container')
  const div = document.createElement('div')
  div.className = 'alert alert-' + (type === 'danger' ? 'danger' : 'success')
  div.innerHTML = '<span>' + (type==='danger'?'⚠️':'✓') + '</span><span>' + message + '</span>'
  c.appendChild(div)
  setTimeout(() => { div.style.opacity='0'; div.style.transform='translateX(10px)'; setTimeout(()=>div.remove(),300) }, 3000)
}

document.addEventListener('DOMContentLoaded', () => {
  addSection()
  const firstBtn = document.querySelector('.section-item .btn-add')
  if (firstBtn) addLesson(firstBtn)
})
</script>
<% end %>
</body>
</html>
