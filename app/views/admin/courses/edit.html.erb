<!-- NAVBAR -->
<%= render "admin/shared/navbar" %>
<div id="alert-container" class="fixed top-20 right-6 z-50 w-full max-w-md space-y-3"></div>

<div class="pt-24 p-6 bg-gray-100 min-h-screen">
<div class="max-w-4xl mx-auto">

<h1 class="text-2xl font-bold mb-6">Edit Course</h1>

<%= form_with model: [:admin,@course], local:true, multipart:true do |f| %>

<!-- COURSE INFO -->
<div class="bg-white rounded-xl shadow p-6 mb-10 space-y-6">

<%= f.text_field :title,class:"w-full border px-4 py-2",placeholder:"Title" %>
<%= f.text_area :description,class:"w-full border px-4 py-2",rows:4 %>
<%= f.number_field :price,class:"w-full border px-4 py-2" %>
<%= f.file_field :thumbnail %>

</div>

<!-- COURSE CONTENT -->
<div class="bg-white rounded-xl shadow p-6 mb-10">

<div id="sections">

<%= f.fields_for :course_sections do |section| %>

<div class="border p-5 bg-gray-50">

<div class="lessons">

<%= section.fields_for :lessons do |lesson| %>

<div class="lesson-item bg-white p-4 rounded shadow-sm">

<%= lesson.hidden_field :_destroy %>

<%= lesson.text_field :title,class:"border px-3 py-2",placeholder:"Lesson title"%>
<%= lesson.number_field :duration,class:"border px-3 py-2"%>

<%= lesson.file_field :video %>
<%= lesson.file_field :pdfs,multiple:true %>

<!-- SPEAKING -->
<div class="mt-4 p-4 bg-yellow-50 rounded">

<h4 class="font-semibold mb-2">Speaking Exercises</h4>

<%= lesson.fields_for :speaking_topics do |topic| %>

<div class="border p-3 bg-white rounded mb-3">

<%= topic.hidden_field :_destroy %>

<%= topic.text_field :title,class:"border px-3 py-2",placeholder:"Topic"%>

<%= topic.select :part,["part1","part2","part3"],{},class:"border px-3 py-2"%>

<%= topic.fields_for :speaking_questions do |q| %>

<div class="border p-2 mb-2">

<%= q.hidden_field :_destroy %>

<%= q.text_area :question_text,class:"border w-full mb-2"%>
<%= q.text_area :cue_card,class:"border w-full mb-2"%>

<%= q.number_field :preparation_time,class:"border"%>
<%= q.number_field :speaking_time,class:"border"%>

</div>

<% end %>

</div>

<% end %>

</div>

<button type="button" class="remove-lesson text-red-500 mt-2">
Remove lesson
</button>

</div>

<% end %>

</div>

</div>

<% end %>

</div>

</div>

<div class="flex justify-end gap-3">
<%= f.submit "Save Course",class:"px-6 py-2 bg-green-600 text-white rounded"%>
</div>

<% end %>

</div>
</div>


<!-- JS -->
<script>
const MAX_VIDEO = 5 * 1024 * 1024   // 5MB
const MAX_PDF   = 500 * 1024        // 500KB
 

function showAlert(type, message) {
  const div = document.createElement("div")
  div.className = "p-3 rounded shadow bg-white border"
  div.innerHTML = message
  document.getElementById("alert-container").appendChild(div)
  setTimeout(() => div.remove(), 4000)
}

function handleVideoUpload(input) {
  const file = input.files[0]
  if (!file) return

  if (file.size > MAX_VIDEO) {
    showAlert("danger", "❌ Video không được vượt quá 5MB")
    input.value = ""
    return
  }

  showAlert("success", `🎬 Bạn vừa upload video: <b>${file.name}</b>`)

  const wrapper = input.closest(".lesson-item")
  wrapper.querySelector(".video-preview")?.remove()

  const video = document.createElement("video")
  video.src = URL.createObjectURL(file)
  video.controls = true
  video.className = "video-preview w-full mt-2 rounded border"
  wrapper.appendChild(video)
}

function handlePDFUpload(input) {
  const files = Array.from(input.files)
  if (files.length === 0) return

  let hasError = false
  let html = "❌ <b>File PDF vượt quá 5MB:</b><br>"

  files.forEach(file => {
    if (file.size > MAX_PDF) {
      hasError = true
      html += `📄 ${file.name}<br>`
    }
  })

  // ❌ CÓ FILE LỖI
  if (hasError) {
    showAlert("danger", html)
    input.value = "" // reset toàn bộ
    return
  }

  // ✅ HỢP LỆ
  showAlert("success", `📄 Đã upload <b>${files.length}</b> file PDF`)

  const wrapper = input.closest(".lesson-item")
  wrapper.querySelector(".pdf-preview")?.remove()

  const list = document.createElement("div")
  list.className = "pdf-preview mt-2 text-sm"

  files.forEach(file => {
    list.innerHTML += `📄 <b>${file.name}</b><br>`
  })

  wrapper.appendChild(list)
}

</script>
<script>
document.addEventListener("click", function (e) {

  // ADD LESSON
  if (e.target.classList.contains("add-lesson")) {
    const sectionBox = e.target.closest(".border")
    const lessonsBox = sectionBox.querySelector(".lessons")
    const template   = sectionBox.querySelector(".lesson-template")

    const sectionIndex = Array.from(
      document.querySelectorAll("#sections > div")
    ).indexOf(sectionBox)

    const lessonIndex = Date.now()

    let html = template.innerHTML
      .replace(/__SECTION__/g, sectionIndex)
      .replace(/__INDEX__/g, lessonIndex)

    lessonsBox.insertAdjacentHTML("beforeend", html)
  }

  // REMOVE LESSON
  if (e.target.classList.contains("remove-lesson")) {
    const lesson = e.target.closest(".lesson-item")
    const destroy = lesson.querySelector('input[name*="_destroy"]')

    if (destroy) {
      destroy.value = "1"
      lesson.style.display = "none"
    } else {
      lesson.remove()
    }
  }
})
document.addEventListener("change", function (e) {
  if (e.target.classList.contains("pdf-input")) {
    handlePDFUpload(e.target)
  }
})

</script>

<script>
document.addEventListener("click", function(e){

  if(e.target.classList.contains("add-question")){

    const topic =
      e.target.closest(".topic-box")

    const questionBox =
      topic.querySelector(".questions")

    const topicIndex =
      Array.from(document.querySelectorAll(".topic-box"))
      .indexOf(topic)

    const questionIndex = Date.now()

    const html = `
      <div class="question-item border p-3 rounded">
        <textarea
        name="course[course_sections_attributes][0]
        [lessons_attributes][0]
        [speaking_topics_attributes][${topicIndex}]
        [speaking_questions_attributes][${questionIndex}]
        [question_text]"
        class="border w-full mb-2 px-3 py-2"></textarea>
      </div>
    `

    questionBox.insertAdjacentHTML("beforeend", html)
  }

})

</script>
