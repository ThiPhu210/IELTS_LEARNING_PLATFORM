<!-- NAVBAR -->
<%= render "admin/shared/navbar" %>
<div id="alert-container" class="fixed top-20 right-6 z-50 w-full max-w-md space-y-3"></div>
<div class="pt-24 px-8 pb-16 bg-slate-100 min-h-screen">

<div class="max-w-6xl mx-auto">

<h1 class="text-3xl font-bold text-slate-800 mb-10">
🎓 Admin Course Editor
</h1>

<%= form_with model: [:admin,@course], local:true, multipart:true do |f| %>

<!-- ================= COURSE INFO ================= -->

<div class="bg-white rounded-2xl shadow-lg p-8 mb-10 space-y-6">

<h2 class="text-xl font-semibold border-b pb-3">
📘 Course Information
</h2>

<div>
<label class="block text-sm font-semibold mb-1">
Course Title
</label>
<%= f.text_field :title,
class:"w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-400" %>
</div>

<div>
<label class="block text-sm font-semibold mb-1">
Description
</label>
<%= f.text_area :description, rows:4,
class:"w-full border rounded-lg px-4 py-2" %>
</div>

<div class="grid grid-cols-2 gap-6">

<div>
<label class="block text-sm font-semibold mb-1">
Price (VND)
</label>
<%= f.number_field :price,
min:0,
step:1000,
class:"w-full border rounded-lg px-4 py-2" %>
</div>

<div>
<label class="block text-sm font-semibold mb-1">
Thumbnail Image
</label>

<% if @course.thumbnail.attached? %>
<%= image_tag @course.thumbnail.variant(resize_to_limit:[260,160]),
class:"rounded-lg mb-3 border" %>
<% end %>

<%= f.file_field :thumbnail %>

</div>

</div>
</div>

<!-- ================= COURSE CONTENT ================= -->

<div class="bg-white rounded-2xl shadow-lg p-8">

<h2 class="text-xl font-semibold mb-8 border-b pb-3">
📚 Course Structure
</h2>

<div id="sections" class="space-y-8">

<%= f.fields_for :course_sections do |section| %>

<div class="bg-slate-50 border rounded-xl p-6">

<h3 class="font-bold text-lg mb-4 text-indigo-700">
📂 Section
</h3>

<div class="space-y-6">

<%= section.fields_for :lessons do |lesson| %>

<div class="bg-white border rounded-xl p-6 shadow-sm">

<h4 class="font-semibold text-slate-700 mb-4">
🎬 Lesson
</h4>

<div class="grid grid-cols-2 gap-4 mb-4">
<%= lesson.text_field :title,
placeholder:"Lesson Title",
class:"border rounded px-3 py-2" %>

<%= lesson.number_field :duration,
placeholder:"Duration (minutes)",
class:"border rounded px-3 py-2" %>
</div>

<!-- VIDEO -->
<div class="mb-4">

<label class="text-sm font-semibold">
🎬 Admin Video Upload
</label>

<% if lesson.object.video.attached? %>
<p class="text-sm text-emerald-600 mb-2">
Uploaded: <%= lesson.object.video.filename %>
</p>
<% end %>

<%= lesson.file_field :video,
accept:"video/mp4",
class:"mt-2" %>

</div>

<!-- PDF -->
<div class="mb-6">

<label class="text-sm font-semibold">
📄 Admin PDF Materials
</label>

<% if lesson.object.pdfs.attached? %>
<ul class="text-sm mt-2 space-y-1">
<% lesson.object.pdfs.each do |pdf| %>
<li>
📄 <%= link_to pdf.filename,
rails_blob_url(pdf),
target:"_blank",
class:"text-indigo-600" %>
</li>
<% end %>
</ul>
<% end %>

<%= lesson.file_field :pdfs,
multiple:true,
accept:"application/pdf",
class:"mt-2" %>

</div>

<!-- SPEAKING -->
<div class="bg-yellow-50 border rounded-xl p-5">

<h5 class="font-bold text-yellow-700 mb-4">
🎤 Speaking Exercises (Admin)
</h5>

<%= lesson.fields_for :speaking_topics do |topic| %>

<div class="bg-white border rounded-lg p-4 mb-4">

<div class="grid grid-cols-2 gap-3 mb-3">

<%= topic.text_field :title,
placeholder:"Topic Title",
class:"border px-3 py-2" %>

<%= topic.select :part,
SpeakingTopic.parts.keys.map{|p|[p.upcase,p]},
{},
class:"border px-3 py-2" %>

</div>

<%= topic.fields_for :speaking_questions do |q| %>

<div class="border rounded-lg p-4 mb-3 bg-slate-50">

<label class="text-xs font-semibold">Question</label>
<%= q.text_area :question_text,
class:"border w-full px-3 py-2 mb-3" %>

<label class="text-xs font-semibold">Cue Card</label>
<%= q.text_area :cue_card,
class:"border w-full px-3 py-2 mb-3" %>

<div class="grid grid-cols-2 gap-3">

<div>
<label class="text-xs font-semibold">
Preparation Time (seconds)
</label>
<%= q.number_field :preparation_time,
class:"border px-3 py-2 w-full" %>
</div>

<div>
<label class="text-xs font-semibold">
Speaking Time (seconds)
</label>
<%= q.number_field :speaking_time,
class:"border px-3 py-2 w-full" %>
</div>

</div>

</div>

<% end %>

</div>

<% end %>

</div>

<% end %>

</div>

</div>

<% end %>

</div>

<div class="flex justify-end gap-4 mt-10">

<%= link_to "Cancel",
admin_courses_path,
class:"px-6 py-2 border rounded-lg bg-white" %>

<%= f.submit "💾 Save Course",
class:"px-8 py-3 bg-indigo-600 text-white rounded-xl shadow hover:bg-indigo-700" %>

</div>

<% end %>

</div>
</div>

</div>


<!-- JS -->
<script>
const MAX_VIDEO = 5 * 1024 * 1024   // 5MB
const MAX_PDF   = 500 * 1024        // 500KB
 

function showAlert(type, message) {
  const div = document.createElement("div")
  div.className = "p-3 rounded shadow bg-white border"
  div.innerHTML = message
  document.getElementById("alert-container").appendChild(div)
  setTimeout(() => div.remove(), 4000)
}

function handleVideoUpload(input) {
  const file = input.files[0]
  if (!file) return

  if (file.size > MAX_VIDEO) {
    showAlert("danger", "❌ Video không được vượt quá 5MB")
    input.value = ""
    return
  }

  showAlert("success", `🎬 Bạn vừa upload video: <b>${file.name}</b>`)

  const wrapper = input.closest(".lesson-item")
  wrapper.querySelector(".video-preview")?.remove()

  const video = document.createElement("video")
  video.src = URL.createObjectURL(file)
  video.controls = true
  video.className = "video-preview w-full mt-2 rounded border"
  wrapper.appendChild(video)
}

function handlePDFUpload(input) {
  const files = Array.from(input.files)
  if (files.length === 0) return

  let hasError = false
  let html = "❌ <b>File PDF vượt quá 5MB:</b><br>"

  files.forEach(file => {
    if (file.size > MAX_PDF) {
      hasError = true
      html += `📄 ${file.name}<br>`
    }
  })

  // ❌ CÓ FILE LỖI
  if (hasError) {
    showAlert("danger", html)
    input.value = "" // reset toàn bộ
    return
  }

  // ✅ HỢP LỆ
  showAlert("success", `📄 Đã upload <b>${files.length}</b> file PDF`)

  const wrapper = input.closest(".lesson-item")
  wrapper.querySelector(".pdf-preview")?.remove()

  const list = document.createElement("div")
  list.className = "pdf-preview mt-2 text-sm"

  files.forEach(file => {
    list.innerHTML += `📄 <b>${file.name}</b><br>`
  })

  wrapper.appendChild(list)
}

</script>
<script>
document.addEventListener("click", function (e) {

  // ADD LESSON
  if (e.target.classList.contains("add-lesson")) {
    const sectionBox = e.target.closest(".border")
    const lessonsBox = sectionBox.querySelector(".lessons")
    const template   = sectionBox.querySelector(".lesson-template")

    const sectionIndex = Array.from(
      document.querySelectorAll("#sections > div")
    ).indexOf(sectionBox)

    const lessonIndex = Date.now()

    let html = template.innerHTML
      .replace(/__SECTION__/g, sectionIndex)
      .replace(/__INDEX__/g, lessonIndex)

    lessonsBox.insertAdjacentHTML("beforeend", html)
  }

  // REMOVE LESSON
  if (e.target.classList.contains("remove-lesson")) {
    const lesson = e.target.closest(".lesson-item")
    const destroy = lesson.querySelector('input[name*="_destroy"]')

    if (destroy) {
      destroy.value = "1"
      lesson.style.display = "none"
    } else {
      lesson.remove()
    }
  }
})
document.addEventListener("change", function (e) {
  if (e.target.classList.contains("pdf-input")) {
    handlePDFUpload(e.target)
  }
})

</script>

<script>
document.addEventListener("click", function(e){

  if(e.target.classList.contains("add-question")){

    const topic =
      e.target.closest(".topic-box")

    const questionBox =
      topic.querySelector(".questions")

    const topicIndex =
      Array.from(document.querySelectorAll(".topic-box"))
      .indexOf(topic)

    const questionIndex = Date.now()

    const html = `
      <div class="question-item border p-3 rounded">
        <textarea
        name="course[course_sections_attributes][0]
        [lessons_attributes][0]
        [speaking_topics_attributes][${topicIndex}]
        [speaking_questions_attributes][${questionIndex}]
        [question_text]"
        class="border w-full mb-2 px-3 py-2"></textarea>
      </div>
    `

    questionBox.insertAdjacentHTML("beforeend", html)
  }

})

</script>
