<!-- NAVBAR -->
<%= render "admin/shared/navbar" %>

<div id="alert-container" class="fixed top-20 right-6 z-50 w-full max-w-md space-y-3"></div>

<div class="pt-24 px-8 pb-16 bg-slate-100 min-h-screen">
<div class="max-w-6xl mx-auto">

<h1 class="text-3xl font-bold text-slate-800 mb-10">
🎓 Admin Course Editor
</h1>

<%= form_with model: [:admin,@course], local:true, multipart:true do |f| %>

<!-- COURSE INFO -->
<div class="bg-white rounded-2xl shadow-lg p-8 mb-10 space-y-6">

<h2 class="text-xl font-semibold border-b pb-3">
📘 Course Information
</h2>

<%= f.text_field :title,
placeholder:"Course Title",
class:"w-full border rounded-lg px-4 py-2" %>

<%= f.text_area :description,
rows:4,
placeholder:"Description",
class:"w-full border rounded-lg px-4 py-2" %>

<div class="grid grid-cols-2 gap-6">

<%= f.number_field :price,
min:0,
step:1000,
placeholder:"Price VND",
class:"w-full border rounded-lg px-4 py-2" %>

<div>
<% if @course.persisted? && @course.thumbnail.attached? %>
  <%= image_tag @course.thumbnail.variant(resize_to_limit: [260,160]),
      class: "rounded-lg mb-3 border" %>
<% end %>
<%= f.file_field :thumbnail %>
</div>

</div>
</div>

<!-- COURSE CONTENT -->
<div class="bg-white rounded-2xl shadow-lg p-8">

<h2 class="text-xl font-semibold mb-8 border-b pb-3">
📚 Course Structure
</h2>
<button type="button"
        onclick="addSection()"
        class="mb-6 px-5 py-2 bg-indigo-600 text-white rounded-lg">
➕ Add Section
</button>

<div id="sections" class="space-y-8">

<%= f.fields_for :course_sections do |section| %>

<div class="bg-slate-50 border rounded-xl p-6">

<h3 class="font-bold text-lg mb-4 text-indigo-700">
📂 Section
</h3>

<div class="space-y-6 lessons">

<%= section.fields_for :lessons do |lesson| %>

<div class="lesson-item bg-white border rounded-xl p-6 shadow-sm">

<h4 class="font-semibold mb-4">🎬 Lesson</h4>

<div class="grid grid-cols-2 gap-4 mb-4">

<%= lesson.text_field :title,
placeholder:"Lesson Title",
class:"border rounded px-3 py-2" %>

<%= lesson.number_field :duration,
placeholder:"Duration (minutes)",
class:"border rounded px-3 py-2" %>

</div>

<!-- VIDEO -->
<label class="text-sm font-semibold">
🎬 Admin Video Upload (MP4 - max 5MB)
</label>

<%= lesson.file_field :video,
accept:"video/mp4",
class:"video-input mt-2",
onchange:"handleVideoUpload(this)" %>

<% if lesson.object.video.attached? %>
<p class="text-sm text-emerald-600 mt-1">
Uploaded: <%= lesson.object.video.filename %>
</p>
<% end %>

<!-- PDF -->
<label class="text-sm font-semibold mt-4 block">
📄 Admin PDF Materials (max 5MB)
</label>

<%= lesson.file_field :pdfs,
multiple:true,
accept:"application/pdf",
class:"pdf-input mt-2",
onchange:"handlePDFUpload(this)" %>

<% if lesson.object.pdfs.attached? %>
<ul class="text-sm mt-2 space-y-1">
<% lesson.object.pdfs.each do |pdf| %>
<li>
📄 <%= link_to pdf.filename,
rails_blob_url(pdf),
target:"_blank",
class:"text-indigo-600" %>
</li>
<% end %>
</ul>
<% end %>

<!-- SPEAKING -->
<div class="bg-yellow-50 border rounded-xl p-5 mt-6">

<h5 class="font-bold text-yellow-700 mb-4">
🎤 Speaking Exercises (Admin)
</h5>

<%= lesson.fields_for :speaking_topics do |topic| %>

<div class="topic-box bg-white border rounded-lg p-4 mb-4">

<div class="grid grid-cols-2 gap-3 mb-3">

<%= topic.text_field :title,
placeholder:"Topic Title",
class:"border px-3 py-2" %>

<%= topic.select :part,
SpeakingTopic.parts.keys.map{|p|[p.upcase,p]},
{},
class:"border px-3 py-2 part-select",
onchange:"toggleCueCard(this)" %>


</div>

<div class="questions">

<%= topic.fields_for :speaking_questions do |q| %>

<div class="question-item border rounded-lg p-4 mb-3 bg-slate-50">

<label class="text-xs font-semibold">Question</label>
<%= q.text_area :question_text,
class:"border w-full px-3 py-2 mb-3" %>

<div class="cue-card-field">
<label class="text-xs font-semibold">Cue Card</label>
<%= q.text_area :cue_card,
class:"border w-full px-3 py-2 mb-3" %>
</div>


<div class="grid grid-cols-2 gap-3">

<%= q.number_field :preparation_time,
placeholder:"Preparation Time (sec)",
class:"border px-3 py-2 w-full" %>

<%= q.number_field :speaking_time,
placeholder:"Speaking Time (sec)",
class:"border px-3 py-2 w-full" %>

</div>

</div>

<% end %>

</div>
</div>

<% end %>

</div>
</div>

<% end %>

</div>
</div>

<% end %>

<div class="flex justify-end gap-4 mt-10">

<%= link_to "Cancel",
admin_courses_path,
class:"px-6 py-2 border rounded-lg bg-white" %>

<%= f.submit "💾 Save Course",
class:"px-8 py-3 bg-indigo-600 text-white rounded-xl shadow hover:bg-indigo-700" %>

</div>

<% end %>

</div>
</div>
<template id="section-template">

<div class="bg-slate-50 border rounded-xl p-6 mt-6">

<h3 class="font-bold text-lg mb-4 text-indigo-700">
📂 Section
</h3>

<input type="text"
name="course[course_sections_attributes][NEW_SECTION][title]"
placeholder="Section Title"
class="border px-3 py-2 w-full mb-4"/>

</div>

</template>

<!-- JS VALIDATION -->
<script>
const MAX_VIDEO = 5 * 1024 * 1024
const MAX_PDF   = 500 * 1024

function showAlert(type,message){
const div=document.createElement("div")
div.className="p-3 rounded shadow bg-white border"
div.innerHTML=message
document.getElementById("alert-container").appendChild(div)
setTimeout(()=>div.remove(),4000)
}

function handleVideoUpload(input){
const file=input.files[0]
if(!file)return

if(!file.type.includes("mp4")){
showAlert("danger","❌ Video phải là MP4")
input.value=""
return
}

if(file.size>MAX_VIDEO){
showAlert("danger","❌ Video vượt quá 5MB")
input.value=""
return
}

showAlert("success",`🎬 Upload video: <b>${file.name}</b>`)
}

function handlePDFUpload(input){

const files=Array.from(input.files)
if(files.length===0)return

for(const file of files){

if(file.type!=="application/pdf"){
showAlert("danger",`❌ ${file.name} không phải PDF`)
input.value=""
return
}

if(file.size>MAX_PDF){
showAlert("danger",`❌ ${file.name} vượt quá 500KB`)
input.value=""
return
}

}

showAlert("success",`📄 Upload ${files.length} file PDF`)
}
</script>
<script>
let sectionIndex = 1000

function addSection(){

const template = document
.getElementById("section-template")
.innerHTML

const html = template.replaceAll(
"NEW_SECTION",
sectionIndex++
)

document
.getElementById("sections")
.insertAdjacentHTML("beforeend",html)

}
</script>

<script>
function toggleCueCard(select){

const topicBox = select.closest(".topic-box")

const cueCards = topicBox.querySelectorAll(".cue-card-field")

cueCards.forEach(card=>{
if(select.value === "part2"){
card.style.display = "block"
}else{
card.style.display = "none"
}
})

}
document.addEventListener("DOMContentLoaded",()=>{

document.querySelectorAll(".part-select")
.forEach(select=>toggleCueCard(select))

})

</script>
