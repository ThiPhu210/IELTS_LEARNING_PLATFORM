<!-- NAVBAR -->
<%= render "admin/shared/navbar" %>

<div id="alert-container" class="fixed top-20 right-6 z-50 w-full max-w-md space-y-3"></div>
<div class="pt-24 px-8 pb-16 bg-slate-100 min-h-screen">
<div class="max-w-6xl mx-auto">

<h1 class="text-3xl font-bold text-slate-800 mb-10">
🎓 Admin Course Editor
</h1>

<%= form_with model: [:admin,@course], local:true, multipart:true do |f| %>

<!-- COURSE INFO -->
<div class="bg-white rounded-2xl shadow-lg p-8 mb-10 space-y-6">

<h2 class="text-xl font-semibold border-b pb-3">
📘 Course Information
</h2>

<%= f.text_field :title,
placeholder:"Course Title",
class:"w-full border rounded-lg px-4 py-2" %>

<%= f.text_area :description,
rows:4,
placeholder:"Description",
class:"w-full border rounded-lg px-4 py-2" %>

<div class="grid grid-cols-2 gap-6">

<%= f.number_field :price,
min:0,
step:1000,
placeholder:"Price VND",
class:"w-full border rounded-lg px-4 py-2" %>

<div>
<% if @course.persisted? && @course.thumbnail.attached? %>
  <%= image_tag @course.thumbnail.variant(resize_to_limit: [260,160]),
      class:"rounded-lg mb-3 border" %>
<% end %>
<%= f.file_field :thumbnail %>
</div>

</div>
</div>

<!-- COURSE CONTENT -->
<div class="bg-white rounded-2xl shadow-lg p-8">

<h2 class="text-xl font-semibold mb-8 border-b pb-3">
📚 Course Structure
</h2>

<button type="button"
onclick="addSection()"
class="mb-6 px-5 py-2 bg-indigo-600 text-white rounded-lg">
➕ Add Section
</button>

<div id="sections" class="space-y-8">

<%= f.fields_for :course_sections do |section| %>

<div class="bg-slate-50 border rounded-xl p-6 section-item">

<button type="button"
onclick="removeSection(this)"
class="text-sm text-red-500 mb-4">
🗑 Remove Section
</button>

<%= section.text_field :title,
placeholder:"Section Title",
class:"border rounded px-3 py-2 w-full mb-6" %>

<div class="space-y-6 lessons">

<%= section.fields_for :lessons do |lesson| %>

<div class="lesson-item bg-white border rounded-xl p-6 shadow-sm">

<div class="grid grid-cols-2 gap-4 mb-4">

<%= lesson.text_field :title,
placeholder:"Lesson Title",
class:"border rounded px-3 py-2" %>

<%= lesson.number_field :duration,
placeholder:"Duration",
class:"border rounded px-3 py-2" %>

</div>

<%= lesson.file_field :video, accept:"video/mp4", class:"mt-2" %>
<%= lesson.file_field :pdfs, multiple:true, accept:"application/pdf", class:"mt-4" %>

</div>

<% end %>

</div>
</div>

<% end %>

</div>

<!-- ACTION BUTTONS -->
<div class="flex justify-end gap-4 mt-10">

<%= link_to "Cancel",
admin_courses_path,
class:"px-6 py-2 border rounded-lg bg-white" %>

<%= f.submit "💾 Save Course",
class:"px-8 py-3 bg-indigo-600 text-white rounded-xl shadow hover:bg-indigo-700" %>

</div>

</div>

<% end %>

</div>
</div>

<!-- TEMPLATE -->
<template id="section-template">

<div class="bg-slate-50 border rounded-xl p-6 mt-8 section-item">

<button type="button"
onclick="removeSection(this)"
class="text-sm text-red-500 mb-4">
🗑 Remove Section
</button>

<input type="text"
name="course[course_sections_attributes][NEW_SECTION][title]"
placeholder="Section Title"
class="border rounded px-3 py-2 w-full mb-6"/>

<div class="lesson-item bg-white border rounded-xl p-6 shadow-sm">

<div class="grid grid-cols-2 gap-4 mb-4">

<input type="text"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][title]"
placeholder="Lesson Title"
class="border rounded px-3 py-2"/>

<input type="number"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][duration]"
placeholder="Duration"
class="border rounded px-3 py-2"/>

</div>

<input type="file"
accept="video/mp4"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][video]"
class="mt-2"/>

<input type="file"
multiple
accept="application/pdf"
name="course[course_sections_attributes][NEW_SECTION][lessons_attributes][0][pdfs][]"
class="mt-4"/>

</div>

</div>

</template>

<!-- JS VALIDATION -->
<script>
const MAX_VIDEO = 5 * 1024 * 1024
const MAX_PDF   = 500 * 1024

function showAlert(type,message){
const div=document.createElement("div")
div.className="p-3 rounded shadow bg-white border"
div.innerHTML=message
document.getElementById("alert-container").appendChild(div)
setTimeout(()=>div.remove(),4000)
}

function handleVideoUpload(input){
const file=input.files[0]
if(!file)return

if(!file.type.includes("mp4")){
showAlert("danger","❌ Video phải là MP4")
input.value=""
return
}

if(file.size>MAX_VIDEO){
showAlert("danger","❌ Video vượt quá 5MB")
input.value=""
return
}

showAlert("success",`🎬 Upload video: <b>${file.name}</b>`)
}

function handlePDFUpload(input){

const files=Array.from(input.files)
if(files.length===0)return

for(const file of files){

if(file.type!=="application/pdf"){
showAlert("danger",`❌ ${file.name} không phải PDF`)
input.value=""
return
}

if(file.size>MAX_PDF){
showAlert("danger",`❌ ${file.name} vượt quá 500KB`)
input.value=""
return
}

}

showAlert("success",`📄 Upload ${files.length} file PDF`)
}
</script>
<script>
let sectionIndex = 1000

function removeSection(btn){
btn.closest(".section-item").remove()
}

function addSection(){

const template = document
.getElementById("section-template")
.innerHTML

const html = template.replaceAll(
"NEW_SECTION",
sectionIndex++
)

document
.getElementById("sections")
.insertAdjacentHTML("beforeend",html)

}
</script>

<script>
function toggleCueCard(select){

const topicBox = select.closest(".topic-box")

const cueCards = topicBox.querySelectorAll(".cue-card-field")

cueCards.forEach(card=>{
if(select.value === "part2"){
card.style.display = "block"
}else{
card.style.display = "none"
}
})

}
document.addEventListener("DOMContentLoaded",()=>{

document.querySelectorAll(".part-select")
.forEach(select=>toggleCueCard(select))

})

</script>

