<h2 class="text-2xl font-semibold text-blueGray-700 mb-6">
  Edit Course
</h2>

<%= form_with model: [:admin, @course],
              local: true,
              multipart: true do |f| %>

  <!-- ================= COURSE INFO ================= -->

  <div class="bg-white rounded-xl shadow-lg p-6 max-w-4xl mb-16">

    <!-- IMAGE -->
    <div class="mb-8">
      <label class="block text-sm font-semibold text-blueGray-600 mb-3">
        Course Thumbnail
      </label>

      <% if @course.thumbnail.attached? %>
        <div class="mb-3">
          <%= image_tag @course.thumbnail.variant(resize_to_limit: [300, 200]),
            class: "rounded-lg shadow" %>
        </div>
      <% end %>

      <%= f.file_field :thumbnail,
        accept: "image/png,image/jpg,image/jpeg",
        class: "block w-full text-sm" %>
    </div>

    <!-- TITLE -->
    <div class="mb-6">
      <label class="block text-sm font-semibold text-blueGray-600 mb-2">
        Course Title
      </label>
      <%= f.text_field :title,
        class: "w-full border rounded-md px-4 py-3" %>
    </div>

    <!-- DESCRIPTION -->
    <div class="mb-6">
      <label class="block text-sm font-semibold text-blueGray-600 mb-2">
        Description
      </label>
      <%= f.text_area :description,
        rows: 5,
        class: "w-full border rounded-md px-4 py-3" %>
    </div>

  </div>

  <!-- ================= COURSE CONTENT ================= -->

  <h2 class="text-2xl font-semibold text-blueGray-700 mb-6">
    Course Content
  </h2>

  <div id="sections">
    <%= f.fields_for :course_sections do |section| %>

      <div class="mb-8 p-6 bg-blueGray-50 rounded-lg">

        <!-- SECTION TITLE -->
        <%= section.text_field :title,
          placeholder: "Section title",
          class: "w-full font-semibold text-lg border rounded-md px-4 py-2 mb-4" %>

        <!-- LESSONS -->
        <div class="space-y-4 ml-4">
          <%= section.fields_for :lessons do |lesson| %>

            <div class="p-4 bg-white rounded-md shadow">

              <%= lesson.text_field :title,
                placeholder: "Lesson title",
                class: "w-full mb-2 border rounded px-3 py-2" %>

              <%= lesson.number_field :duration,
                placeholder: "Duration (min)",
                class: "w-full mb-2 border rounded px-3 py-2" %>

              <!-- ================= VIDEO ================= -->
              <div class="mt-3">
                <label class="block text-xs font-semibold text-blueGray-600 mb-1">
                  Video (MP4)
                </label>

                <% if lesson.object.video.attached? %>
                  <div class="relative w-64 mb-2">

                    <%= image_tag lesson.object.video_thumbnail,
                      class: "rounded shadow" %>

                    <button type="button"
                      onclick="this.nextElementSibling.classList.toggle('hidden')"
                      class="absolute inset-0 flex items-center justify-center bg-black/40 text-white rounded">
                      ▶ Play
                    </button>

                    <video controls class="hidden mt-2 w-full rounded">
                      <source src="<%= url_for(lesson.object.video) %>" type="video/mp4">
                    </video>

                  </div>
                <% end %>

                <%= lesson.file_field :video,
                  accept: "video/mp4" %>
              </div>

              <!-- ================= PDF ================= -->
              <div class="mt-4">
                <label class="block text-xs font-semibold text-blueGray-600 mb-1">
                  PDFs
                </label>

                <% if lesson.object.pdfs.attached? %>
                  <ul class="text-sm text-blue-600 mb-2 space-y-1">
                    <% lesson.object.pdfs.each do |pdf| %>
                      <li>
                        📄 <%= link_to pdf.filename,
                          url_for(pdf),
                          target: "_blank",
                          class: "underline" %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>

                <%= lesson.file_field :pdfs,
                  multiple: true,
                  accept: "application/pdf" %>
              </div>

              <!-- REMOVE -->
              <label class="mt-3 inline-flex items-center text-sm text-red-500">
                <%= lesson.check_box :_destroy %>
                <span class="ml-2">Remove lesson</span>
              </label>

            </div>

          <% end %> <!-- END lessons -->
        </div>

        <!-- REMOVE SECTION -->
        <label class="mt-4 inline-flex items-center text-sm text-red-600">
          <%= section.check_box :_destroy %>
          <span class="ml-2">Remove section</span>
        </label>

      </div>

    <% end %> <!-- END sections -->
  </div>

  <!-- ================= SAVE ================= -->

  <div class="flex justify-end mt-10 gap-3">
    <%= link_to "Cancel",
      admin_courses_path,
      class: "px-5 py-2 border rounded-md" %>

    <%= f.submit "Save Course & Content",
      class: "px-6 py-3 bg-emerald-500 text-white rounded-md shadow hover:bg-emerald-600" %>
  </div>

<% end %>
