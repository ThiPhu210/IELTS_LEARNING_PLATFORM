<%# ============================================================
    app/views/admin/courses/index.html.erb
    Design: Red + Ink color scheme — synced with edit.html.erb
    ============================================================ %>

<%= render "admin/shared/navbar" %>
<%= render "admin/shared/sidebar" %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
:root {
  --ink:          #0d0e14;
  --ink-2:        #3a3d52;
  --ink-3:        #7b7f96;
  --line:         #e8eaf2;
  --bg:           #f2f4f9;
  --surface:      #ffffff;
  --surface-2:    #f7f8fc;
  --primary:      #dc2626;
  --primary-lt:   #fee2e2;
  --primary-glow: rgba(220,38,38,.18);
  --teal:         #0d9488;
  --teal-lt:      #e6faf8;
  --amber:        #d97706;
  --amber-lt:     #fef3e1;
  --rose:         #e11d48;
  --rose-lt:      #fce7ef;
  --emerald:      #059669;
  --emerald-lt:   #e6f7f1;
  --r-sm: 10px; --r-md: 16px; --r-lg: 22px; --r-xl: 28px;
  --shadow-xs: 0 1px 3px rgba(0,0,0,.06);
  --shadow-sm: 0 2px 10px rgba(0,0,0,.07);
  --shadow-md: 0 6px 24px rgba(0,0,0,.09);
  --shadow-lg: 0 16px 48px rgba(0,0,0,.12);
  --font:       'Plus Jakarta Sans', sans-serif;
  --font-serif: 'Instrument Serif', serif;
  --font-mono:  'JetBrains Mono', monospace;
  --ease: cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; }
body { font-family: var(--font); background: var(--bg); color: var(--ink); }

@keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }

/* ═══ PAGE HERO ═══ */
.page-hero {
  position: relative; overflow: hidden;
  background: var(--ink); min-height: 120px;
}
.page-hero-noise {
  position: absolute; inset: 0; opacity: .035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 200px;
}
.page-hero-accent {
  position: absolute; right: -60px; top: -60px;
  width: 300px; height: 300px; border-radius: 50%;
  background: radial-gradient(circle, rgba(220,38,38,.2) 0%, transparent 70%);
  pointer-events: none;
}
.page-hero-inner {
  position: relative; z-index: 1;
  padding: 28px 32px 32px;
  display: flex; align-items: flex-end; justify-content: space-between; gap: 20px;
  flex-wrap: wrap; animation: fadeUp .4s var(--ease) both;
}
.page-breadcrumb {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
  color: rgba(255,255,255,.35); margin-bottom: 8px;
}
.page-breadcrumb a { color: #fca5a5; text-decoration: none; }
.page-breadcrumb a:hover { opacity: .75; }
.page-hero-title {
  font-family: var(--font-serif);
  font-size: clamp(22px, 2.4vw, 34px); font-weight: 400;
  line-height: 1.15; letter-spacing: -.02em; color: #fff;
}
.page-hero-title em { font-style: italic; color: #fca5a5; }
.page-hero-sub { font-size: 12.5px; color: rgba(255,255,255,.4); margin-top: 6px; }

.btn-new-course {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 10px 20px; background: var(--primary); color: #fff;
  font-size: 13px; font-weight: 700; border-radius: var(--r-md);
  text-decoration: none; border: none; cursor: pointer;
  transition: all .2s var(--ease); font-family: var(--font);
  box-shadow: 0 4px 16px var(--primary-glow); flex-shrink: 0;
}
.btn-new-course:hover { background: #b91c1c; transform: translateY(-1px); }

/* ═══ MAIN LAYOUT ═══ */
.courses-layout {
  padding: 28px 32px 60px;
}

/* ═══ STATS ROW ═══ */
.stats-row {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;
  margin-bottom: 28px;
}
.stat-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); padding: 16px 18px;
  box-shadow: var(--shadow-xs);
  animation: fadeUp .4s var(--ease) both;
}
.stat-card-icon  {
  width: 32px; height: 32px; border-radius: var(--r-sm); margin-bottom: 12px;
  display: flex; align-items: center; justify-content: center; font-size: 15px;
}
.stat-card-num   { font-family: var(--font-mono); font-size: 26px; font-weight: 700; color: var(--ink); line-height: 1; }
.stat-card-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-3); margin-top: 6px; }

/* ═══ COURSE CARD ═══ */
.course-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--shadow-xs);
  transition: box-shadow .2s var(--ease), border-color .2s var(--ease), transform .2s var(--ease);
  margin-bottom: 16px; position: relative;
  animation: fadeUp .45s var(--ease) both;
}
.course-card:hover { box-shadow: var(--shadow-md); border-color: #fca5a5; transform: translateY(-2px); }
.course-card-inner { display: flex; flex-direction: row; }

/* Thumbnail */
.course-thumb {
  width: 240px; flex-shrink: 0; position: relative; overflow: hidden;
  background: var(--surface-2);
}
.course-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s var(--ease); }
.course-card:hover .course-thumb img { transform: scale(1.04); }
.course-thumb-placeholder {
  width: 100%; height: 100%; min-height: 170px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  background: linear-gradient(135deg, var(--surface-2) 0%, var(--primary-lt) 100%);
  color: var(--ink-3);
}
.course-thumb-placeholder span { font-size: 11px; font-weight: 600; color: var(--ink-3); }

.band-badge {
  position: absolute; bottom: 10px; left: 10px;
  padding: 4px 10px; border-radius: 20px;
  background: rgba(13,14,20,.75); backdrop-filter: blur(6px);
  font-family: var(--font-mono); font-size: 10px; font-weight: 700;
  color: #fca5a5; border: 1px solid rgba(252,165,165,.3);
}

/* Content */
.course-content { flex: 1; padding: 20px 22px; padding-right: 48px; min-width: 0; display: flex; flex-direction: column; gap: 11px; }

.course-title-link { text-decoration: none; display: block; }
.course-title {
  font-family: var(--font-serif); font-size: 19px; font-weight: 400;
  color: var(--ink); line-height: 1.25; letter-spacing: -.01em;
  transition: color .15s;
}
.course-title-link:hover .course-title { color: var(--primary); }

.course-desc {
  font-size: 13px; color: var(--ink-3); line-height: 1.7;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.course-meta-row { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.meta-chip {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
  font-family: var(--font-mono); border: 1.5px solid transparent; white-space: nowrap;
}
.chip-price    { background: var(--emerald-lt); color: var(--emerald); border-color: #a7f3d0; }
.chip-active   { background: var(--emerald-lt); color: var(--emerald); border-color: #a7f3d0; }
.chip-inactive { background: var(--surface-2);  color: var(--ink-3);   border-color: var(--line); }
.chip-draft    { background: var(--amber-lt);   color: var(--amber);   border-color: #fde68a; }
.chip-sections { background: var(--primary-lt); color: var(--primary); border-color: #fca5a5; }
.chip-neutral  { background: var(--surface-2);  color: var(--ink-3);   border-color: var(--line); }

.course-footer {
  margin-top: auto; padding-top: 12px; border-top: 1.5px solid var(--line);
  display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
}
.course-actions { display: flex; align-items: center; gap: 8px; }

.btn-edit {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 16px; background: var(--primary); color: #fff;
  font-size: 12px; font-weight: 700; border-radius: var(--r-sm);
  text-decoration: none; transition: all .2s var(--ease);
  box-shadow: 0 2px 8px var(--primary-glow);
}
.btn-edit:hover { background: #b91c1c; transform: translateY(-1px); }

.btn-view {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px; background: var(--surface-2); color: var(--ink-2);
  font-size: 12px; font-weight: 700; border-radius: var(--r-sm);
  text-decoration: none; border: 1.5px solid var(--line); transition: all .15s;
}
.btn-view:hover { border-color: var(--teal); color: var(--teal); background: var(--teal-lt); }

.course-dropdown-wrap { position: absolute; top: 14px; right: 14px; z-index: 20; }

/* ═══ EMPTY STATE ═══ */
.empty-state {
  text-align: center; padding: 64px 32px;
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-xl); box-shadow: var(--shadow-xs);
  animation: fadeUp .4s var(--ease) both;
}
.empty-icon {
  width: 60px; height: 60px; border-radius: var(--r-lg); margin: 0 auto 16px;
  background: var(--primary-lt); display: flex; align-items: center; justify-content: center; font-size: 26px;
}
.empty-title { font-family: var(--font-serif); font-size: 22px; color: var(--ink); margin-bottom: 8px; }
.empty-sub   { font-size: 13px; color: var(--ink-3); margin-bottom: 24px; }

/* ═══ PAGINATION ═══ */
.pagination-wrap { margin-top: 24px; }
nav.pagination {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  font-family: var(--font-mono); font-size: 13px; font-weight: 600;
}
nav.pagination a,
nav.pagination span {
  padding: 7px 13px; border-radius: var(--r-sm);
  border: 1.5px solid var(--line); background: var(--surface);
  color: var(--ink-2); text-decoration: none; transition: all .15s;
  display: inline-flex; align-items: center;
}
nav.pagination a:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-lt); }
nav.pagination .current {
  background: var(--primary); color: #fff; border-color: var(--primary);
  box-shadow: 0 2px 8px var(--primary-glow);
}
nav.pagination .disabled { opacity: .35; pointer-events: none; }

/* ═══ RESPONSIVE ═══ */
@media (max-width: 860px) {
  .course-card-inner { flex-direction: column; }
  .course-thumb { width: 100%; height: 180px; }
  .stats-row { grid-template-columns: repeat(2, 1fr); }
  .course-content { padding-right: 22px; }
}
@media (max-width: 580px) {
  .courses-layout { padding: 20px 18px 48px; }
  .page-hero-inner { padding: 22px 18px 26px; }
}
</style>

<main class="pt-16 sm:ml-64">

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-noise"></div>
    <div class="page-hero-accent"></div>
    <div class="page-hero-inner">
      <div>
        <nav class="page-breadcrumb">
          <a href="#">Admin</a>
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          <span>Courses</span>
        </nav>
        <h1 class="page-hero-title">All <em>Courses</em></h1>
        <p class="page-hero-sub">
          <%= begin; @courses.total_count; rescue; @courses.count; end %> course<%= (@courses.count != 1 ? 's' : '') %> in the system
        </p>
      </div>
      <%= link_to new_admin_course_path, class: "btn-new-course" do %>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Course
      <% end %>
    </div>
  </div>

  <!-- MAIN -->
  <div class="courses-layout">

    <!-- STATS -->
    <div class="stats-row">
      <div class="stat-card" style="animation-delay:.04s">
        <div class="stat-card-icon" style="background:var(--primary-lt)">📚</div>
        <div class="stat-card-num"><%= begin; @courses.total_count; rescue; @courses.count; end %></div>
        <div class="stat-card-label">Total Courses</div>
      </div>
      <div class="stat-card" style="animation-delay:.07s">
        <div class="stat-card-icon" style="background:var(--emerald-lt)">✅</div>
        <div class="stat-card-num">
          <%= @courses.select { |c| c.status.to_s == 'active' rescue false }.count rescue '—' %>
        </div>
        <div class="stat-card-label">Active</div>
      </div>
      <div class="stat-card" style="animation-delay:.10s">
        <div class="stat-card-icon" style="background:var(--amber-lt)">📝</div>
        <div class="stat-card-num">
          <%= @courses.select { |c| c.status.to_s != 'active' rescue false }.count rescue '—' %>
        </div>
        <div class="stat-card-label">Draft / Inactive</div>
      </div>
      <div class="stat-card" style="animation-delay:.13s">
        <div class="stat-card-icon" style="background:var(--teal-lt)">🎤</div>
        <div class="stat-card-num">
          <%= @courses.sum { |c|
            begin
              c.course_sections.sum { |s| s.lessons.sum { |l| l.speaking_topics.count } }
            rescue
              0
            end
          } %>
        </div>
        <div class="stat-card-label">Speaking Topics</div>
      </div>
    </div>

    <!-- COURSE LIST -->
    <% if @courses.any? %>
      <% @courses.each_with_index do |course, i| %>

        <div class="course-card" style="animation-delay:<%= 0.10 + i * 0.05 %>s">

          <!-- Dropdown -->
          <div class="course-dropdown-wrap">
            <%= render "dropdown", course: course %>
          </div>

          <div class="course-card-inner">

            <!-- Thumbnail -->
            <div class="course-thumb">
              <% if course.thumbnail.attached? %>
                <%= image_tag course.thumbnail.variant(resize_to_fill: [400, 300]), alt: course.title %>
              <% else %>
                <div class="course-thumb-placeholder">
                  <span style="font-size:30px">📚</span>
                  <span>No Image</span>
                </div>
              <% end %>
              <% if course.band_min.present? && course.band_max.present? %>
                <div class="band-badge">Band <%= course.band_min %>–<%= course.band_max %></div>
              <% end %>
            </div>

            <!-- Content -->
            <div class="course-content">

              <%= link_to edit_admin_course_path(course), class: "course-title-link" do %>
                <h3 class="course-title"><%= course.title %></h3>
              <% end %>

              <% if course.description.present? %>
                <p class="course-desc"><%= course.description %></p>
              <% end %>

              <!-- Meta chips -->
              <div class="course-meta-row">
                <!-- Price -->
                <span class="meta-chip chip-price">
                  <%= number_with_delimiter(course.price || 0) %>₫
                </span>

                <!-- Status -->
                <%
                  sv = course.status.to_s rescue 'draft'
                  sc = sv == 'active' ? 'chip-active' : (sv == 'draft' ? 'chip-draft' : 'chip-inactive')
                %>
                <span class="meta-chip <%= sc %>">
                  <%= sv == 'active' ? '● ' : '○ ' %><%= sv.capitalize %>
                </span>

                <!-- Sections -->
                <% scount = begin; course.course_sections.count; rescue; 0; end %>
                <% if scount > 0 %>
                  <span class="meta-chip chip-sections">
                    <%= scount %> Section<%= scount != 1 ? 's' : '' %>
                  </span>
                <% end %>

                <!-- Lessons -->
                <% lcount = begin; course.course_sections.sum { |s| s.lessons.count }; rescue; 0; end %>
                <% if lcount > 0 %>
                  <span class="meta-chip chip-neutral">
                    <%= lcount %> Lesson<%= lcount != 1 ? 's' : '' %>
                  </span>
                <% end %>
              </div>

              <!-- Footer -->
              <div class="course-footer">
                <div class="course-actions">
                  <%= link_to edit_admin_course_path(course), class: "btn-edit" do %>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Edit
                  <% end %>
                  <%= link_to begin; students_course_path(course); rescue; '#'; end, class: "btn-view" do %>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    Preview
                  <% end %>
                </div>
                <span style="font-size:11px;color:var(--ink-3);font-family:var(--font-mono)">
                  #<%= course.id %>
                  <% if course.updated_at.present? %>
                    · <%= time_ago_in_words(course.updated_at) %> ago
                  <% end %>
                </span>
              </div>

            </div>
          </div>
        </div>

      <% end %>

    <% else %>
      <!-- Empty state -->
      <div class="empty-state">
        <div class="empty-icon">📚</div>
        <h2 class="empty-title">No courses yet</h2>
        <p class="empty-sub">Create your first course to get started.</p>
        <%= link_to new_admin_course_path, class: "btn-new-course" do %>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Create First Course
        <% end %>
      </div>
    <% end %>

    <!-- PAGINATION -->
    <div class="pagination-wrap">
      <%= paginate @courses %>
    </div>

  </div>
</main>
