
  <!-- NAVBAR -->
  <%= render "admin/shared/navbar" %>

  <!-- SIDEBAR -->
  <%= render "admin/shared/sidebar" %>

  <!-- MAIN CONTENT -->
<main class="pt-16 sm:ml-64 p-6">
<div class="flex-1 p-6">
<% @courses.each do |course| %>
  <div class="w-full mb-8">
    <!-- relative đặt ở toàn card -->
    <div class="flex flex-col bg-white shadow-lg rounded-lg overflow-hidden relative">
      
      <!-- Dropdown bám theo toàn card -->
      <div class="absolute top-4 right-4 z-20">
        <%= render "dropdown", course: course %>
      </div>

      <div class="flex flex-col lg:flex-row">
        
        <!-- Phần ảnh -->
        <div class="w-full lg:w-4/12">
          <div class="aspect-w-16 aspect-h-4">
            <% if course.thumbnail.attached? %>
              <%= image_tag course.thumbnail.variant(resize_to_fill: [400, 300]) %>
            <% else %>
              <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                No Image
              </div>
            <% end %>
          </div>
        </div>
<!-- Phần nội dung -->
<div class="w-full lg:w-8/12 p-6">
  <div class="pr-10 space-y-3">

    <!-- TITLE -->
<h3 class="text-xl font-semibold flex items-center gap-2">
<%= link_to edit_admin_course_path(course),
  class: "block text-blueGray-700 hover:text-emerald-600 transition" do %>
  <h3 class="text-xl font-semibold">
    <%= course.title %>
  </h3>
<% end %>

</h3>



    <!-- META INFO -->
    <div class="text-sm text-blueGray-500 space-y-1">

      <div>
        <span class="font-medium text-blueGray-600">Band:</span>
        <%= course.band_min %> – <%= course.band_max %>
      </div>

      <div>
        <span class="font-medium text-blueGray-600">Price:</span>
        <span class="text-emerald-600 font-semibold">
          <%= number_to_currency(course.price, unit: "₫", precision: 0) %>
        </span>
      </div>

      <div>
        <span class="font-medium text-blueGray-600">Status:</span>
        <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold
          <%= course.status == "active" ? "bg-emerald-100 text-emerald-700" : "bg-green-200 text-gray-600" %>">
          <%= course.status.capitalize %>
        </span>
      </div>

    </div>

    <!-- DESCRIPTION -->
    <p class="pt-2 text-blueGray-400 text-sm leading-relaxed">
      <%= truncate(course.description, length: 150) %>
    </p>

  </div>
</div>

      </div>
    </div>
  </div>
<% end %>
      <!-- PAGINATION -->
      <div class="p-4">
        <%= paginate @courses %>
      </div>
</div>
</main>


<style>
nav.pagination {
  display: flex;
  gap: 0.5rem;
}
nav.pagination a,
nav.pagination span {
  padding: 0.5rem 0.75rem;
  border-radius: 0.375rem;
}
nav.pagination .current { 
  background: #4f46e5;
  color: white;
}   
</style>
