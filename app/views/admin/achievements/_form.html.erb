<%# app/views/admin/achievements/_form.html.erb
    Rendered inside modal via AJAX — matches Red + Ink LMS design system %>

<style>
.af-grid    { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.af-field   { display: flex; flex-direction: column; gap: 5px; }
.af-field.full { grid-column: 1 / -1; }
.af-label {
  font-size: 11px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .07em; color: #7b7f96;
}
.af-input, .af-textarea {
  padding: 9px 13px; border-radius: 10px;
  border: 1.5px solid #e8eaf2; background: #f7f8fc;
  font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13.5px; color: #0d0e14;
  outline: none; transition: border-color .15s, box-shadow .15s; width: 100%;
}
.af-input:focus, .af-textarea:focus {
  border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.08);
  background: #fff;
}
.af-textarea { resize: vertical; min-height: 88px; }

/* Certificate upload section */
.af-cert-wrap {
  display: flex; align-items: center; gap: 16px;
  padding: 14px; background: #f7f8fc; border: 1.5px solid #e8eaf2;
  border-radius: 12px;
}
.af-cert-preview {
  width: 56px; height: 56px; border-radius: 10px; flex-shrink: 0;
  background: #fee2e2; border: 2px solid #fca5a5;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; overflow: hidden;
}
.af-cert-preview img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; }
.af-cert-info { flex: 1; min-width: 0; }
.af-cert-name { font-size: 13px; font-weight: 800; color: #0d0e14; margin-bottom: 2px; }
.af-cert-sub  { font-size: 11px; color: #7b7f96; margin-bottom: 8px; }
.af-file-label {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 8px;
  background: #fff; border: 1.5px solid #e8eaf2;
  font-size: 11.5px; font-weight: 700; color: #3a3d52; cursor: pointer;
  transition: border-color .15s, color .15s;
}
.af-file-label:hover { border-color: #dc2626; color: #dc2626; }
.af-file-input { display: none; }

/* Band score display */
.af-band-wrap {
  position: relative;
}
.af-band-suffix {
  position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
  font-size: 11px; font-weight: 700; color: #7b7f96;
  pointer-events: none;
}

/* Error box */
.af-errors {
  background: #fef2f2; border: 1.5px solid #fca5a5;
  border-radius: 10px; padding: 12px 16px; margin-bottom: 16px;
}
.af-errors li { font-size: 12.5px; color: #dc2626; font-weight: 600; margin-bottom: 2px; }

/* Submit */
.af-submit {
  padding: 10px 24px; border-radius: 10px;
  background: #dc2626; color: #fff; border: none;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 13px; font-weight: 800; cursor: pointer;
  transition: background .15s, transform .1s;
  display: inline-flex; align-items: center; gap: 6px;
}
.af-submit:hover { background: #b91c1c; transform: translateY(-1px); }
.af-submit:active { transform: none; }

.af-section-title {
  font-size: 10px; font-weight: 800; text-transform: uppercase;
  letter-spacing: .10em; color: #7b7f96;
  padding-bottom: 8px; border-bottom: 1.5px solid #e8eaf2;
  margin-bottom: 14px; margin-top: 20px;
}
.af-section-title:first-of-type { margin-top: 0; }
</style>

<% if achievement.errors.any? %>
  <div class="af-errors">
    <ul>
      <% achievement.errors.full_messages.each do |msg| %>
        <li>• <%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: achievement,
              url: admin_achievement_path(achievement),
              method: :patch,
              local: true,
              html: { enctype: "multipart/form-data" } do |f| %>

  <!-- Certificate Image -->
  <div class="af-section-title">Certificate Image</div>
  <div class="af-cert-wrap" style="margin-bottom:20px">
    <div class="af-cert-preview" id="cert-preview">
      <% if achievement.result&.attached? %>
        <%= image_tag achievement.result.variant(resize_to_fill: [56, 56]).processed,
            id: "cert-img", alt: "Certificate" %>
      <% else %>
        <span id="cert-placeholder">🏅</span>
      <% end %>
    </div>
    <div class="af-cert-info">
      <div class="af-cert-name">
        <%= achievement.title.present? ? achievement.title : "Certificate" %>
      </div>
      <div class="af-cert-sub">JPG, PNG or PDF · max 5MB</div>
      <label class="af-file-label" for="cert-file-input">
        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
        </svg>
        Choose file
      </label>
      <%= f.file_field :result,
          id: "cert-file-input",
          class: "af-file-input",
          accept: "image/*,application/pdf",
          onchange: "previewCert(this)" %>
    </div>
  </div>

  <!-- Basic Info -->
  <div class="af-section-title">Achievement Details</div>
  <div class="af-grid" style="margin-bottom:16px">
    <div class="af-field">
      <%= f.label :title, "Title", class: "af-label" %>
      <%= f.text_field :title, class: "af-input", placeholder: "e.g. IELTS Certificate" %>
    </div>
    <div class="af-field">
      <%= f.label :year, "Year", class: "af-label" %>
      <%= f.number_field :year, class: "af-input", placeholder: "2024",
          min: 2000, max: Time.current.year + 1 %>
    </div>
    <div class="af-field">
      <%= f.label :ielts_overall_band, "IELTS Overall Band", class: "af-label" %>
      <div class="af-band-wrap">
        <%= f.number_field :ielts_overall_band,
            step: 0.5, min: 0, max: 9,
            class: "af-input",
            placeholder: "e.g. 7.5",
            style: "padding-right: 52px;" %>
        <span class="af-band-suffix">/ 9.0</span>
      </div>
    </div>
    <div class="af-field full">
      <%= f.label :description, "Description", class: "af-label" %>
      <%= f.text_area :description,
          class: "af-textarea",
          placeholder: "Brief description of this achievement…" %>
    </div>
  </div>

  <div style="display:flex;justify-content:flex-end">
    <%= f.submit "💾 Save Changes", class: "af-submit" %>
  </div>

<% end %>

<script>
function previewCert(input) {
  if (!input.files || !input.files[0]) return;
  var file = input.files[0];
  if (!file.type.startsWith('image/')) return; // skip PDF preview
  var reader = new FileReader();
  reader.onload = function(e) {
    var preview     = document.getElementById('cert-preview');
    var placeholder = document.getElementById('cert-placeholder');
    var img         = document.getElementById('cert-img');
    if (placeholder) placeholder.style.display = 'none';
    if (img) {
      img.src = e.target.result;
    } else {
      var newImg = document.createElement('img');
      newImg.id  = 'cert-img';
      newImg.src = e.target.result;
      newImg.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:8px;';
      preview.appendChild(newImg);
    }
  };
  reader.readAsDataURL(file);
}
</script>
