<h2 class="text-xl font-bold mb-4">Thông tin Thành tích</h2>
<!-- ===== FORM UPDATE (PATCH) ===== -->
<%= form_with model: achievement,
              url: admin_achievement_path(achievement),
              method: :patch,
              local: true do |f| %>

  <!-- BASIC INFO -->
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :title, "Tiêu đề", class: "label" %>
      <%= f.text_field :title, class: "input" %>
    </div>

    <div>
      <%= f.label :year, "Năm", class: "label" %>
      <%= f.number_field :year, class: "input" %>
    </div>
  </div>

  <div class="mt-6">
    <%= f.label :result, "Chứng chỉ (ảnh)", class: "label" %>

    <% if achievement.result.attached? %>
      <div class="mb-3">
        <%= image_tag achievement.result.variant(resize_to_fill: [80, 80]).processed,
            class: "rounded object-cover border",
            alt: "Certificate",
            srcset: "#{url_for(achievement.result.variant(resize_to_fill: [80, 80]).processed)}?#{Time.current.to_i}" %>
      </div>
    <% end %>

    <%= f.file_field :result, class: "input" %>
  </div>

  <div class="mt-6">
    <%= f.label :ielts_overall_band, "IELTS Overall Band", class: "label" %>
    <%= f.number_field :ielts_overall_band, step: 0.5, class: "input" %>
  </div>

  <div class="mt-4">
    <%= f.label :description, "Mô tả", class: "label" %>
    <%= f.text_area :description, rows: 4, class: "input" %>
  </div>

  <!-- SAVE BUTTON -->
  <div class="mt-8 text-right">
    <%= f.submit "💾 Lưu thay đổi",
          class: "px-5 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-500" %>
  </div>

<% end %>

<% if achievement.errors.any? %>
  <div class="bg-red-100 text-red-700 p-4 rounded mb-4">
    <ul>
      <% achievement.errors.full_messages.each do |msg| %>
        <li>• <%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

</div>

<style>
.label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
}

.input {
  width: 100%;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #ddd;
}

.avatar-wrapper {
  border-radius: 9999px;
  overflow: hidden;
  flex-shrink: 0;
  background: #f3f4f6;
}

.avatar-img {
  width: 50%;
  height: 50%;
  object-fit: cover;
  display: block;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #e5e7eb;
}
</style>
