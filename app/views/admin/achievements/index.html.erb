<!-- NAVBAR -->
  <%= render "admin/shared/navbar" %>

  <!-- SIDEBAR -->
  <%= render "admin/shared/sidebar" %>

  <!-- MAIN CONTENT -->
  <main class="pt-16 sm:ml-64 p-6">

  <!-- PAGE TITLE -->
  <h1 class="text-2xl font-bold mb-6">Achievement Management</h1>

  <!-- CARD -->
  <div class="p-4 bg-white border-b border-gray-200 rounded-lg mb-6">

    <!-- BREADCRUMB -->
    <nav class="flex mb-4 text-sm font-medium">
      <ol class="inline-flex items-center space-x-1 md:space-x-2">
        <li class="inline-flex items-center">
          <%= link_to admin_dashboard_path,
              class: "text-gray-700 hover:text-indigo-600 flex items-center" do %>
            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 2L2 9h3v9h10V9h3L10 2z"/>
            </svg>
            Dashboard
          <% end %>
        </li>
        <li class="flex items-center">
          <svg class="w-6 h-6 text-gray-400 mx-1" fill="currentColor" viewBox="0 0 20 20">
            <path d="M7.293 14.707L10.586 11 7.293 7.293 8.707 5.879 13.828 11 8.707 16.121z"/>
          </svg>
          <span class="text-gray-500">Achievements</span>
        </li>
      </ol>
    </nav>

    <!-- TITLE + ACTION -->
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold text-gray-900">All Achievements</h2>
    </div>
  </div>
  

<div class="overflow-x-auto bg-white rounded-lg shadow">
  <table class="w-full text-sm text-left text-gray-500">
    <thead class="bg-gray-100 text-xs uppercase">
      <tr>
        <th class="p-4">Student</th>
        <th class="p-4">Title</th>
        <th class="p-4">Year</th>
        <th class="p-4">Band</th>
        <th class="p-4">Actions</th>
      </tr>
    </thead>

    <tbody class="divide-y">
      <% @achievements.each do |achievement| %>
        <tr class="hover:bg-gray-50">
          <td class="p-4"><%= achievement.user.full_name %></td>
          <td class="p-4"><%= achievement.title %></td>
          <td class="p-4"><%= achievement.year %></td>
          <td class="p-4"><%= achievement.ielts_overall_band %></td>
          <td class="p-4 flex gap-2">
            <%= link_to "Edit",
                "#",
                class: "btn-edit px-3 py-1 text-sm text-white bg-blue-600 rounded",
                data: { achievement_id: achievement.id } %>

            <%= button_to "Destroy",
                admin_achievement_path(achievement),
                method: :delete,
                data: { confirm: "Bạn chắc chắn?" },
                class: "px-3 py-1 text-sm text-white bg-red-600 rounded" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
 
  <div class="p-4">
    <%= paginate @achievements %>
  </div>
</div>
</main>
<style>
nav.pagination {
  display: flex;
  gap: 0.5rem;
}
nav.pagination a,
nav.pagination span {
  padding: 0.5rem 0.75rem;
  border-radius: 0.375rem;
}
nav.pagination .current { 
  background: #4f46e5;
  color: white;
}   
</style>

<!-- EDIT MODAL -->
<div id="edit-modal"
     class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center">

  <div class="bg-white rounded-xl shadow-xl w-full max-w-3xl relative">
    <button id="close-modal"
            class="absolute top-3 right-4 text-xl text-gray-500 hover:text-black">
      ✕
    </button>

    <div id="modal-body" class="p-2">
      <!-- form load vào đây -->
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const editButtons = document.querySelectorAll(".btn-edit");
    const modal = document.getElementById("edit-modal");
    const modalBody = document.getElementById("modal-body");
    const closeModalBtn = document.getElementById("close-modal");

    editButtons.forEach(button => {
      button.addEventListener("click", () => {
        // đổi sang data-achievement-id
        const achievementId = button.getAttribute("data-achievement-id");

        // fetch đúng URL của achievements
        fetch(`/admin/achievements/${achievementId}/edit`, {
          headers: { "Accept": "text/html" }
        })
        .then(response => response.text())
        .then(html => {
          modalBody.innerHTML = html;
          modal.classList.remove("hidden");
        });
      });
    });

    closeModalBtn.addEventListener("click", () => {
      modal.classList.add("hidden");
      modalBody.innerHTML = "";
    });
  });
</script>
