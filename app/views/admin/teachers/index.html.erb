<div class="min-h-screen bg-gray-100">

  <!-- NAVBAR -->
  <%= render "admin/shared/navbar" %>

  <!-- SIDEBAR -->
  <%= render "admin/shared/sidebar" %>

  <!-- MAIN CONTENT -->
  <main class="pt-16 sm:ml-64 p-6">

    <!-- PAGE TITLE -->
    <h1 class="text-2xl font-bold mb-6">👩‍🏫 Teacher Management</h1>

    <!-- CARD -->
    <div class="p-4 bg-white border-b border-gray-200 rounded-lg mb-6">

      <!-- BREADCRUMB -->
      <nav class="flex mb-4 text-sm font-medium">
        <ol class="inline-flex items-center space-x-1 md:space-x-2">
          <li class="inline-flex items-center">
            <%= link_to admin_dashboard_path,
                class: "text-gray-700 hover:text-indigo-600 flex items-center" do %>
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 2L2 9h3v9h10V9h3L10 2z"/>
              </svg>
              Dashboard
            <% end %>
          </li>
          <li class="flex items-center">
            <svg class="w-6 h-6 text-gray-400 mx-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M7.293 14.707L10.586 11 7.293 7.293 8.707 5.879 13.828 11 8.707 16.121z"/>
            </svg>
            <span class="text-gray-500">Teachers</span>
          </li>
        </ol>
      </nav>

      <!-- TITLE + ACTION -->
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-900">All teachers</h2>
      </div>
    </div>

    <!-- TABLE -->
    <div class="overflow-x-auto bg-white rounded-lg shadow">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="bg-gray-100 text-xs uppercase">
          <tr>
            <th class="p-4">Teacher</th>
            <th class="p-4">Email</th>
            <th class="p-4">Expertise</th>
            <th class="p-4">Experience</th>
            <th class="p-4">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y">
          <% @teachers.each do |teacher| %>
            <tr class="hover:bg-gray-50">

              <!-- AVATAR + NAME -->
              <td class="p-4 flex items-center gap-3">

                <% avatar = teacher.teacher_profile&.avatar %>

                <% if avatar&.attached? %>
                  <%= image_tag avatar.variant(resize_to_fill: [40, 40]),
                      class: "w-10 h-10 rounded-full object-cover" %>
                <% else %>
                  <div class="w-10 h-10 rounded-full bg-indigo-500
                              flex items-center justify-center text-white font-bold">
                    <%= teacher.full_name.first.upcase %>
                  </div>
                <% end %>

                <div>
                  <div class="font-medium text-gray-900">
                    <%= teacher.full_name %>
                  </div>
                  <div class="text-xs text-gray-500">
                    ID: <%= teacher.id %>
                  </div>
                </div>
              </td>

              <!-- EMAIL -->
              <td class="p-4"><%= teacher.email %></td>

              <!-- EXPERTISE -->
              <td class="p-4">
                <%= teacher.teacher_profile&.expertise || "N/A" %>
              </td>

              <!-- EXPERIENCE -->
              <td class="p-4">
                <%= teacher.teacher_profile&.experience_years || 0 %> years
              </td>

              <!-- ACTIONS -->
              <td class="p-4 flex gap-2">
                <%= link_to "View",
                    admin_teacher_path(teacher),
                    class: "px-3 py-1 text-sm text-white bg-indigo-600 rounded hover:bg-indigo-700" %>

                <%= link_to "Edit",
                    edit_admin_teacher_path(teacher),
                    class: "px-3 py-1 text-sm text-white bg-blue-600 rounded hover:bg-blue-700" %>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>

      <!-- PAGINATION -->
      <div class="p-4">
        <%= paginate @teachers %>
      </div>
    </div>

  </main>
</div>
<style>
nav.pagination {
  display: flex;
  gap: 0.5rem;
}
nav.pagination a,
nav.pagination span {
  padding: 0.5rem 0.75rem;
  border-radius: 0.375rem;
}
nav.pagination .current { 
  background: #4f46e5;
  color: white;
}   
</style>
