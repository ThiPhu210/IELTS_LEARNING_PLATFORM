
  <!-- NAVBAR -->
  <%= render "admin/shared/navbar" %>

  <!-- SIDEBAR -->
  <%= render "admin/shared/sidebar" %>

  <!-- MAIN CONTENT -->
<main class="pt-16 sm:ml-64 p-6">

    <h1 class="text-2xl font-bold mb-6">👤 User Management</h1>
    <div class="p-4 bg-white border-b border-gray-200 rounded-lg mb-6">

  <!-- Breadcrumb -->
  <nav class="flex mb-4 text-sm font-medium">
    <ol class="inline-flex items-center space-x-1 md:space-x-2">
      <li class="inline-flex items-center">
        <%= link_to admin_dashboard_path, class: "text-gray-700 hover:text-primary-600 flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2L2 9h3v9h10V9h3L10 2z"/>
          </svg>
          Dashboard
        <% end %>
      </li>
      <li class="flex items-center">
        <svg class="w-6 h-6 text-gray-400 mx-1" fill="currentColor" viewBox="0 0 20 20">
          <path d="M7.293 14.707L10.586 11 7.293 7.293 8.707 5.879 13.828 11 8.707 16.121z"/>
        </svg>
        <span class="text-gray-500">Users</span>
      </li>
    </ol>
  </nav>

  <!-- Title + Actions -->
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-semibold text-gray-900">All users</h1>

    <div class="flex gap-2">
      <button data-modal-toggle="add-user-modal"
              class="inline-flex items-center px-3 py-2 text-sm text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
        ➕ Add user
      </button>
    </div>
  </div>
</div>
<div class="overflow-x-auto bg-white rounded-lg shadow">
  <table class="w-full text-sm text-left text-gray-500">
    <thead class="bg-gray-100 text-xs uppercase">
      <tr>
        <th class="p-4">User</th>
        <th class="p-4">Email</th>
        <th class="p-4">Role</th>
        <th class="p-4">Created</th>
        <th class="p-4">Actions</th>
      </tr>
    </thead>

    <tbody class="divide-y">
      <% @users.each do |user| %>
        <tr class="hover:bg-gray-50">

          <!-- AVATAR + NAME -->
          <td class="p-4 flex items-center gap-3">
            <% if user.thumbnail.attached? %>
              <%= image_tag user.thumbnail.variant(resize_to_fill: [40, 40]),
                  class: "w-10 h-10 rounded-full object-cover" %>
            <% else %>
              <div class="w-10 h-10 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold">
                <%= user.full_name.first.upcase %>
              </div>
            <% end %>

            <div>
              <div class="font-medium text-gray-900"><%= user.full_name %></div>
              <div class="text-xs text-gray-500"><%= user.email %></div>
            </div>
          </td>

          <td class="p-4"><%= user.email %></td>

          <td class="p-4 capitalize">
            <span class="px-2 py-1 text-xs rounded bg-gray-100">
              <%= user.role %>
            </span>
          </td>

          <td class="p-4"><%= user.created_at.strftime("%d/%m/%Y") %></td>

          <!-- ACTIONS -->
          <td class="p-4 flex gap-2">
            <%= link_to "Edit",
                edit_admin_user_path(user),
                class: "px-3 py-1 text-sm text-white bg-blue-600 rounded hover:bg-blue-700" %>

            <%= link_to "Delete",
                admin_user_path(user),
                method: :delete,
                data: { confirm: "Are you sure?" },
                class: "px-3 py-1 text-sm text-white bg-red-600 rounded hover:bg-red-700" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="p-4">
    <%= paginate @users %>
</div>

  </main>

<style>
nav.pagination {
  display: flex;
  gap: 0.5rem;
}
nav.pagination a,
nav.pagination span {
  padding: 0.5rem 0.75rem;
  border-radius: 0.375rem;
}
nav.pagination .current {
  background: #4f46e5;
  color: white;
}

</style>
