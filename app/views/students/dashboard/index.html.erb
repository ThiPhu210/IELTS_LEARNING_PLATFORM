                <span class="text-gray-400 text-xs">No avatar</span>
              </div>
            <% end %>

            <h3 class="text-lg font-semibold text-gray-900">
              <%= teacher.full_name.upcase %>
            </h3>

            <p class="text-sm text-blue-600 font-medium mt-1">
              <%= teacher.expertise %>
            </p>

            <p class="text-sm text-gray-500 mt-1">
              <%= teacher.experience_years %> năm kinh nghiệm
            </p>

            <p class="text-sm text-gray-600 mt-4 line-clamp-3">
              <%= teacher.bio %>
            </p>

          </div>
        <% end %>

      </div>
    </div>

  <% end %>
</section>
<!-- PAYMENT MODAL -->
<div id="payment-modal"
     class="fixed inset-0 z-[9999] hidden items-center justify-center">

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/50"
       onclick="closePaymentModal()"></div>

  <!-- Modal box -->
  <div class="relative bg-white rounded-3xl shadow-2xl
              max-w-md min-h-[520px]
              px-8 pt-10 pb-14 z-10 flex flex-col">

    <h2 class="text-2xl font-bold mb-6 mt-6">Thanh toán khóa học</h2>

    <p id="modal-course-title" class="font-semibold mb-2"></p>
    <p id="modal-course-price" class="text-2xl text-red-500 mb-6"></p>

    <form id="payment-form"
      method="post">

  <!-- CSRF TOKEN -->
  <input type="hidden"
         name="authenticity_token"
         value="<%= form_authenticity_token %>">

  <input type="hidden"
         name="course_id"
         id="modal-course-id">

  <!-- PAYMENT METHOD -->
  <label class="flex gap-3 p-4 border rounded-xl cursor-pointer mb-4">
    <input type="radio"
           name="payment_method"
           value="vnpay"
           checked>
    <span>VNPay</span>
  </label>

  <button type="submit"
          class="w-full bg-pink-500 text-white py-3 rounded-lg mb-6">
    Xác nhận thanh toán
  </button>
</form>


    <!-- Close -->
    <button onclick="closePaymentModal()"
      class="absolute top-4 right-4 text-xl">✕</button>

  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const track = document.getElementById("course-track")
  const dots  = document.querySelectorAll("#slick-dots li")

  const totalCourses = <%= courses.size %>
  const perPage = 3
  const slideWidth = 320
  const stepWidth = slideWidth * perPage
  const totalPages = Math.ceil(totalCourses / perPage)

  if (!track || totalCourses <= perPage) return

  let index = 1
  let interval = null
  const duration = 4000

  track.style.transform = `translateX(-${stepWidth}px)`

  function updateDots(page) {
    dots.forEach(d => d.classList.remove("slick-active"))
    dots[page].classList.add("slick-active")
  }

  function moveTo(i, animate = true) {
    track.style.transition = animate ? "transform 0.7s ease-in-out" : "none"
    track.style.transform = `translateX(-${i * stepWidth}px)`
  }

  function start() {
    interval = setInterval(() => {
      index++
      moveTo(index)

      if (index === totalPages + 1) {
        setTimeout(() => {
          index = 1
          moveTo(index, false)
        }, 700)
      }

      updateDots((index - 1) % totalPages)
    }, duration)
  }

  function stop() {
    clearInterval(interval)
    interval = null
  }

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      stop()
      index = i + 1
      moveTo(index)
      updateDots(i)
      start()
    })
  })

  track.addEventListener("mouseenter", stop)
  track.addEventListener("mouseleave", start)

  start()
})
</script>

<!-- ================= STYLE ================= -->
<style>
.slick-dots li button {
  background: #d1d5db;
}
.slick-dots li.slick-active button {
  background: #2563eb;
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const track = document.getElementById("teacher-track")
  if (!track) return

  const slideCount = <%= teachers.size %>
  if (slideCount <= 3) return

  let index = 3
  let interval = null
  const duration = 4500

  function moveTo(i, animate = true) {
    track.style.transition = animate ? "transform 0.7s ease-in-out" : "none"
    track.style.transform = `translateX(-${(i * 100) / 3}%)`
  }

  function start() {
    interval = setInterval(() => {
      index++
      moveTo(index)

      if (index === slideCount + 3) {
        setTimeout(() => {
          index = 3
          moveTo(index, false)
        }, 700)
      }
    }, duration)
  }

  function stop() {
    clearInterval(interval)
    interval = null
  }

  moveTo(index, false)
  start()

  track.addEventListener("mouseenter", stop)
  track.addEventListener("mouseleave", start)
})
</script>

<style>
  .slick-dots li button {
    background: #d1d5db;
  }
  .slick-dots li.slick-active button {
    background: #2563eb;
  }
  #teacher-track {
  will-change: transform;
}

</style>

<script>
function openPaymentModal(courseId, title, price) {
  console.log("OPEN MODAL", courseId)

  document.getElementById("modal-course-title").innerText = title
  document.getElementById("modal-course-price").innerText = price
  document.getElementById("modal-course-id").value = courseId

  const form = document.getElementById("payment-form")
  form.action = `/students/courses/${courseId}/orders`

  const modal = document.getElementById("payment-modal")
  modal.classList.remove("hidden")
  modal.classList.add("flex")
}

function closePaymentModal() {
  const modal = document.getElementById("payment-modal")
  modal.classList.add("hidden")
  modal.classList.remove("flex")
}
</script>

<script>
  document.querySelectorAll(".pay-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const courseId = btn.dataset.courseId
      document.getElementById("selected-course-id").value = courseId

      const form = document.getElementById("payment-form")
      form.action = `/students/courses/${courseId}/orders`
    })
  })
</script>
