<section class="container mx-auto px-6 py-16">

    <h1 class="text-3xl font-semibold text-gray-900">
      Popular Courses
    </h1>
  </div>

  <% courses = @courses.to_a %>
  <% if courses.any? %>

  <!-- SLIDER VIEWPORT -->
<div id="slider"
     class="relative overflow-hidden mx-auto"
     style="width: 320px">


    <!-- TRACK -->
    <div id="course-track"
         class="flex transition-transform duration-700 ease-in-out"
         style="will-change: transform">

      <% slides = [courses.last] + courses + [courses.first] %>

      <% slides.each do |course| %>
        <!-- SLIDE -->
        <div class="flex-shrink-0" style="width: 320px">

          <!-- CARD (Coursera-style) -->
          <div class="bg-white rounded-2xl shadow-sm
                      hover:shadow-lg transition-shadow
                      overflow-hidden">

            <!-- IMAGE -->
            <%= link_to students_course_path(course) do %>
              <% if course.thumbnail.attached? %>
                <%= image_tag course.thumbnail.variant(resize_to_fill: [320, 180]),
                    class: "w-full h-[180px] object-cover" %>
              <% else %>
                <div class="w-full h-[180px] bg-pink-50 flex items-center justify-center">
                  <span class="text-gray-400 text-sm">No image</span>
                </div>
              <% end %>
            <% end %>

            <!-- CONTENT -->
            <div class="p-5">

              <% if course.band_min.present? && course.band_max.present? %>
                <p class="text-xs font-semibold text-blue-600 mb-1">
                  IELTS <%= course.band_min %> – <%= course.band_max %>
                </p>
              <% end %>

              <h3 class="text-base font-semibold text-gray-900 line-clamp-2 mb-3">
                <%= course.title %>
              </h3>

              <div class="flex items-center justify-between">
                <span class="text-lg font-bold text-gray-900">
                  <%= number_to_currency(course.price, unit: "₫", precision: 0) %>
                </span>

                <%= link_to "View",
                  students_course_path(course),
                  class: "text-sm font-medium text-blue-600 hover:underline" %>
              </div>

            </div>
          </div>

        </div>
      <% end %>

    </div>
  </div>

  <!-- SLICK DOTS -->
  <ul id="slick-dots"
      class="slick-dots flex justify-center gap-3 mt-6 list-none">
    <% courses.each_with_index do |_, i| %>
      <li class="<%= 'slick-active' if i == 0 %>">
        <button class="w-3 h-3 rounded-full bg-gray-300"></button>
      </li>
    <% end %>
  </ul>
<% end %>
  <!-- ================= TEACHERS SECTION ================= -->
  </section>
<section class="container mx-auto px-6 py-20">

  <!-- Header -->
  <div class="mb-10">
    <h2 class="text-3xl font-semibold text-gray-900">
      Đội ngũ giáo viên
    </h2>
    <p class="text-gray-500 mt-2">
      Những giảng viên giàu kinh nghiệm, đồng hành cùng bạn
    </p>
  </div>

 <% teachers = @teacher_profiles.to_a %>
<% if teachers.any? %>

<!-- SLIDER VIEWPORT -->
<div id="teacher-slider"
     class="relative overflow-hidden mx-auto"
     style="max-width: 1200px">

  <!-- TRACK -->
  <div id="teacher-track"
       class="flex transition-transform duration-700 ease-in-out">

    <% slides = teachers.last(3) + teachers + teachers.first(3) %>

    <% slides.each do |teacher| %>

      <!-- CARD -->
      <div class="w-1/3 px-4 flex-shrink-0 text-center">

        <!-- AVATAR -->
        <% if teacher.avatar.attached? %>
          <%= image_tag teacher.avatar.variant(resize_to_fill: [120,120]),
            class: "w-28 h-28 mx-auto rounded-full object-cover mb-4" %>
        <% else %>
          <div class="w-28 h-28 mx-auto rounded-full bg-gray-200
                      flex items-center justify-center mb-4">
            <span class="text-gray-400 text-xs">No avatar</span>
          </div>
        <% end %>

        <!-- NAME -->
        <h3 class="text-lg font-semibold text-gray-900">
          <%= teacher.full_name.upcase %>
        </h3>

        <!-- EXPERTISE -->
        <p class="text-sm text-blue-600 font-medium mt-1">
          <%= teacher.expertise %>
        </p>

        <!-- EXPERIENCE -->
        <p class="text-sm text-gray-500 mt-1">
          <%= teacher.experience_years %> năm kinh nghiệm
        </p>

        <!-- BIO -->
        <p class="text-sm text-gray-600 mt-4 line-clamp-3">
          <%= teacher.bio %>
        </p>

      </div>

    <% end %>
  </div>
</div>


    </div>
  </div>
<% end %>
</section>
<!-- SLIDER SCRIPT -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const track = document.getElementById("course-track")
    const dots = document.querySelectorAll("#slick-dots li")
    const total = <%= courses.size %>
    const slideWidth = 320

    if (!track || total <= 1) return

    let index = 1
    let interval = null
    const duration = 4000

    track.style.transform = `translateX(-${slideWidth}px)`

    function updateDots(realIndex) {
      dots.forEach(d => d.classList.remove("slick-active"))
      dots[realIndex].classList.add("slick-active")
    }

    function moveTo(i, animate = true) {
      track.style.transition = animate ? "transform 0.7s ease-in-out" : "none"
      track.style.transform = `translateX(-${i * slideWidth}px)`
    }

    function start() {
      interval = setInterval(() => {
        index++
        moveTo(index)

        if (index === total + 1) {
          setTimeout(() => {
            index = 1
            moveTo(index, false)
          }, 700)
        }

        updateDots((index - 1) % total)
      }, duration)
    }

    function stop() {
      clearInterval(interval)
      interval = null
    }

    track.addEventListener("mouseenter", stop)
    track.addEventListener("mouseleave", start)

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        stop()
        index = i + 1
        moveTo(index)
        updateDots(i)
        start()
      })
    })

    start()
  })
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const track = document.getElementById("teacher-track")
  if (!track) return

  const slideCount = <%= teachers.size %>
  if (slideCount <= 3) return

  let index = 3
  let interval = null
  const duration = 4500

  function moveTo(i, animate = true) {
    track.style.transition = animate ? "transform 0.7s ease-in-out" : "none"
    track.style.transform = `translateX(-${(i * 100) / 3}%)`
  }

  function start() {
    interval = setInterval(() => {
      index++
      moveTo(index)

      if (index === slideCount + 3) {
        setTimeout(() => {
          index = 3
          moveTo(index, false)
        }, 700)
      }
    }, duration)
  }

  function stop() {
    clearInterval(interval)
    interval = null
  }

  moveTo(index, false)
  start()

  track.addEventListener("mouseenter", stop)
  track.addEventListener("mouseleave", start)
})
</script>

<style>
  .slick-dots li button {
    background: #d1d5db;
  }
  .slick-dots li.slick-active button {
    background: #2563eb;
  }
  #teacher-track {
  will-change: transform;
}

</style>
