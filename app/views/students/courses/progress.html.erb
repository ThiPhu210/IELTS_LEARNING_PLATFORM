<%# ============================================================
    app/views/students/courses/progress.html.erb
    Route:  GET /students/courses/progress
    Action: Students::CoursesController#progress
    ============================================================ %>

<%# ── Ruby helpers (precomputed in controller) ── %>
<%#
  @all_attempts      – SpeakingAttempt[]  (all user's attempts, ordered by created_at)
  @paid_courses      – Course[]           (courses the student has access to)
  @attempts_by_course – Hash { course_id => [attempts] }
  @overall_stats     – { total:, avg_band:, best_band:, latest_band:, total_courses: }
%>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Speaking Progress – <%= current_user.full_name %></title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
  <style>
    /* ═══════════════════════════════════════════
       DESIGN SYSTEM
    ═══════════════════════════════════════════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink:       #0d0e14;
      --ink-2:     #3a3d52;
      --ink-3:     #7b7f96;
      --line:      #e8eaf2;
      --bg:        #f2f4f9;
      --surface:   #ffffff;
      --surface-2: #f7f8fc;

      --indigo:    #4f46e5;
      --indigo-lt: #eeeeff;
      --indigo-glow: rgba(79,70,229,.18);
      --teal:      #0d9488;
      --teal-lt:   #e6faf8;
      --amber:     #d97706;
      --amber-lt:  #fef3e1;
      --rose:      #e11d48;
      --rose-lt:   #fce7ef;
      --emerald:   #059669;
      --emerald-lt:#e6f7f1;

      --r-sm: 10px;
      --r-md: 16px;
      --r-lg: 22px;
      --r-xl: 28px;

      --shadow-xs: 0 1px 3px rgba(0,0,0,.06);
      --shadow-sm: 0 2px 10px rgba(0,0,0,.07);
      --shadow-md: 0 6px 24px rgba(0,0,0,.09);
      --shadow-lg: 0 16px 48px rgba(0,0,0,.12);

      --font: 'Plus Jakarta Sans', sans-serif;
      --font-serif: 'Instrument Serif', serif;

      --ease: cubic-bezier(.4,0,.2,1);
    }

    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--ink);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* ═══════════════════════════════════════════
       PAGE WRAPPER
    ═══════════════════════════════════════════ */
    .page {
      max-width: 1160px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }

    /* ═══════════════════════════════════════════
       PAGE HEADER
    ═══════════════════════════════════════════ */
    .page-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 44px;
      flex-wrap: wrap;
    }
    .page-header-left { }
    .page-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--indigo);
      background: var(--indigo-lt);
      padding: 5px 13px;
      border-radius: 30px;
      margin-bottom: 12px;
    }
    .page-title {
      font-family: var(--font-serif);
      font-size: clamp(30px, 4vw, 44px);
      font-weight: 400;
      line-height: 1.15;
      color: var(--ink);
      letter-spacing: -.02em;
    }
    .page-title em { font-style: italic; color: var(--indigo); }
    .page-sub {
      margin-top: 8px;
      font-size: 15px;
      color: var(--ink-3);
    }
    .page-sub strong { color: var(--ink-2); font-weight: 600; }

    /* ═══════════════════════════════════════════
       HERO STATS ROW
    ═══════════════════════════════════════════ */
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 44px;
    }

    .stat-tile {
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: var(--r-lg);
      padding: 22px 20px 18px;
      box-shadow: var(--shadow-xs);
      position: relative;
      overflow: hidden;
      transition: transform .2s var(--ease), box-shadow .2s var(--ease);
      animation: fadeUp .5s var(--ease) both;
    }
    .stat-tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
    .stat-tile::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--tile-accent, var(--indigo-lt));
      opacity: .5;
      pointer-events: none;
      border-radius: inherit;
    }
    .stat-tile:nth-child(1) { --tile-accent: var(--indigo-lt); animation-delay:.05s; }
    .stat-tile:nth-child(2) { --tile-accent: var(--teal-lt);   animation-delay:.10s; }
    .stat-tile:nth-child(3) { --tile-accent: var(--amber-lt);  animation-delay:.15s; }
    .stat-tile:nth-child(4) { --tile-accent: var(--emerald-lt);animation-delay:.20s; }

    .stat-tile-label {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin-bottom: 10px;
      position: relative;
    }
    .stat-tile-value {
      font-family: var(--font-serif);
      font-size: 46px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: -.02em;
      position: relative;
    }
    .stat-tile:nth-child(1) .stat-tile-value { color: var(--indigo); }
    .stat-tile:nth-child(2) .stat-tile-value { color: var(--teal); }
    .stat-tile:nth-child(3) .stat-tile-value { color: var(--amber); }
    .stat-tile:nth-child(4) .stat-tile-value { color: var(--emerald); }

    .stat-tile-sub {
      font-size: 12px;
      color: var(--ink-3);
      margin-top: 6px;
      position: relative;
    }

    /* ═══════════════════════════════════════════
       CHARTS SECTION
    ═══════════════════════════════════════════ */
    .charts-row {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 20px;
      margin-bottom: 48px;
    }

    .chart-panel {
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: var(--r-lg);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      animation: fadeUp .55s var(--ease) .25s both;
    }
    .chart-panel-title {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin-bottom: 20px;
    }
    .chart-canvas-wrap {
      position: relative;
      height: 260px;
    }

    /* ═══════════════════════════════════════════
       SECTION DIVIDER
    ═══════════════════════════════════════════ */
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .section-title {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 400;
      letter-spacing: -.01em;
    }
    .section-desc {
      font-size: 13px;
      color: var(--ink-3);
      margin-top: 2px;
    }

    /* ═══════════════════════════════════════════
       COURSE CARDS LIST
    ═══════════════════════════════════════════ */
    .courses-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .course-row {
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: var(--r-lg);
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: all .22s var(--ease);
      position: relative;
      animation: fadeUp .5s var(--ease) both;
      text-decoration: none;
      color: inherit;
    }
    .course-row:hover {
      border-color: var(--indigo);
      box-shadow: var(--shadow-md), 0 0 0 4px var(--indigo-glow);
      transform: translateX(4px);
    }

    .course-row-thumb {
      width: 58px;
      height: 58px;
      border-radius: var(--r-sm);
      object-fit: cover;
      flex-shrink: 0;
      background: var(--indigo-lt);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-serif);
      font-size: 22px;
      color: var(--indigo);
      font-style: italic;
      overflow: hidden;
    }
    .course-row-thumb img { width: 100%; height: 100%; object-fit: cover; }

    .course-row-info { flex: 1; min-width: 0; }
    .course-row-title {
      font-weight: 700;
      font-size: 15.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--ink);
    }
    .course-row-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 6px;
      flex-wrap: wrap;
    }
    .meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
    }
    .chip-attempts { background: var(--indigo-lt); color: var(--indigo); }
    .chip-best     { background: var(--amber-lt);  color: var(--amber); }
    .chip-avg      { background: var(--teal-lt);   color: var(--teal); }
    .chip-none     { background: var(--surface-2); color: var(--ink-3); }

    /* Mini band bar */
    .band-bar {
      flex-shrink: 0;
      width: 120px;
    }
    .band-bar-track {
      height: 6px;
      background: var(--line);
      border-radius: 3px;
      overflow: hidden;
      margin-bottom: 4px;
    }
    .band-bar-fill {
      height: 100%;
      border-radius: 3px;
      background: linear-gradient(90deg, var(--indigo), #818cf8);
      transition: width 1s var(--ease);
    }
    .band-bar-label {
      font-size: 11px;
      color: var(--ink-3);
      text-align: right;
    }

    /* Arrow */
    .course-row-arrow {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--bg);
      border: 1.5px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ink-3);
      flex-shrink: 0;
      transition: all .2s var(--ease);
    }
    .course-row:hover .course-row-arrow {
      background: var(--indigo);
      border-color: var(--indigo);
      color: #fff;
      transform: translateX(3px);
    }

    /* No attempts state */
    .no-attempts-badge {
      font-size: 12px;
      color: var(--ink-3);
      background: var(--surface-2);
      border: 1px dashed var(--line);
      padding: 3px 10px;
      border-radius: 20px;
    }

    /* ═══════════════════════════════════════════
       EMPTY STATE
    ═══════════════════════════════════════════ */
    .empty-state {
      text-align: center;
      padding: 72px 24px;
      background: var(--surface);
      border: 1.5px dashed var(--line);
      border-radius: var(--r-xl);
    }
    .empty-state-icon { font-size: 52px; margin-bottom: 16px; }
    .empty-state h3 {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 400;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .empty-state p { font-size: 14px; color: var(--ink-3); }

    /* ═══════════════════════════════════════════
       ANIMATIONS
    ═══════════════════════════════════════════ */
    @keyframes fadeUp {
      from { opacity:0; transform: translateY(14px); }
      to   { opacity:1; transform: none; }
    }

    /* ═══════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════ */
    @media (max-width: 900px) {
      .hero-stats   { grid-template-columns: repeat(2,1fr); }
      .charts-row   { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .page         { padding: 28px 14px 60px; }
      .hero-stats   { grid-template-columns: repeat(2,1fr); gap: 12px; }
      .stat-tile-value { font-size: 36px; }
      .course-row   { flex-wrap: wrap; }
      .band-bar     { width: 100%; }
      .page-header  { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>
<div class="page">

  <!-- ═══════════ PAGE HEADER ═══════════ -->
  <div class="page-header">
    <div class="page-header-left">
      <div class="page-eyebrow">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/><path d="M12 8v4l3 3"/></svg>
        Speaking Analytics
      </div>
      <h1 class="page-title">Tiến độ <em>luyện nói</em><br>của bạn</h1>
      <p class="page-sub">Xin chào, <strong><%= current_user.full_name %></strong> — đây là tổng quan toàn bộ hành trình luyện speaking.</p>
    </div>
  </div>

  <!-- ═══════════ HERO STATS ═══════════ -->
  <%
    all_attempts    = @all_attempts
    total_attempts  = all_attempts.size
    valid_bands     = all_attempts.map(&:overall_band).compact.map(&:to_f)
    avg_band        = valid_bands.any? ? (valid_bands.sum / valid_bands.size).round(2) : 0
    best_band       = valid_bands.any? ? valid_bands.max : 0
    latest_band     = all_attempts.reverse.find { |a| a.overall_band.present? }&.overall_band.to_f || 0
  %>
  <div class="hero-stats">
    <div class="stat-tile">
      <div class="stat-tile-label">Tổng lần luyện tập</div>
      <div class="stat-tile-value"><%= total_attempts %></div>
      <div class="stat-tile-sub">Trên <%= @paid_courses.size %> khóa học</div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-label">Band trung bình</div>
      <div class="stat-tile-value"><%= avg_band %></div>
      <div class="stat-tile-sub">IELTS Speaking Scale</div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-label">Band cao nhất</div>
      <div class="stat-tile-value"><%= best_band %></div>
      <div class="stat-tile-sub">Kết quả tốt nhất</div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-label">Band gần nhất</div>
      <div class="stat-tile-value"><%= latest_band %></div>
      <div class="stat-tile-sub">
        <% prev = all_attempts.reverse_each.drop(1).find { |a| a.overall_band.present? } %>
        <% if prev && latest_band > 0 %>
          <% diff = (latest_band - prev.overall_band.to_f).round(1) %>
          <% if diff > 0 %>↑ +<%= diff %> so với lần trước<% elsif diff < 0 %>↓ <%= diff %> so với lần trước<% else %>= Giữ nguyên<% end %>
        <% else %>
          Lần luyện tập đầu
        <% end %>
      </div>
    </div>
  </div>

  <!-- ═══════════ CHARTS ═══════════ -->
  <% if total_attempts > 0 %>
  <div class="charts-row">
    <!-- Line chart: all attempts over time -->
    <div class="chart-panel">
      <div class="chart-panel-title">📈 Xu hướng Band Score – Tất cả khóa học</div>
      <div class="chart-canvas-wrap">
        <canvas id="overallLineChart"></canvas>
      </div>
    </div>

    <!-- Radar: skill breakdown average -->
    <div class="chart-panel">
      <div class="chart-panel-title">🕸 Kỹ năng trung bình</div>
      <div class="chart-canvas-wrap">
        <canvas id="overallRadarChart"></canvas>
      </div>
    </div>
  </div>
  <% end %>

  <!-- ═══════════ COURSES LIST ═══════════ -->
  <div class="section-head">
    <div>
      <div class="section-title">Khóa học của bạn</div>
      <div class="section-desc">Click vào khóa học để xem thống kê chi tiết</div>
    </div>
  </div>

  <% if @paid_courses.any? %>
  <div class="courses-list">
    <% @paid_courses.each_with_index do |course, i| %>
      <% course_attempts = @attempts_by_course[course.id] || [] %>
      <% c_total = course_attempts.size %>
      <% c_avg   = c_total > 0 ? (course_attempts.sum(&:overall_band).to_f / c_total).round(1) : nil %>
      <% c_best  = c_total > 0 ? course_attempts.map(&:overall_band).max : nil %>
      <% c_pct   = c_best ? (c_best / 9.0 * 100).round : 0 %>

      <a href="<%= dashboard_students_course_path(course) %>"
         class="course-row"
         style="animation-delay: <%= 0.05 + i * 0.06 %>s">

        <!-- Thumb -->
        <div class="course-row-thumb">
          <% if course.respond_to?(:thumbnail) && course.thumbnail.present? %>
            <img src="<%= course.thumbnail %>" alt="">
          <% else %>
            <%= course.title[0].upcase %>
          <% end %>
        </div>

        <!-- Info -->
        <div class="course-row-info">
          <div class="course-row-title"><%= course.title %></div>
          <div class="course-row-meta">
            <% if c_total > 0 %>
              <span class="meta-chip chip-attempts">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <%= c_total %> lần luyện
              </span>
              <span class="meta-chip chip-avg">Avg <%= c_avg %></span>
              <span class="meta-chip chip-best">Best <%= c_best %></span>
            <% else %>
              <span class="no-attempts-badge">Chưa có lần luyện nào</span>
            <% end %>
          </div>
        </div>

        <!-- Mini band progress bar -->
        <% if c_total > 0 %>
        <div class="band-bar">
          <div class="band-bar-track">
            <div class="band-bar-fill" data-width="<%= c_pct %>"></div>
          </div>
          <div class="band-bar-label">Band <%= c_best %> / 9.0</div>
        </div>
        <% end %>

        <!-- Arrow -->
        <div class="course-row-arrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
      </a>
    <% end %>
  </div>

  <% else %>
  <div class="empty-state">
    <div class="empty-state-icon">🎤</div>
    <h3>Chưa có khóa học nào</h3>
    <p>Hãy đăng ký khóa học để bắt đầu hành trình luyện speaking!</p>
  </div>
  <% end %>

</div><%# end .page %>

<script>
/* ─── Data from Rails ─── */
const allAttempts = <%= raw @all_attempts.to_json %>;

if (allAttempts.length > 0) {

  /* ─── Line Chart: overall band over time ─── */
  new Chart(document.getElementById('overallLineChart'), {
    type: 'line',
    data: {
      labels: allAttempts.map(a => {
        const d = new Date(a.created_at);
        return d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit' });
      }),
      datasets: [{
        label: 'Band Score',
        data: allAttempts.map(a => a.overall_band),
        borderColor: '#4f46e5',
        backgroundColor: 'rgba(79,70,229,.10)',
        pointBackgroundColor: '#4f46e5',
        pointRadius: 5,
        pointHoverRadius: 7,
        fill: true,
        tension: 0.35,
        borderWidth: 2.5
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            title: (items) => {
              const a = allAttempts[items[0].dataIndex];
              return new Date(a.created_at).toLocaleDateString('vi-VN');
            },
            label: (item) => `Band ${item.raw}`
          }
        }
      },
      scales: {
        y: {
          min: 0, max: 9,
          ticks: { stepSize: 1, color: '#7b7f96', font: { size: 11 } },
          grid: { color: '#e8eaf2' }
        },
        x: {
          ticks: { color: '#7b7f96', font: { size: 10 }, maxTicksLimit: 10 },
          grid: { display: false }
        }
      }
    }
  });

  /* ─── Radar Chart: skill averages ─── */
  const n = allAttempts.length;
  const avg = (key) => allAttempts.reduce((s,a)=>s+(a[key]||0),0)/n;

  new Chart(document.getElementById('overallRadarChart'), {
    type: 'radar',
    data: {
      labels: ['Fluency', 'Lexical', 'Grammar', 'Pronunciation'],
      datasets: [{
        label: 'Trung bình',
        data: [
          +avg('fluency_score').toFixed(2),
          +avg('lexical_score').toFixed(2),
          +avg('grammar_score').toFixed(2),
          +avg('pronunciation_score').toFixed(2)
        ],
        backgroundColor: 'rgba(13,148,136,.15)',
        borderColor: '#0d9488',
        pointBackgroundColor: '#0d9488',
        pointRadius: 4,
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        r: {
          min: 0, max: 9,
          ticks: { stepSize: 1, color: '#7b7f96', font: { size: 10 }, backdropColor: 'transparent' },
          grid: { color: '#e8eaf2' },
          pointLabels: { font: { size: 12, weight: '600' }, color: '#3a3d52' }
        }
      }
    }
  });
}

/* ─── Animate band-bar fills on load ─── */
document.querySelectorAll('.band-bar-fill').forEach(el => {
  const w = el.dataset.width;
  el.style.width = '0%';
  requestAnimationFrame(() => {
    setTimeout(() => { el.style.width = w + '%'; }, 200);
  });
});
</script>
</body>
</html>
