 <%= render "students/shared/navbar" %>
<!-- SEARCH BAR -->
<div class="pt-28">
<div class="flex justify-center mb-10">

<%= form_with url: students_courses_path,
              method: :get,
              local: true,
              class: "flex items-center max-w-sm mx-auto space-x-2" do %>

    <%= hidden_field_tag :paid, params[:paid] %>

    <label for="simple-search" class="sr-only">Search</label>

    <div class="relative w-full">

        <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
            <svg class="w-4 h-4 text-body" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8 8v8m0-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm0 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm8-8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm0 0a4 4 0 0 1-4 4h-1a3 3 0 0 0-3 3"/>
            </svg>
        </div>

        <%= text_field_tag :q,
              params[:q],
              id: "simple-search",
              class: "px-3 py-2.5 bg-neutral-secondary-medium border border-default-medium rounded-full ps-9 text-heading text-sm focus:ring-brand focus:border-brand block w-full placeholder:text-body",
              placeholder: "Search branch name..." %>

    </div>

    <button type="submit"
        class="inline-flex items-center justify-center shrink-0 text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:ring-brand-medium shadow-xs rounded-full w-10 h-10 focus:outline-none">

        <svg class="w-5 h-5"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24">
          <path stroke="currentColor"
                stroke-linecap="round"
                stroke-width="2"
                d="m21 21-3.5-3.5M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"/>
        </svg>

        <span class="sr-only">Icon description</span>

    </button>

<% end %>

</div>


<section class="container mx-auto px-6 py-16 mt-10 mb-10">

  <!-- TITLE -->
  <h1 class="text-3xl font-bold text-gray-900 mb-2">
    <%= params[:paid] == "true" ? "Khóa học của tôi" : "Tất cả khóa học" %>
  </h1>

  <% if params[:paid] == "true" %>
    <% if @courses.any? %>
      <p class="text-gray-600 mb-10">
        Bạn đã mua
        <span class="font-semibold text-gray-900">
          <%= @courses.size %>
        </span>
        khóa học
      </p>
    <% end %>
  <% end %>

  <% if @courses.empty? %>

    <div class="p-6 bg-yellow-50 border border-yellow-200 rounded-2xl">
      <p class="text-yellow-700 font-medium">
        Không tìm thấy khóa học phù hợp.
      </p>
    </div>

  <% else %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

    <% @courses.each do |course| %>

      <div class="bg-white border border-gray-200
                  rounded-2xl overflow-hidden
                  shadow-sm hover:shadow-xl
                  hover:-translate-y-1
                  transition-all duration-300">

        <%= link_to students_course_path(course) do %>

          <% if course.thumbnail.attached? %>
            <%= image_tag course.thumbnail.variant(resize_to_fill: [400, 220]),
                class: "w-full h-[220px] object-cover" %>
          <% else %>
            <div class="w-full h-[220px]
                        bg-pink-50 flex items-center justify-center">
              <span class="text-gray-400 text-sm">
                No image
              </span>
            </div>
          <% end %>

        <% end %>

        <div class="p-5">

          <% if course.band_min.present? && course.band_max.present? %>
            <p class="text-xs font-semibold text-blue-600 mb-1">
              IELTS <%= course.band_min %> – <%= course.band_max %>
            </p>
          <% end %>

          <h3 class="text-base font-semibold text-gray-900
                     line-clamp-2 mb-4">
            <%= course.title %>
          </h3>

          <div class="flex items-center justify-between">

            <span class="text-lg font-bold text-gray-900">
              <%= number_to_currency(course.price,
                    unit: "₫", precision: 0) %>
            </span>

            <% if @paid_course_ids.include?(course.id) %>

              <%= link_to "Xem",
                  students_course_path(course),
                  class: "px-4 py-2 text-sm font-semibold
                          bg-gray-900 text-white
                          rounded-xl hover:bg-black
                          transition" %>

            <% else %>

              <%= button_to "Thanh toán",
                  students_course_orders_path(course),
                  method: :post,
                  class: "px-4 py-2 text-sm font-semibold
                          bg-green-600 text-white
                          rounded-xl hover:bg-green-700
                          transition" %>

            <% end %>

          </div>

        </div>

      </div>

    <% end %>

  </div>

  <% end %>

  <div class="mt-12 flex justify-center">
    <%= paginate @courses %>
  </div>

</section>
</div>
<style> nav.pagination { display: flex; gap: 0.5rem; } nav.pagination a, nav.pagination span { padding: 0.5rem 0.75rem; border-radius: 0.375rem; } nav.pagination .current { background: #FF1C04; color: white; } </style>
