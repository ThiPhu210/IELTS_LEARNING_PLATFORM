<%# ============================================================
    app/views/students/courses/dashboard.html.erb
    Route: GET /students/courses/:id/dashboard
    Design: synced with progress.html.erb (light theme)
    ============================================================ %>
<%= render "students/shared/navbar" %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
/* ═══════════════════════════════════════════
   DESIGN TOKENS — identical to progress.html.erb
═══════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --ink:         #0d0e14;
  --ink-2:       #3a3d52;
  --ink-3:       #7b7f96;
  --line:        #e8eaf2;
  --bg:          #f2f4f9;
  --surface:     #ffffff;
  --surface-2:   #f7f8fc;

  /* 🔴 RED SYSTEM */
  --primary:      #dc2626;
  --primary-lt:   #fee2e2;
  --primary-glow: rgba(220,38,38,.18);

  --teal:        #0d9488;
  --teal-lt:     #e6faf8;
  --amber:       #d97706;
  --amber-lt:    #fef3e1;
  --rose:        #e11d48;
  --rose-lt:     #fce7ef;
  --emerald:     #059669;
  --emerald-lt:  #e6f7f1;

  --r-sm:  10px;
  --r-md:  16px;
  --r-lg:  22px;
  --r-xl:  28px;

  --shadow-xs: 0 1px 3px rgba(0,0,0,.06);
  --shadow-sm: 0 2px 10px rgba(0,0,0,.07);
  --shadow-md: 0 6px 24px rgba(0,0,0,.09);

  --font:       'Plus Jakarta Sans', sans-serif;
  --font-serif: 'Instrument Serif', serif;
  --ease:       cubic-bezier(.4,0,.2,1);
}
}

html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--ink);
  line-height: 1.6;
}

.page {
  max-width: 1160px;
  margin: 0 auto;
  padding: 48px 24px 100px;
}

/* ── Header ── */
.page-header { margin-bottom: 44px; animation: fadeUp .4s var(--ease) both; }
.page-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  color: var(--primary); background: var(--primary-lt);
  padding: 5px 13px; border-radius: 30px; margin-bottom: 12px;
}
.page-title {
  font-family: var(--font-serif); font-size: clamp(26px, 3.5vw, 40px);
  font-weight: 400; line-height: 1.15; color: var(--ink);
  letter-spacing: -.02em; margin-bottom: 6px;
}
.page-title em { font-style: italic; color: var(--primary); }
.page-sub { font-size: 14px; color: var(--ink-3); margin-bottom: 22px; }

/* ── Dual arrow nav ── */
.dual-nav {
  display: grid; grid-template-columns: 1fr 1fr;
  border: 1.5px solid var(--line); border-radius: var(--r-lg);
  overflow: hidden; box-shadow: var(--shadow-xs);
}
.nav-arrow {
  display: flex; text-decoration: none;
  background: var(--surface); transition: background .2s var(--ease);
  position: relative;
}
.nav-arrow:first-child { border-right: 1.5px solid var(--line); }
.nav-arrow:hover { background: var(--primary-lt); }
.nav-arrow:hover .nav-arrow-track { opacity: 1; }
.nav-arrow:hover .nav-arrow-label { color: var(--primary); }

.nav-arrow-inner {
  display: flex; align-items: center; width: 100%;
  padding: 15px 20px; gap: 12px;
}
.nav-arrow:last-child .nav-arrow-inner { flex-direction: row-reverse; }

/* Long arrow track */
.nav-arrow-track {
  flex: 1; display: flex; align-items: center;
  opacity: .35; transition: opacity .25s var(--ease);
  overflow: hidden; min-width: 0;
}
.nav-arrow-line {
  flex: 1; height: 1.5px; background: var(--primary); min-width: 10px;
}
.nav-arrow-head { color: var(--primary); display: flex; align-items: center; flex-shrink: 0; }

/* Text */
.nav-arrow-text { flex-shrink: 0; }
.nav-arrow-label {
  display: block; font-size: 13px; font-weight: 700;
  color: var(--ink-2); transition: color .2s var(--ease); white-space: nowrap;
}
.nav-arrow-hint {
  display: block; font-size: 11px; color: var(--ink-3); margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px;
}

@media (max-width: 560px) {
  .dual-nav { grid-template-columns: 1fr; }
  .nav-arrow:first-child { border-right: none; border-bottom: 1.5px solid var(--line); }
  .nav-arrow-hint { display: none; }
}

/* ── Hero Stats (same as progress) ── */
.hero-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 40px;
}
.stat-tile {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--r-lg);
  padding: 22px 20px 18px;
  box-shadow: var(--shadow-xs);
  position: relative;
  overflow: hidden;
  transition: transform .2s var(--ease), box-shadow .2s var(--ease);
  animation: fadeUp .5s var(--ease) both;
}
.stat-tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.stat-tile::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--tile-accent, var(--primary-lt));
  opacity: .45;
  pointer-events: none;
  border-radius: inherit;
}
.stat-tile:nth-child(1) { --tile-accent: var(--primary-lt); animation-delay:.05s; }
.stat-tile:nth-child(2) { --tile-accent: var(--teal-lt);   animation-delay:.10s; }
.stat-tile:nth-child(3) { --tile-accent: var(--amber-lt);  animation-delay:.15s; }
.stat-tile:nth-child(4) { --tile-accent: var(--emerald-lt);animation-delay:.20s; }
.stat-tile-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 10px;
  position: relative;
}
.stat-tile-value {
  font-family: var(--font-serif);
  font-size: 46px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: -.02em;
  position: relative;
}
.stat-tile:nth-child(1) .stat-tile-value { color: var(--primary); }
.stat-tile:nth-child(2) .stat-tile-value { color: var(--teal); }
.stat-tile:nth-child(3) .stat-tile-value { color: var(--amber); }
.stat-tile:nth-child(4) .stat-tile-value { color: var(--emerald); }
.stat-tile-sub { font-size: 12px; color: var(--ink-3); margin-top: 6px; position: relative; }

/* ── Charts (same as progress) ── */
.charts-row {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 20px;
  margin-bottom: 44px;
}
.chart-panel {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--r-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  animation: fadeUp .55s var(--ease) .25s both;
}
.chart-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.chart-panel-title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--ink-3);
}
.chart-trend-badge {
  font-size: 12px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 20px;
  background: var(--surface-2);
  border: 1.5px solid var(--line);
}
.chart-canvas-wrap { position: relative; height: 260px; }

/* ── Section head ── */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  animation: fadeUp .5s var(--ease) .35s both;
}
.section-title {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: 400;
  letter-spacing: -.01em;
  color: var(--ink);
}
.section-count {
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-3);
  background: var(--surface);
  border: 1.5px solid var(--line);
  padding: 5px 14px;
  border-radius: 20px;
  box-shadow: var(--shadow-xs);
}

/* ── Attempt Cards ── */
.attempt-card {
  background: var(--surface);
  border: 1.5px solid var(--line);
  border-radius: var(--r-xl);
  margin-bottom: 14px;
  overflow: hidden;
  box-shadow: var(--shadow-xs);
  transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  animation: fadeUp .4s var(--ease) both;
}
.attempt-card:hover { border-color: #c7d2fe; box-shadow: var(--shadow-sm); }

.attempt-top {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 22px;
  cursor: pointer;
  user-select: none;
}
.attempt-index { font-size: 12px; font-weight: 700; color: var(--ink-3); min-width: 26px; }
.attempt-meta { flex: 1; min-width: 0; }
.attempt-date { font-size: 14px; font-weight: 700; color: var(--ink); }
.attempt-part { font-size: 12px; color: var(--ink-3); margin-top: 2px; }

.attempt-subscores { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
.subscore { text-align: center; }
.subscore-val { font-size: 13px; font-weight: 700; color: var(--ink-2); line-height: 1; }
.subscore-label { font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); margin-top: 2px; }

.band-badge {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  width: 56px; height: 56px;
  border-radius: var(--r-md);
  background: var(--primary);
  box-shadow: 0 4px 14px var(--primary-glow);
  flex-shrink: 0;
}
.band-badge-val { font-family: var(--font-serif); font-size: 22px; color: #fff; line-height: 1; }
.band-badge-label { font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.7); margin-top: 1px; }

.attempt-toggle {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--surface-2); border: 1.5px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  color: var(--ink-3); transition: all .2s var(--ease); flex-shrink: 0;
}
.attempt-card.open .attempt-toggle {
  background: var(--primary-lt); border-color: var(--primary);
  color: var(--primary); transform: rotate(180deg);
}

.attempt-body {
  display: none;
  border-top: 1.5px solid var(--line);
  padding: 20px 22px 22px;
  animation: slideDown .22s var(--ease);
}
.attempt-card.open .attempt-body { display: block; }
@keyframes slideDown { from { opacity:0; transform:translateY(-6px); } to { opacity:1; transform:none; } }

.score-chips { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
.score-chip {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  padding: 10px 20px; border-radius: var(--r-md);
  border: 1.5px solid var(--line); background: var(--surface-2); min-width: 90px;
}
.score-chip-val { font-family: var(--font-serif); font-size: 26px; line-height: 1; }
.score-chip-label { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }
.chip-fluency .score-chip-val { color: var(--primary); }
.chip-lexical .score-chip-val { color: var(--teal); }
.chip-grammar .score-chip-val { color: var(--amber); }
.chip-pron    .score-chip-val { color: var(--rose); }

.content-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.content-block { border-radius: var(--r-md); padding: 14px 16px; border: 1.5px solid var(--line); }
.content-block.full { grid-column: 1 / -1; }
.cb-label { display: flex; align-items: center; gap: 7px; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 9px; }
.cb-dot { width: 6px; height: 6px; border-radius: 50%; }
.cb-body { font-size: 13.5px; line-height: 1.65; color: var(--ink-2); }
.cb-body ul { list-style: none; padding: 0; }
.cb-body ul li { padding: 3px 0 3px 16px; position: relative; font-size: 13.5px; color: var(--ink-2); }
.cb-body ul li::before { content: '→'; position: absolute; left: 0; color: var(--ink-3); font-size: 11px; top: 5px; }

.block-transcript   { background: var(--surface-2); }
.block-transcript   .cb-label { color: var(--ink-3); } .block-transcript   .cb-dot { background: var(--ink-3); }
.block-feedback     { background: var(--primary-lt); border-color: #c7d2fe; }
.block-feedback     .cb-label { color: var(--primary); } .block-feedback     .cb-dot { background: var(--primary); }
.block-strengths    { background: var(--emerald-lt); border-color: #a7f3d0; }
.block-strengths    .cb-label { color: var(--emerald); } .block-strengths    .cb-dot { background: var(--emerald); }
.block-improvements { background: var(--amber-lt); border-color: #fcd34d; }
.block-improvements .cb-label { color: var(--amber); } .block-improvements .cb-dot { background: var(--amber); }
.block-correction   { background: var(--teal-lt); border-color: #99f6e4; }
.block-correction   .cb-label { color: var(--teal); } .block-correction   .cb-dot { background: var(--teal); }

/* ── Empty state ── */
.empty-state { text-align: center; padding: 72px 24px; background: var(--surface); border: 1.5px dashed var(--line); border-radius: var(--r-xl); }
.empty-state-icon { font-size: 52px; margin-bottom: 16px; }
.empty-state h3 { font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: var(--ink); margin-bottom: 8px; }
.empty-state p { font-size: 14px; color: var(--ink-3); }

@keyframes fadeUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }

@media (max-width: 900px) {
  .hero-stats { grid-template-columns: repeat(2,1fr); }
  .charts-row { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .page { padding: 24px 14px 80px; }
  .hero-stats { grid-template-columns: repeat(2,1fr); gap: 10px; }
  .stat-tile-value { font-size: 36px; }
  .attempt-subscores { display: none; }
  .content-grid { grid-template-columns: 1fr; }
  .content-block.full { grid-column: 1; }
}
</style>

<div class="page">

  <!-- ── Header ── -->
  <div class="page-header">
    <div class="page-eyebrow">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/><path d="M12 8v4l3 3"/></svg>
      Speaking Progress
    </div>
    <h1 class="page-title"><em><%= @course.title %></em></h1>
    <p class="page-sub">Theo dõi chi tiết tiến độ luyện nói của bạn trong khóa học này</p>

    <div class="dual-nav">
      <a href="<%= progress_students_courses_path %>" class="nav-arrow">
        <div class="nav-arrow-inner">
          <div class="nav-arrow-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </div>
          <div class="nav-arrow-track"><div class="nav-arrow-line"></div></div>
          <div class="nav-arrow-text">
            <span class="nav-arrow-label">Back to Course Progress</span>
            <span class="nav-arrow-hint">Tổng quan tất cả khóa học</span>
          </div>
        </div>
      </a>
      <a href="<%= students_course_path(@course) %>" class="nav-arrow">
        <div class="nav-arrow-inner">
          <div class="nav-arrow-text">
            <span class="nav-arrow-label">Back to this Course</span>
            <span class="nav-arrow-hint"><%= @course.title %></span>
          </div>
          <div class="nav-arrow-track"><div class="nav-arrow-line"></div></div>
          <div class="nav-arrow-head">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- ── Hero Stats ── -->
  <%
    valid_bands     = @attempts.map(&:overall_band).compact.map(&:to_f)
    total_att       = @attempts.size
    avg_band_val    = valid_bands.any? ? (valid_bands.sum / valid_bands.size).round(2) : 0
    best_band_val   = valid_bands.any? ? valid_bands.max : 0
    latest_band_val = @attempts.to_a.reverse.find { |a| a.overall_band.present? }&.overall_band.to_f || 0
  %>
  <div class="hero-stats">
    <div class="stat-tile">
      <div class="stat-tile-label">Tổng lần luyện</div>
      <div class="stat-tile-value"><%= total_att %></div>
      <div class="stat-tile-sub">lần thực hành</div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-label">Band trung bình</div>
      <div class="stat-tile-value"><%= avg_band_val %></div>
      <div class="stat-tile-sub">IELTS Speaking Scale</div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-label">Band cao nhất</div>
      <div class="stat-tile-value"><%= best_band_val %></div>
      <div class="stat-tile-sub">Kết quả tốt nhất</div>
    </div>
    <div class="stat-tile">
      <div class="stat-tile-label">Band gần nhất</div>
      <div class="stat-tile-value"><%= latest_band_val %></div>
      <div class="stat-tile-sub">
        <% prev_att = @attempts.to_a.reverse.select { |a| a.overall_band.present? }.drop(1).first %>
        <% if prev_att && latest_band_val > 0 %>
          <% diff = (latest_band_val - prev_att.overall_band.to_f).round(1) %>
          <% if diff > 0 %>↑ +<%= diff %> so với trước<% elsif diff < 0 %>↓ <%= diff %> so với trước<% else %>= Giữ nguyên<% end %>
        <% else %>Lần luyện tập đầu<% end %>
      </div>
    </div>
  </div>

  <!-- ── Charts ── -->
  <% if total_att > 0 %>
  <div class="charts-row">
    <div class="chart-panel">
      <div class="chart-panel-header">
        <div class="chart-panel-title">📈 Xu hướng Band Score</div>
        <div class="chart-trend-badge" id="trendBadge" style="display:none"></div>
      </div>
      <div class="chart-canvas-wrap"><canvas id="lineChart"></canvas></div>
    </div>
    <div class="chart-panel">
      <div class="chart-panel-header">
        <div class="chart-panel-title">🕸 Kỹ năng trung bình</div>
      </div>
      <div class="chart-canvas-wrap"><canvas id="radarChart"></canvas></div>
    </div>
  </div>
  <% end %>

  <!-- ── History ── -->
  <div class="section-head">
    <div class="section-title">🧠 Lịch sử luyện tập</div>
    <div class="section-count"><%= total_att %> lần</div>
  </div>

  <% if @attempts.any? %>
    <div id="historyContainer"></div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">🎤</div>
      <h3>Chưa có lần luyện nào</h3>
      <p>Hãy bắt đầu luyện speaking để theo dõi tiến độ tại đây!</p>
    </div>
  <% end %>

</div>

<script>
const attempts = <%= raw @attempts.to_json %>;
const total    = attempts.length;

if (total > 0) {
  const validBands = attempts.map(a => a.overall_band).filter(b => b != null);

  /* Trend badge */
  if (validBands.length >= 2) {
    const diff  = (validBands[validBands.length-1] - validBands[validBands.length-2]).toFixed(1);
    const badge = document.getElementById('trendBadge');
    badge.style.display     = 'inline-block';
    badge.textContent       = diff > 0 ? `↑ +${diff}` : diff < 0 ? `↓ ${diff}` : '= Giữ nguyên';
    badge.style.color       = diff > 0 ? '#059669' : diff < 0 ? '#e11d48' : '#7b7f96';
    badge.style.borderColor = diff > 0 ? '#a7f3d0' : diff < 0 ? '#fecdd3' : '#e8eaf2';
    badge.style.background  = diff > 0 ? '#e6f7f1' : diff < 0 ? '#fce7ef' : '#f7f8fc';
  }

  /* Line Chart */
  new Chart(document.getElementById('lineChart'), {
    type: 'line',
    data: {
      labels: attempts.map(a => new Date(a.created_at).toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit' })),
      datasets: [{
        label: 'Band Score',
        data: attempts.map(a => a.overall_band),
       borderColor: '#dc2626',
backgroundColor: 'rgba(220,38,38,.10)',
pointBackgroundColor: '#dc2626',
        pointBorderColor: '#fff',
        pointBorderWidth: 2,
        pointRadius: 5,
        pointHoverRadius: 7,
        fill: true,
        tension: 0.35,
        borderWidth: 2.5
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0d0e14', titleColor: '#a5b4fc', bodyColor: '#f0f2fa',
          padding: 12, cornerRadius: 10,
          callbacks: { label: item => `Band ${item.raw ?? 'N/A'}` }
        }
      },
      scales: {
        y: { min: 0, max: 9, ticks: { stepSize: 1, color: '#7b7f96', font: { size: 11 } }, grid: { color: '#e8eaf2' }, border: { display: false } },
        x: { ticks: { color: '#7b7f96', font: { size: 10 }, maxTicksLimit: 10 }, grid: { display: false }, border: { display: false } }
      }
    }
  });

  /* Radar Chart */
  const avg = key => attempts.reduce((s,a)=>s+(a[key]||0),0)/total;
  new Chart(document.getElementById('radarChart'), {
    type: 'radar',
    data: {
      labels: ['Fluency','Lexical','Grammar','Pronunciation'],
      datasets: [{
        data: [+avg('fluency_score').toFixed(2), +avg('lexical_score').toFixed(2), +avg('grammar_score').toFixed(2), +avg('pronunciation_score').toFixed(2)],
        backgroundColor: 'rgba(220,38,38,.15)',
borderColor: '#dc2626',
pointBackgroundColor: '#dc2626',
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        r: {
          min: 0, max: 9,
          ticks: { stepSize: 1, color: '#7b7f96', font: { size: 10 }, backdropColor: 'transparent' },
          grid: { color: '#e8eaf2' }, angleLines: { color: '#e8eaf2' },
          pointLabels: { font: { size: 12, weight: '600', family: "'Plus Jakarta Sans', sans-serif" }, color: '#3a3d52' }
        }
      }
    }
  });

  /* History Cards */
  const container = document.getElementById('historyContainer');
  if (container) {
    [...attempts].reverse().forEach((a, idx) => {
      const date = new Date(a.created_at).toLocaleDateString('vi-VN', { weekday:'short', year:'numeric', month:'short', day:'numeric' });
      const band = a.overall_band ?? '—';
      const fl   = a.fluency_score ?? '—';
      const lx   = a.lexical_score ?? '—';
      const gr   = a.grammar_score ?? '—';
      const pr   = a.pronunciation_score ?? '—';
      const strs = (a.strengths    || []).map(s=>`<li>${s}</li>`).join('') || '<li>Chưa có dữ liệu</li>';
      const imps = (a.improvements || []).map(i=>`<li>${i}</li>`).join('') || '<li>Chưa có dữ liệu</li>';

      const card = document.createElement('div');
      card.className = 'attempt-card';
      card.style.animationDelay = `${0.04 + idx * 0.04}s`;
      card.innerHTML = `
        <div class="attempt-top" onclick="this.closest('.attempt-card').classList.toggle('open')">
          <div class="attempt-index">#${attempts.length - idx}</div>
          <div class="attempt-meta">
            <div class="attempt-date">${date}</div>
            <div class="attempt-part">Part ${a.part ?? '—'}</div>
          </div>
          <div class="attempt-subscores">
            <div class="subscore"><div class="subscore-val">${fl}</div><div class="subscore-label">Fluency</div></div>
            <div class="subscore"><div class="subscore-val">${lx}</div><div class="subscore-label">Lexical</div></div>
            <div class="subscore"><div class="subscore-val">${gr}</div><div class="subscore-label">Grammar</div></div>
            <div class="subscore"><div class="subscore-val">${pr}</div><div class="subscore-label">Pron</div></div>
          </div>
          <div class="band-badge">
            <div class="band-badge-val">${band}</div>
            <div class="band-badge-label">Band</div>
          </div>
          <div class="attempt-toggle">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </div>
        </div>
        <div class="attempt-body">
          <div class="score-chips">
            <div class="score-chip chip-fluency"><div class="score-chip-val">${fl}</div><div class="score-chip-label">Fluency</div></div>
            <div class="score-chip chip-lexical"><div class="score-chip-val">${lx}</div><div class="score-chip-label">Lexical</div></div>
            <div class="score-chip chip-grammar"><div class="score-chip-val">${gr}</div><div class="score-chip-label">Grammar</div></div>
            <div class="score-chip chip-pron"   ><div class="score-chip-val">${pr}</div><div class="score-chip-label">Pronunciation</div></div>
          </div>
          <div class="content-grid">
            <div class="content-block block-transcript full">
              <div class="cb-label"><span class="cb-dot"></span>Transcript</div>
              <div class="cb-body">${a.transcript || 'Chưa có dữ liệu'}</div>
            </div>
            <div class="content-block block-feedback full">
              <div class="cb-label"><span class="cb-dot"></span>AI Feedback</div>
              <div class="cb-body">${a.feedback || 'Chưa có dữ liệu'}</div>
            </div>
            <div class="content-block block-strengths">
              <div class="cb-label"><span class="cb-dot"></span>Điểm mạnh</div>
              <div class="cb-body"><ul>${strs}</ul></div>
            </div>
            <div class="content-block block-improvements">
              <div class="cb-label"><span class="cb-dot"></span>Cần cải thiện</div>
              <div class="cb-body"><ul>${imps}</ul></div>
            </div>
            <div class="content-block block-correction full">
              <div class="cb-label"><span class="cb-dot"></span>Sample Correction</div>
              <div class="cb-body">${a.sample_correction || 'Chưa có dữ liệu'}</div>
            </div>
          </div>
        </div>`;
      container.appendChild(card);
    });
  }
}
</script>
