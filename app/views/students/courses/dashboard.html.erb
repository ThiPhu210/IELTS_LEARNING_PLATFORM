<!DOCTYPE html>
<html>
<head>
  <title>Tracking Progress</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body {
  background: #f4f6fb;
  font-family: 'Inter', sans-serif;
  margin: 0;
  padding: 40px;
}

/* ===== Container ===== */
.dashboard-container {
  max-width: 1200px;
  margin: auto;
}

.header {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 30px;
}

/* ===== Cards ===== */
.card-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 40px;
}

.card {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.05);
}

.card-title {
  font-size: 13px;
  color: #888;
}

.card-value {
  font-size: 26px;
  font-weight: 700;
  margin-top: 5px;
}

/* ===== Charts ===== */
.chart-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  margin-bottom: 50px;
}

.chart-card {
  background: white;
  padding: 20px;
  border-radius: 16px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.05);
  height: 350px; /* FIXED HEIGHT */
  display: flex;
  align-items: center;
  justify-content: center;
}

canvas {
  max-width: 100%;
  max-height: 300px;
}

/* ===== History ===== */
.history-section {
  margin-top: 20px;
}

.attempt-card {
  background: white;
  padding: 25px;
  border-radius: 18px;
  margin-bottom: 25px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.05);
}

.attempt-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
}

.score-badge {
  background: #4f46e5;
  color: white;
  padding: 5px 12px;
  border-radius: 8px;
  font-weight: 600;
}

.section-title {
  font-weight: 600;
  margin-top: 15px;
  margin-bottom: 5px;
  color: #444;
}

ul {
  margin: 0;
  padding-left: 18px;
}

.transcript-box {
  background: #f9fafc;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  margin-top: 5px;
}

.feedback-box {
  background: #eef3ff;
  padding: 12px;
  border-radius: 8px;
  margin-top: 5px;
  font-size: 14px;
}
</style>
</head>

<body>
<div class="dashboard-container">

  <div class="header">
    🎤 <%= @course.title %> – Tracking Progress
  </div>

  <!-- SUMMARY -->
  <div class="card-grid">
    <div class="card">
      <div class="card-title">Total Attempts</div>
      <div class="card-value" id="totalAttempts"></div>
    </div>

    <div class="card">
      <div class="card-title">Average Band</div>
      <div class="card-value" id="avgBand"></div>
    </div>

    <div class="card">
      <div class="card-title">Best Band</div>
      <div class="card-value" id="bestBand"></div>
    </div>

    <div class="card">
      <div class="card-title">Latest Band</div>
      <div class="card-value" id="latestBand"></div>
    </div>
  </div>

  <!-- CHARTS -->
  <div class="chart-wrapper">
    <div class="chart-card">
      <canvas id="progressChart"></canvas>
    </div>

    <div class="chart-card">
      <canvas id="radarChart"></canvas>
    </div>
  </div>

  <!-- HISTORY -->
  <div class="history-section">
    <h2 style="margin-bottom:20px;">🧠 AI Scoring History</h2>
    <div id="historyContainer"></div>
  </div>

</div>

<script>
const attempts = <%= raw @attempts.to_json %>;

const total = attempts.length;
const avg = (attempts.reduce((s,a)=> s+a.overall_band,0)/total || 0).toFixed(2);
const best = Math.max(...attempts.map(a=>a.overall_band),0);
const latest = attempts[attempts.length-1]?.overall_band || 0;

document.getElementById("totalAttempts").innerText = total;
document.getElementById("avgBand").innerText = avg;
document.getElementById("bestBand").innerText = best;
document.getElementById("latestBand").innerText = latest;

/* ===== LINE CHART ===== */
new Chart(document.getElementById('progressChart'), {
  type: 'line',
  data: {
    labels: attempts.map(a=> new Date(a.created_at).toLocaleDateString()),
    datasets: [{
      label: 'Overall Band',
      data: attempts.map(a=> a.overall_band),
      borderColor: '#4f46e5',
      backgroundColor: 'rgba(79,70,229,0.15)',
      fill: true,
      tension: 0.3
    }]
  },
  options: { maintainAspectRatio: false }
});

/* ===== RADAR CHART ===== */
const avgFluency = attempts.reduce((s,a)=>s+a.fluency_score,0)/total || 0;
const avgLexical = attempts.reduce((s,a)=>s+a.lexical_score,0)/total || 0;
const avgGrammar = attempts.reduce((s,a)=>s+a.grammar_score,0)/total || 0;
const avgPron = attempts.reduce((s,a)=>s+a.pronunciation_score,0)/total || 0;

new Chart(document.getElementById('radarChart'), {
  type: 'radar',
  data: {
    labels: ['Fluency','Lexical','Grammar','Pronunciation'],
    datasets: [{
      label: 'Average Breakdown',
      data: [avgFluency, avgLexical, avgGrammar, avgPron],
      backgroundColor: 'rgba(16,185,129,0.2)',
      borderColor: '#10b981'
    }]
  },
  options: {
    maintainAspectRatio: false,
    scales: {
      r: { min: 0, max: 9, ticks: { stepSize: 1 } }
    }
  }
});

/* ===== HISTORY RENDER ===== */
const container = document.getElementById("historyContainer");

attempts.slice().reverse().forEach(a => {

  const strengths = (a.strengths || []).map(s => `<li>${s}</li>`).join("");
  const improvements = (a.improvements || []).map(i => `<li>${i}</li>`).join("");

  container.innerHTML += `
    <div class="attempt-card">

      <div class="attempt-header">
        <div>
          <strong>${new Date(a.created_at).toLocaleDateString()}</strong>
          - Part ${a.part}
        </div>
        <div class="score-badge">
          Band ${a.overall_band}
        </div>
      </div>

      <div class="section-title">Transcript</div>
      <div class="transcript-box">${a.transcript || "N/A"}</div>

      <div class="section-title">AI Feedback</div>
      <div class="feedback-box">${a.feedback || "N/A"}</div>

      <div class="section-title">Strengths</div>
      <ul>${strengths || "<li>N/A</li>"}</ul>

      <div class="section-title">Improvements</div>
      <ul>${improvements || "<li>N/A</li>"}</ul>

      <div class="section-title">Sample Correction</div>
      <div class="feedback-box">${a.sample_correction || "N/A"}</div>

    </div>
  `;
});
</script>

</body>
</html>
