<%= render "students/shared/navbar" %>
<h1 class="text-3xl font-bold text-slate-800 mb-10">
  <%= @course.title %>
</h1>

<% @sections.each do |section| %>

  <div class="mb-12">

    <h2 class="text-xl font-semibold text-slate-700 mb-4 border-b pb-2">
      📚 <%= section.title %>
    </h2>

    <% section.lessons.each do |lesson| %>

      <div class="bg-white border border-slate-200 rounded-2xl p-6 mb-6 shadow-sm">

        <!-- LESSON TITLE -->
        <p class="font-semibold text-lg text-slate-800">
          🎬 <%= lesson.title %>
        </p>

        <!-- VIDEO -->
        <% if lesson.video.attached? %>
          <video controls class="mt-4 w-full rounded-xl border">
            <source src="<%= url_for(lesson.video) %>" type="video/mp4">
          </video>
        <% end %>

        <!-- PDF -->
        <% if lesson.pdfs.attached? %>
          <div class="mt-4 space-y-2">
            <p class="font-medium text-slate-700">
              📄 Lesson Materials
            </p>

            <% lesson.pdfs.each do |pdf| %>
              <%= link_to pdf.filename,
                    url_for(pdf),
                    target: "_blank",
                    class: "block text-indigo-600 hover:underline text-sm" %>
            <% end %>
          </div>
        <% end %>

        <!-- SPEAKING EXERCISES -->
        <% if lesson.speaking_topics.any? %>

          <div class="mt-6 bg-slate-50 border rounded-xl p-5">

            <h3 class="font-semibold text-slate-700 mb-4">
              🎤 Speaking Practice
            </h3>

            <% lesson.speaking_topics.each do |topic| %>

              <div class="border rounded-lg p-4 mb-4 bg-white">

                <div class="flex justify-between items-center mb-3">

                  <p class="font-medium text-slate-800">
                    <%= topic.title %>
                  </p>

                  <span class="text-xs px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full">
                    <%= topic.part.upcase %>
                  </span>

                </div>

                <% topic.speaking_questions.each do |q| %>

                  <div class="border-t pt-3 mt-3 space-y-2">

                    <p class="font-medium text-slate-700">
                      ❓ <%= q.question_text %>
                    </p>

                    <% if q.cue_card.present? %>
                      <div class="bg-yellow-50 border rounded p-3 text-sm text-slate-700">
                        📝 Cue Card:
                        <p class="mt-1 whitespace-pre-line">
                          <%= q.cue_card %>
                        </p>
                      </div>
                    <% end %>

                    <div class="flex gap-6 text-xs text-slate-600">

                      <% if q.preparation_time.present? %>
                        <span>
                          ⏱ Preparation:
                          <b><%= q.preparation_time %> sec</b>
                        </span>
                      <% end %>

                      <% if q.speaking_time.present? %>
                        <span>
                          🎙 Speaking:
                          <b><%= q.speaking_time %> sec</b>
                        </span>
                      <% end %>

                    </div>

                  </div>

                <% end %>

              </div>

            <% end %>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>

<% end %>
