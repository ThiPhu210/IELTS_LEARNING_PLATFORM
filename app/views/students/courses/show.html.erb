<%= render "students/shared/navbar" %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --bg: #0f1117;
    --surface: #1a1d27;
    --surface2: #22263a;
    --border: #2e3350;
    --accent: #6c63ff;
    --accent2: #ff6584;
    --green: #22d3a5;
    --yellow: #fbbf24;
    --text: #e8eaf6;
    --muted: #7b82a8;
    --radius: 16px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Outfit', sans-serif; }

  .page-wrapper {
    padding-top: 100px; padding-bottom: 80px; min-height: 100vh;
    background:
      radial-gradient(ellipse 60% 40% at 80% 10%, rgba(108,99,255,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 30% at 10% 80%, rgba(34,211,165,0.08) 0%, transparent 60%),
      var(--bg);
  }
  .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }

  .course-header {
    margin-bottom: 48px; padding: 36px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 24px; position: relative; overflow: hidden;
  }
  .course-header::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--green));
  }
  .course-title { font-size: 2rem; font-weight: 800; color: var(--text); margin-bottom: 10px; letter-spacing: -0.5px; }
  .course-desc { color: var(--muted); font-size: 1rem; line-height: 1.6; }

  .section-block { margin-bottom: 48px; }
  .section-heading { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .section-icon { width: 40px; height: 40px; background: linear-gradient(135deg, var(--accent), #8b5cf6); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
  .section-title { font-size: 1.3rem; font-weight: 700; color: var(--text); letter-spacing: -0.3px; }

  .lesson-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; margin-bottom: 20px; transition: border-color 0.2s; }
  .lesson-card:hover { border-color: rgba(108,99,255,0.4); }
  .lesson-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .lesson-title { font-size: 1.05rem; font-weight: 600; color: var(--text); }
  .duration-badge { font-size: 0.75rem; padding: 4px 12px; background: var(--surface2); border: 1px solid var(--border); border-radius: 20px; color: var(--muted); font-family: 'JetBrains Mono', monospace; flex-shrink: 0; }

  .video-wrap { border-radius: 12px; overflow: hidden; border: 1px solid var(--border); margin-bottom: 20px; background: #000; }
  .video-wrap video { width: 100%; display: block; max-height: 420px; }

  .pdf-section { margin-bottom: 20px; }
  .pdf-label { font-size: 0.85rem; font-weight: 600; color: var(--muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.05em; }
  .pdf-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .pdf-link { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(108,99,255,0.1); border: 1px solid rgba(108,99,255,0.3); border-radius: 8px; color: #a5b4fc; font-size: 0.85rem; text-decoration: none; transition: all 0.2s; }
  .pdf-link:hover { background: rgba(108,99,255,0.2); color: #c7d2fe; }

  .speaking-block { margin-top: 24px; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; }
  .speaking-block-title { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }

  .topic-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 16px; }
  .topic-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .topic-title { font-weight: 600; color: var(--text); }
  .part-badge { font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.08em; font-family: 'JetBrains Mono', monospace; }
  .part-badge.part1 { background: rgba(34,211,165,0.15); color: var(--green); border: 1px solid rgba(34,211,165,0.3); }
  .part-badge.part2 { background: rgba(251,191,36,0.15); color: var(--yellow); border: 1px solid rgba(251,191,36,0.3); }
  .part-badge.part3 { background: rgba(108,99,255,0.15); color: #a5b4fc; border: 1px solid rgba(108,99,255,0.3); }

  .question-block { border-top: 1px solid var(--border); padding-top: 16px; margin-top: 8px; }
  .question-text { font-size: 0.95rem; color: var(--text); font-weight: 500; margin-bottom: 12px; line-height: 1.5; }
  .cue-card { background: rgba(251,191,36,0.08); border: 1px solid rgba(251,191,36,0.2); border-radius: 10px; padding: 14px; margin-bottom: 12px; }
  .cue-card-label { font-size: 0.75rem; font-weight: 700; color: var(--yellow); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
  .cue-card-text { font-size: 0.875rem; color: #d1d5db; white-space: pre-line; line-height: 1.6; }
  .time-info { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .time-badge { font-size: 0.75rem; padding: 4px 10px; border-radius: 6px; font-family: 'JetBrains Mono', monospace; }
  .time-badge.prep { background: rgba(59,130,246,0.1); color: #93c5fd; border: 1px solid rgba(59,130,246,0.2); }
  .time-badge.speak { background: rgba(34,211,165,0.1); color: var(--green); border: 1px solid rgba(34,211,165,0.2); }

  /* Modal */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 1000; align-items: center; justify-content: center; }
  .modal-overlay.active { display: flex; }
  .modal { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 36px; width: 100%; max-width: 600px; margin: 20px; position: relative; animation: modalIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); max-height: 90vh; overflow-y: auto; }
  @keyframes modalIn { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
  .modal-close { position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 1rem; transition: all 0.2s; }
  .modal-close:hover { background: var(--border); color: var(--text); }
  .modal-q { font-size: 1rem; font-weight: 600; color: var(--text); margin-bottom: 24px; line-height: 1.5; padding-right: 40px; }

  .phase-display { text-align: center; margin-bottom: 24px; }
  .phase-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 8px; }
  .phase-name { font-size: 1.1rem; font-weight: 700; color: var(--text); margin-bottom: 16px; }
  .timer-ring-wrap { display: flex; justify-content: center; margin-bottom: 16px; }
  .timer-ring { position: relative; width: 120px; height: 120px; }
  .timer-ring svg { transform: rotate(-90deg); width: 120px; height: 120px; }
  .timer-ring circle.bg { fill: none; stroke: var(--surface2); stroke-width: 8; }
  .timer-ring circle.progress { fill: none; stroke: var(--accent); stroke-width: 8; stroke-linecap: round; stroke-dasharray: 339.3; stroke-dashoffset: 0; transition: stroke-dashoffset 1s linear, stroke 0.3s; }
  .timer-ring circle.progress.speaking-phase { stroke: var(--accent2); }
  .timer-ring circle.progress.done-phase { stroke: var(--green); }
  .timer-number { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: var(--text); }

  .waveform { display: flex; align-items: center; justify-content: center; gap: 3px; height: 40px; margin-bottom: 16px; opacity: 0; transition: opacity 0.3s; }
  .waveform.active { opacity: 1; }
  .waveform-bar { width: 4px; background: var(--accent2); border-radius: 2px; animation: wave 0.8s ease-in-out infinite; min-height: 4px; }
  @keyframes wave { 0%, 100% { height: 8px; } 50% { height: 32px; } }

  .transcript-wrap { background: var(--surface2); border: 1px solid var(--border); border-radius: 12px; padding: 16px; min-height: 80px; margin-bottom: 16px; }
  .transcript-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 8px; }
  .transcript-text { font-size: 0.9rem; line-height: 1.7; color: var(--text); min-height: 40px; }
  .transcript-interim { color: var(--muted); font-style: italic; }
  .transcript-placeholder { color: var(--muted); font-style: italic; font-size: 0.85rem; }

  .btn-group { display: flex; gap: 10px; margin-bottom: 12px; }
  .btn-speak { flex: 1; padding: 14px; border-radius: 12px; border: none; font-size: 0.9rem; font-weight: 700; font-family: 'Outfit', sans-serif; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .btn-speak.primary { background: linear-gradient(135deg, var(--accent), #8b5cf6); color: #fff; }
  .btn-speak.primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(108,99,255,0.4); }
  .btn-speak.danger { background: rgba(255,101,132,0.15); color: var(--accent2); border: 1px solid rgba(255,101,132,0.3); }
  .btn-speak.danger:hover { background: rgba(255,101,132,0.25); }
  .btn-speak.secondary { background: var(--surface2); color: var(--muted); border: 1px solid var(--border); }
  .btn-speak.secondary:hover { background: var(--border); color: var(--text); }
  .btn-speak:disabled { opacity: 0.4; cursor: not-allowed; transform: none !important; box-shadow: none !important; }
  .btn-speak.hidden { display: none; }

  .btn-start { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: linear-gradient(135deg, var(--accent), #8b5cf6); color: #fff; border: none; border-radius: 10px; font-family: 'Outfit', sans-serif; font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .btn-start:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(108,99,255,0.4); }

  .status-msg { display: none; margin-top: 8px; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 500; text-align: center; }
  .status-msg.success  { background: rgba(34,211,165,0.15);  color: var(--green);   border: 1px solid rgba(34,211,165,0.3);  display: block; }
  .status-msg.uploading{ background: rgba(108,99,255,0.15);  color: #a5b4fc;        border: 1px solid rgba(108,99,255,0.3);  display: block; }
  .status-msg.error    { background: rgba(255,101,132,0.15); color: var(--accent2); border: 1px solid rgba(255,101,132,0.3); display: block; }
  .status-msg.info     { background: rgba(251,191,36,0.1);   color: var(--yellow);  border: 1px solid rgba(251,191,36,0.3);  display: block; }
</style>

<div class="page-wrapper">
<div class="container">

  <div class="course-header">
    <h1 class="course-title">📘 <%= @course.title %></h1>
    <% if @course.description.present? %>
      <p class="course-desc"><%= @course.description %></p>
    <% end %>
  </div>

  <% @sections.each do |section| %>
  <div class="section-block">
    <div class="section-heading">
      <div class="section-icon">📚</div>
      <h2 class="section-title"><%= section.title %></h2>
    </div>

    <% section.lessons.each do |lesson| %>
    <div class="lesson-card">
      <div class="lesson-header">
        <h3 class="lesson-title">🎬 <%= lesson.title %></h3>
        <% if lesson.duration.present? %>
          <span class="duration-badge">⏱ <%= lesson.duration %> min</span>
        <% end %>
      </div>

      <% if lesson.video.attached? %>
        <div class="video-wrap">
          <video controls>
            <source src="<%= url_for(lesson.video) %>" type="video/mp4">
          </video>
        </div>
      <% end %>

      <% if lesson.pdfs.attached? %>
        <div class="pdf-section">
          <p class="pdf-label">📄 Materials</p>
          <div class="pdf-list">
            <% lesson.pdfs.each do |pdf| %>
              <a href="<%= url_for(pdf) %>" target="_blank" class="pdf-link">📎 <%= pdf.filename %></a>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if lesson.speaking_topics.any? %>
        <div class="speaking-block">
          <p class="speaking-block-title">🎤 Speaking Practice</p>
          <% lesson.speaking_topics.each do |topic| %>
          <div class="topic-card">
            <div class="topic-header">
              <span class="topic-title"><%= topic.title %></span>
              <span class="part-badge <%= topic.part %>"><%= topic.part.upcase %></span>
            </div>
            <% topic.speaking_questions.each do |q| %>
            <div class="question-block">
              <p class="question-text">❓ <%= q.question_text %></p>
              <% if q.cue_card.present? %>
                <div class="cue-card">
                  <p class="cue-card-label">📝 Cue Card</p>
                  <p class="cue-card-text"><%= q.cue_card %></p>
                </div>
              <% end %>
              <div class="time-info">
                <% if q.preparation_time.present? %>
                  <span class="time-badge prep">🧠 Prep: <%= q.preparation_time %>s</span>
                <% end %>
                <% if q.speaking_time.present? %>
                  <span class="time-badge speak">🎙 Speak: <%= q.speaking_time %>s</span>
                <% end %>
              </div>
              <button class="btn-start"
                data-modal="speaking-modal"
                data-prep="<%= q.preparation_time || 60 %>"
                data-speak="<%= q.speaking_time || 120 %>"
                data-topic="<%= topic.id %>"
                data-course="<%= @course.id %>"
                data-part="<%= topic.part %>"
                data-question="<%= q.question_text %>">
                🎤 Start Speaking
              </button>
            </div>
            <% end %>
          </div>
          <% end %>
        </div>
      <% end %>

    </div>
    <% end %>
  </div>
  <% end %>

</div>
</div>

<!-- Speaking Modal -->
<div class="modal-overlay" id="speaking-modal">
  <div class="modal">
    <button class="modal-close" id="modal-close-btn">✕</button>
    <p class="modal-q" id="modal-question"></p>

    <div class="phase-display">
      <p class="phase-label">Current Phase</p>
      <p class="phase-name" id="phase-name">Ready</p>
      <div class="timer-ring-wrap">
        <div class="timer-ring">
          <svg viewBox="0 0 120 120">
            <circle class="bg" cx="60" cy="60" r="54"/>
            <circle class="progress" id="ring-progress" cx="60" cy="60" r="54"/>
          </svg>
          <div class="timer-number" id="timer-number">—</div>
        </div>
      </div>
      <div class="waveform" id="waveform">
        <% 12.times do |i| %>
          <div class="waveform-bar" style="animation-delay: <%= i * 0.07 %>s"></div>
        <% end %>
      </div>
    </div>

    <div class="transcript-wrap">
      <p class="transcript-label">📝 Live Transcript</p>
      <div class="transcript-text" id="transcript-display">
        <span class="transcript-placeholder">Your words will appear here as you speak...</span>
      </div>
    </div>

    <div class="btn-group">
      <button class="btn-speak primary" id="btn-start">🎤 Begin Session</button>
      <button class="btn-speak danger hidden" id="btn-done">✅ Finish Early</button>
      <button class="btn-speak secondary hidden" id="btn-retry">🔄 Try Again</button>
    </div>

    <div class="status-msg" id="status-msg"></div>
  </div>
</div>

<script>
// ── Logger ──
const LOG = '[Speaking]';
function log(msg, data)      { data !== undefined ? console.log(LOG, msg, data) : console.log(LOG, msg); }
function logError(msg, err)  { console.error(LOG, '❌', msg, err || ''); }

// ── State ──
let mediaRecorder, audioChunks = [];
let recognition, finalTranscript = '', interimTranscript = '';
let currentData = {};
let timerInterval = null;
let totalSeconds  = 0;
let currentPhase  = 'idle'; // idle | prep | speaking | uploading | done
let resolveTimer  = null;

const CIRCUMFERENCE = 2 * Math.PI * 54;

const modal        = document.getElementById('speaking-modal');
const modalQ       = document.getElementById('modal-question');
const phaseName    = document.getElementById('phase-name');
const timerNum     = document.getElementById('timer-number');
const ringProgress = document.getElementById('ring-progress');
const waveform     = document.getElementById('waveform');
const transcriptEl = document.getElementById('transcript-display');
const btnStart     = document.getElementById('btn-start');
const btnDone      = document.getElementById('btn-done');
const btnRetry     = document.getElementById('btn-retry');
const statusMsg    = document.getElementById('status-msg');

// ── Open modal ──
document.addEventListener('click', e => {
  const btn = e.target.closest('[data-modal]');
  if (!btn) return;
  currentData = {
    prep: parseInt(btn.dataset.prep), speak: parseInt(btn.dataset.speak),
    topic: btn.dataset.topic, course: btn.dataset.course,
    part: btn.dataset.part, question: btn.dataset.question
  };
  log('Modal opened', currentData);
  modalQ.textContent = '❓ ' + currentData.question;
  resetModal();
  modal.classList.add('active');
});

// ── Close modal ──
document.getElementById('modal-close-btn').addEventListener('click', closeModal);
modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

function closeModal() {
  log('Modal closed, phase:', currentPhase);
  stopRecording();
  stopRecognition();
  clearInterval(timerInterval);
  if (resolveTimer) { resolveTimer(); resolveTimer = null; }
  currentPhase = 'idle';
  modal.classList.remove('active');
}

// ── Reset ──
function resetModal() {
  log('Reset modal');
  finalTranscript = ''; interimTranscript = '';
  currentPhase = 'idle'; resolveTimer = null;
  transcriptEl.innerHTML = '<span class="transcript-placeholder">Your words will appear here as you speak...</span>';
  phaseName.textContent = 'Ready';
  timerNum.textContent = '—';
  ringProgress.style.strokeDashoffset = 0;
  ringProgress.className = 'progress';
  ringProgress.style.strokeDasharray = CIRCUMFERENCE;
  waveform.classList.remove('active');
  statusMsg.className = 'status-msg'; statusMsg.textContent = '';
  btnStart.classList.remove('hidden'); btnStart.disabled = false; btnStart.textContent = '🎤 Begin Session';
  btnDone.classList.add('hidden');  btnDone.disabled = false;
  btnRetry.classList.add('hidden');
}

// ── Timer ──
function runTimer(seconds, label, phaseClass) {
  return new Promise(resolve => {
    totalSeconds = seconds;
    let remaining = seconds;
    log(`Timer start: "${label}" (${seconds}s)`);
    phaseName.textContent = label;
    ringProgress.className = 'progress ' + phaseClass;
    ringProgress.style.strokeDasharray = CIRCUMFERENCE;
    ringProgress.style.strokeDashoffset = 0;
    timerNum.textContent = remaining;

    resolveTimer = () => { clearInterval(timerInterval); log('Timer resolved early'); resolve(); };

    clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      remaining--;
      timerNum.textContent = remaining;
      ringProgress.style.strokeDashoffset = CIRCUMFERENCE * (1 - remaining / totalSeconds);
      if (remaining <= 0) {
        clearInterval(timerInterval);
        resolveTimer = null;
        log(`Timer finished: "${label}"`);
        resolve();
      }
    }, 1000);
  });
}

// ── Speech Recognition ──
function startRecognition() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { log('⚠️ SpeechRecognition not supported'); return; }
  recognition = new SR();
  recognition.continuous = true;
  recognition.interimResults = true;
  recognition.lang = 'en-US';
  recognition.onstart  = () => log('Recognition started');
  recognition.onend    = () => log('Recognition ended');
  recognition.onerror  = (e) => logError('Recognition error', e.error);
  recognition.onresult = (event) => {
    interimTranscript = '';
    for (let i = event.resultIndex; i < event.results.length; i++) {
      const t = event.results[i][0].transcript;
      if (event.results[i].isFinal) { finalTranscript += t + ' '; log('Final chunk:', t); }
      else interimTranscript += t;
    }
    transcriptEl.innerHTML =
      '<span style="color:var(--text)">' + finalTranscript + '</span>' +
      '<span class="transcript-interim">' + interimTranscript + '</span>';
  };
  recognition.start();
}

function stopRecognition() {
  try { if (recognition) { recognition.stop(); log('Recognition stopped'); } } catch(e) { logError('stopRecognition', e); }
}

// ── MediaRecorder ──
async function startRecording() {
  log('Requesting microphone...');
  const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
  log('Mic granted');
  audioChunks = [];
  mediaRecorder = new MediaRecorder(stream);
  mediaRecorder.ondataavailable = e => { audioChunks.push(e.data); log('Chunk size:', e.data.size); };
  mediaRecorder.start();
  log('MediaRecorder started');
}

function stopRecording() {
  return new Promise(resolve => {
    if (!mediaRecorder || mediaRecorder.state === 'inactive') { log('Recorder inactive'); resolve(null); return; }
    mediaRecorder.onstop = () => {
      const blob = new Blob(audioChunks, { type: 'audio/webm' });
      audioChunks = [];
      log('Blob size:', blob.size);
      resolve(blob);
    };
    mediaRecorder.stop();
    mediaRecorder.stream.getTracks().forEach(t => t.stop());
  });
}

// ── Upload ──
async function uploadAttempt(audioBlob) {
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  if (!csrfToken) logError('CSRF token missing!');

  log('Uploading... transcript length:', finalTranscript.length);
  const form = new FormData();
  form.append('audio', audioBlob, 'recording.webm');
  form.append('transcript', finalTranscript.trim());
  form.append('speaking_topic_id', currentData.topic);
  form.append('course_id', currentData.course);
  form.append('part', currentData.part);

  const res = await fetch('/students/speaking_attempts', {
    method: 'POST',
    headers: csrfToken ? { 'X-CSRF-Token': csrfToken } : {},
    body: form
  });

  const text = await res.text();
  log('Response status:', res.status);
  log('Response body:', text);

  if (!res.ok) throw new Error(`Server ${res.status}: ${text}`);
  return JSON.parse(text);
}

// ── Finish speaking (manual or auto) ──
async function finishSpeaking() {
  if (currentPhase !== 'speaking') { log('finishSpeaking called but phase is:', currentPhase); return; }
  currentPhase = 'uploading';
  log('Finishing speaking...');

  btnDone.classList.add('hidden');
  waveform.classList.remove('active');
  stopRecognition();

  phaseName.textContent = '✅ Done!';
  ringProgress.className = 'progress done-phase';
  timerNum.textContent = '✓';

  if (resolveTimer) { resolveTimer(); resolveTimer = null; }

  showStatus('uploading', '⬆️ Uploading & AI evaluating... Please wait.');

  const audioBlob = await stopRecording();

  if (!audioBlob || audioBlob.size === 0) {
    logError('Blob is empty!');
    showStatus('error', '❌ Recording is empty. Please try again.');
    showRetry(); return;
  }

  try {
    const result = await uploadAttempt(audioBlob);
    log('Result:', result);
    showResult(result);
  } catch(err) {
    logError('Upload failed', err);
    showStatus('error', `❌ ${err.message}`);
    showRetry();
  }
}

// ── Show result ──
function showResult(result) {
  currentPhase = 'done';
  transcriptEl.innerHTML = `
    <div style="margin-top:8px">
      <p style="color:var(--green);font-weight:800;font-size:1.2rem;margin-bottom:12px">
        🏆 Overall Band: ${result.overall ?? 'N/A'}
      </p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px">
        <span style="background:rgba(108,99,255,0.1);border:1px solid rgba(108,99,255,0.3);border-radius:8px;padding:8px;font-size:0.8rem">🗣 Fluency: <b>${result.fluency ?? 'N/A'}</b></span>
        <span style="background:rgba(108,99,255,0.1);border:1px solid rgba(108,99,255,0.3);border-radius:8px;padding:8px;font-size:0.8rem">📚 Lexical: <b>${result.lexical ?? 'N/A'}</b></span>
        <span style="background:rgba(108,99,255,0.1);border:1px solid rgba(108,99,255,0.3);border-radius:8px;padding:8px;font-size:0.8rem">✏️ Grammar: <b>${result.grammar ?? 'N/A'}</b></span>
        <span style="background:rgba(108,99,255,0.1);border:1px solid rgba(108,99,255,0.3);border-radius:8px;padding:8px;font-size:0.8rem">🎵 Pronunciation: <b>${result.pronunciation ?? 'N/A'}</b></span>
      </div>
      <p style="color:var(--muted);font-size:0.85rem;line-height:1.7;border-top:1px solid var(--border);padding-top:10px">
        💬 ${result.feedback ?? ''}
      </p>
    </div>
  `;
  showStatus('success', '✅ AI đã chấm xong! Email kết quả sẽ được gửi cho bạn.');
  showRetry();
}

function showRetry() {
  btnStart.classList.add('hidden');
  btnDone.classList.add('hidden');
  btnRetry.classList.remove('hidden');
}

// ── Button events ──
btnStart.addEventListener('click', async () => {
  log('Begin Session clicked');
  btnStart.disabled = true;
  btnStart.textContent = '⏳ Starting...';
  currentPhase = 'prep';
  showStatus('info', '🧠 Prepare your answer...');

  await runTimer(currentData.prep, '🧠 Preparation Time', '');
  if (currentPhase !== 'prep') return;

  try {
    await startRecording();
    startRecognition();
  } catch(err) {
    logError('Mic denied', err);
    showStatus('error', '❌ Microphone access denied. Please allow and retry.');
    btnStart.disabled = false; btnStart.textContent = '🎤 Begin Session';
    currentPhase = 'idle'; return;
  }

  currentPhase = 'speaking';
  phaseName.textContent = '🎙 Speak Now!';
  waveform.classList.add('active');
  btnStart.classList.add('hidden');
  btnDone.classList.remove('hidden');
  showStatus('info', '🎙 Recording... Bấm "Finish Early" nếu xong trước giờ.');

  await runTimer(currentData.speak, '🎙 Speaking...', 'speaking-phase');

  if (currentPhase === 'speaking') {
    log('Timer ended naturally');
    await finishSpeaking();
  }
});

btnDone.addEventListener('click', async () => {
  log('Finish Early clicked');
  await finishSpeaking();
});

btnRetry.addEventListener('click', () => {
  log('Retry clicked');
  stopRecording();
  stopRecognition();
  clearInterval(timerInterval);
  resetModal();
});

function showStatus(type, msg) {
  statusMsg.className = 'status-msg ' + type;
  statusMsg.textContent = msg;
  log(`[${type}] ${msg}`);
}
</script>
