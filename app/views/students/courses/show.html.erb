<%# ============================================================
    app/views/students/courses/show.html.erb
    Design: Red color scheme — synced with dashboard/index.html.erb
    ============================================================ %>

<%= render "students/shared/navbar" %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════════
   DESIGN TOKENS — RED COLOR SCHEME
═══════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --ink:          #0d0e14;
  --ink-2:        #3a3d52;
  --ink-3:        #7b7f96;
  --line:         #e8eaf2;
  --bg:           #f2f4f9;
  --surface:      #ffffff;
  --surface-2:    #f7f8fc;
  --primary:      #dc2626;
  --primary-lt:   #fee2e2;
  --primary-glow: rgba(220,38,38,.18);
  --teal:         #0d9488;
  --teal-lt:      #e6faf8;
  --amber:        #d97706;
  --amber-lt:     #fef3e1;
  --rose:         #e11d48;
  --rose-lt:      #fce7ef;
  --emerald:      #059669;
  --emerald-lt:   #e6f7f1;
  --r-sm: 10px; --r-md: 16px; --r-lg: 22px; --r-xl: 28px;
  --shadow-xs: 0 1px 3px rgba(0,0,0,.06);
  --shadow-sm: 0 2px 10px rgba(0,0,0,.07);
  --shadow-md: 0 6px 24px rgba(0,0,0,.09);
  --shadow-lg: 0 16px 48px rgba(0,0,0,.12);
  --font:       'Plus Jakarta Sans', sans-serif;
  --font-serif: 'Instrument Serif', serif;
  --font-mono:  'JetBrains Mono', monospace;
  --ease: cubic-bezier(.4,0,.2,1);
}

html { scroll-behavior: smooth; }
body { font-family: var(--font); background: var(--bg); color: var(--ink); line-height: 1.6; }

@keyframes fadeUp   { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:none; } }
@keyframes slideUp  { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:none; } }
@keyframes wave     { 0%,100%{height:4px} 50%{height:24px} }
@keyframes pulseGlow { 0%,100%{box-shadow:0 0 0 0 var(--primary-glow)} 50%{box-shadow:0 0 0 8px transparent} }

/* ═══════════════════════════════════════════
   1. COURSE HERO — full-width banner (NO thumb card)
═══════════════════════════════════════════ */
.course-hero {
  position: relative;
  padding-top: 80px;
  background: var(--ink);
  overflow: hidden;
  min-height: 300px;
}
/* Blurred bg image */
.course-hero-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  opacity: .2;
}
.course-hero-bg.no-image {
  background: linear-gradient(135deg, #7f1d1d 0%, #1e1b4b 100%);
  opacity: 1;
}
/* Dark vignette */
.course-hero::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(to right, rgba(13,14,20,.93) 0%, rgba(13,14,20,.72) 55%, rgba(13,14,20,.28) 100%);
  pointer-events: none;
}
.course-hero-inner {
  position: relative; z-index: 1;
  max-width: 1200px; margin: 0 auto; padding: 44px 32px 52px;
  display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: start;
}

.breadcrumb {
  display: flex; align-items: center; gap: 6px;
  font-size: 12px; font-weight: 600; color: rgba(255,255,255,.45);
  margin-bottom: 16px; animation: fadeUp .4s var(--ease) both;
}
.breadcrumb a { color: #fca5a5; text-decoration: none; transition: opacity .15s; }
.breadcrumb a:hover { opacity: .8; }

.course-hero-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  color: #fca5a5; background: rgba(220,38,38,.22);
  padding: 4px 12px; border-radius: 20px; margin-bottom: 14px;
  border: 1px solid rgba(252,165,165,.28);
  animation: fadeUp .4s var(--ease) .05s both;
}
.course-hero-title {
  font-family: var(--font-serif);
  font-size: clamp(26px, 3vw, 42px); font-weight: 400;
  line-height: 1.15; letter-spacing: -.02em; color: #fff;
  margin-bottom: 14px; animation: fadeUp .4s var(--ease) .08s both;
}
.course-hero-title em { font-style: italic; color: #fca5a5; }
.course-hero-desc {
  font-size: 14.5px; color: rgba(255,255,255,.6); line-height: 1.75;
  max-width: 540px; margin-bottom: 22px;
  animation: fadeUp .4s var(--ease) .12s both;
}
.course-stats-row {
  display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 24px;
  animation: fadeUp .4s var(--ease) .15s both;
}
.stat-item { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.65); }
.stat-item svg { color: #fca5a5; }
.stat-divider { width: 1px; height: 14px; background: rgba(255,255,255,.16); }

.teacher-mini {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; background: rgba(255,255,255,.08); backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.12); border-radius: var(--r-md);
  width: fit-content; animation: fadeUp .4s var(--ease) .18s both;
}
.teacher-mini-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(252,165,165,.4); }
.teacher-mini-avatar-ph {
  width: 34px; height: 34px; border-radius: 50%;
  background: rgba(220,38,38,.3); display: flex; align-items: center; justify-content: center;
  font-family: var(--font-serif); font-size: 15px; font-style: italic; color: #fca5a5; flex-shrink: 0;
}
.teacher-mini-name { font-size: 13px; font-weight: 700; color: #fff; }
.teacher-mini-role { font-size: 11px; color: rgba(255,255,255,.45); margin-top: 1px; }

/* Enrollment panel (right of hero) */
.enroll-panel {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-xl); box-shadow: var(--shadow-lg);
  padding: 24px 22px;
  animation: fadeUp .4s var(--ease) .1s both;
}
.card-price-row { display: flex; align-items: baseline; gap: 10px; margin-bottom: 18px; }
.card-price { font-family: var(--font-serif); font-size: 34px; line-height: 1; letter-spacing: -.03em; color: var(--ink); }
.card-price-label { font-size: 12px; font-weight: 600; color: var(--ink-3); }

.btn-enroll {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 14px; background: var(--primary); color: #fff;
  font-size: 15px; font-weight: 700; border-radius: var(--r-md);
  text-decoration: none; border: none; cursor: pointer;
  transition: all .2s var(--ease); box-shadow: 0 4px 14px var(--primary-glow); font-family: var(--font);
  animation: pulseGlow 2.5s ease-in-out infinite;
}
.btn-enroll:hover { background: #b91c1c; transform: translateY(-1px); }
.btn-enter {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 14px; background: var(--emerald); color: #fff;
  font-size: 15px; font-weight: 700; border-radius: var(--r-md);
  text-decoration: none; border: none; cursor: pointer;
  transition: all .2s var(--ease); box-shadow: 0 4px 14px rgba(5,150,105,.2); font-family: var(--font);
}
.btn-enter:hover { background: #047857; transform: translateY(-1px); }
.btn-pending {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 14px; background: var(--amber-lt); color: var(--amber);
  font-size: 15px; font-weight: 700; border-radius: var(--r-md);
  border: 1.5px solid #fcd34d; cursor: default; font-family: var(--font);
}
.card-includes { margin-top: 18px; padding-top: 18px; border-top: 1.5px solid var(--line); }
.card-includes-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin-bottom: 12px; }
.include-item { display: flex; align-items: center; gap: 9px; font-size: 13px; color: var(--ink-2); font-weight: 500; margin-bottom: 8px; }
.include-item:last-child { margin-bottom: 0; }
.include-item svg { color: var(--emerald); flex-shrink: 0; }

/* ═══════════════════════════════════════════
   MAIN LAYOUT
═══════════════════════════════════════════ */
.lms-layout {
  max-width: 1200px; margin: 0 auto; padding: 36px 32px 80px;
  display: grid; grid-template-columns: 1fr 300px; gap: 28px; align-items: start;
}
.lms-main { min-width: 0; }
.lms-sidebar { position: sticky; top: 88px; }

/* Progress card */
.progress-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); padding: 20px 22px; margin-bottom: 24px;
  box-shadow: var(--shadow-xs); animation: fadeUp .45s var(--ease) .1s both;
}
.progress-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.progress-card-title { font-size: 12px; font-weight: 700; color: var(--ink-2); text-transform: uppercase; letter-spacing: .07em; }
.progress-pct { font-family: var(--font-mono); font-size: 20px; font-weight: 500; color: var(--primary); }
.progress-track { height: 5px; background: var(--line); border-radius: 3px; overflow: hidden; margin-bottom: 14px; }
.progress-fill  { height: 100%; background: linear-gradient(90deg, var(--primary), #f87171); border-radius: 3px; }
.progress-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.pstat { text-align: center; padding: 10px 8px; background: var(--surface-2); border: 1.5px solid var(--line); border-radius: var(--r-sm); }
.pstat-num   { font-family: var(--font-mono); font-size: 18px; font-weight: 500; color: var(--ink); }
.pstat-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); margin-top: 2px; }

/* Section accordion */
.section-group { margin-bottom: 16px; animation: fadeUp .5s var(--ease) both; }
.section-header-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 18px; background: var(--surface-2);
  border: 1.5px solid var(--line); border-radius: var(--r-lg) var(--r-lg) 0 0;
  cursor: pointer; user-select: none; transition: background .15s;
}
.section-header-bar:hover, .section-header-bar.open { background: var(--primary-lt); border-color: #fca5a5; }
.section-header-left { display: flex; align-items: center; gap: 11px; }
.section-num {
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--primary); color: #fff;
  font-size: 11px; font-weight: 800; font-family: var(--font-mono);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.section-name  { font-size: 14px; font-weight: 700; color: var(--ink); }
.section-count { font-size: 11px; font-weight: 600; color: var(--ink-3); margin-top: 1px; }
.section-chevron { width: 20px; height: 20px; color: var(--ink-3); transition: transform .25s var(--ease); }
.section-header-bar.open .section-chevron { transform: rotate(180deg); }
.section-body {
  border: 1.5px solid var(--line); border-top: none;
  border-radius: 0 0 var(--r-lg) var(--r-lg); overflow: hidden;
  display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s var(--ease);
}
.section-body.open { grid-template-rows: 1fr; }
.section-body-inner { overflow: hidden; }

/* ── 2. Lesson item with inline video + PDF ── */
.lesson-item {
  background: var(--surface); border-bottom: 1px solid var(--line);
}
.lesson-item:last-child { border-bottom: none; }

.lesson-item-head {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 18px; cursor: pointer; transition: background .15s;
}
.lesson-item-head:hover { background: var(--surface-2); }

.lesson-icon-wrap {
  width: 36px; height: 36px; border-radius: var(--r-sm); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--primary-lt); color: var(--primary); border: 1.5px solid #fca5a5;
}
.lesson-info { flex: 1; min-width: 0; }
.lesson-name { font-size: 14px; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lesson-meta { display: flex; align-items: center; gap: 7px; margin-top: 3px; flex-wrap: wrap; }
.lesson-tag { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px; font-family: var(--font-mono); text-transform: uppercase; }
.tag-video    { background: var(--primary-lt); color: var(--primary); border: 1px solid #fca5a5; }
.tag-pdf      { background: var(--amber-lt);   color: var(--amber);   border: 1px solid #fcd34d; }
.tag-speaking { background: var(--teal-lt);    color: var(--teal);    border: 1px solid #99f6e4; }
.tag-duration { background: var(--surface-2);  color: var(--ink-3);   border: 1px solid var(--line); }

.lesson-expand-icon { color: var(--ink-3); transition: transform .25s var(--ease); flex-shrink: 0; }
.lesson-item.open .lesson-expand-icon { transform: rotate(180deg); }

.lesson-content {
  display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s var(--ease);
}
.lesson-content.open { grid-template-rows: 1fr; }
.lesson-content-inner { overflow: hidden; border-top: 1px solid var(--line); background: var(--surface-2); }
.lesson-content-body  { padding: 18px 20px; display: flex; flex-direction: column; gap: 16px; }

/* Video */
.content-label {
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .08em; color: var(--ink-3); margin-bottom: 10px;
}
.video-player-wrap {
  border-radius: var(--r-md); overflow: hidden;
  border: 1.5px solid var(--line); background: #000; box-shadow: var(--shadow-sm);
}
.video-player-wrap video { width: 100%; display: block; max-height: 380px; }

/* PDFs */
.pdf-list { display: flex; flex-wrap: wrap; gap: 8px; }
.pdf-link {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 8px 14px; background: var(--surface);
  border: 1.5px solid var(--line); border-radius: var(--r-sm);
  color: var(--ink-2); font-size: 13px; font-weight: 600;
  text-decoration: none; transition: all .15s; cursor: pointer;
}
.pdf-link:hover { border-color: var(--amber); color: var(--amber); background: var(--amber-lt); }

/* Speaking area */
.speaking-area { margin-top: 28px; animation: fadeUp .5s var(--ease) .15s both; }
.speaking-area-title {
  display: flex; align-items: center; gap: 10px;
  font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: var(--ink-3);
  margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1.5px solid var(--line);
}
.speaking-area-title::before { content: ''; display: block; width: 3px; height: 18px; background: var(--primary); border-radius: 2px; }

.topic-card {
  background: var(--surface); border: 1.5px solid var(--line);
  border-radius: var(--r-lg); margin-bottom: 14px; overflow: hidden;
  box-shadow: var(--shadow-xs); transition: box-shadow .2s, border-color .2s;
}
.topic-card:hover { box-shadow: var(--shadow-sm); border-color: #fca5a5; }
.topic-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 18px; background: var(--surface-2); border-bottom: 1.5px solid var(--line);
}
.topic-left { display: flex; align-items: center; gap: 10px; }
.topic-icon { width: 32px; height: 32px; border-radius: var(--r-sm); background: var(--teal-lt); color: var(--teal); display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
.topic-title { font-size: 14px; font-weight: 700; color: var(--ink); }
.topic-sub   { font-size: 11px; color: var(--ink-3); margin-top: 1px; }
.part-chip { font-size: 10px; font-weight: 800; font-family: var(--font-mono); padding: 3px 9px; border-radius: 5px; text-transform: uppercase; letter-spacing: .05em; flex-shrink: 0; }
.part1 { background: var(--emerald-lt); color: var(--emerald); border: 1px solid #a7f3d0; }
.part2 { background: var(--amber-lt);   color: var(--amber);   border: 1px solid #fde68a; }
.part3 { background: var(--primary-lt); color: var(--primary); border: 1px solid #fca5a5; }

.question-row { padding: 16px 18px; border-bottom: 1px solid var(--line); }
.question-row:last-child { border-bottom: none; }
.q-number {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--primary-lt); color: var(--primary);
  font-size: 10px; font-weight: 800; font-family: var(--font-mono);
  margin-right: 8px; flex-shrink: 0; vertical-align: middle;
}
.q-text { font-size: 14.5px; font-weight: 500; color: var(--ink); line-height: 1.6; margin-bottom: 12px; }
.cue-card { background: var(--amber-lt); border: 1.5px solid #fde68a; border-radius: var(--r-md); padding: 13px 15px; margin-bottom: 12px; }
.cue-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--amber); margin-bottom: 5px; }
.cue-text  { font-size: 13px; color: var(--ink-2); line-height: 1.65; white-space: pre-line; }
.q-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
.meta-pill { font-size: 11px; font-weight: 600; font-family: var(--font-mono); padding: 3px 10px; border-radius: 20px; }
.meta-prep  { background: var(--primary-lt); color: var(--primary); border: 1px solid #fca5a5; }
.meta-speak { background: var(--teal-lt);    color: var(--teal);    border: 1px solid #99f6e4; }
.q-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
.btn-start-speaking {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 9px 18px; background: var(--primary); color: #fff;
  font-size: 13px; font-weight: 700; border-radius: var(--r-md);
  border: none; cursor: pointer; transition: all .2s var(--ease);
  box-shadow: 0 2px 8px var(--primary-glow); font-family: var(--font);
}
.btn-start-speaking:hover { background: #b91c1c; transform: translateY(-1px); }
.chip-result {
  display: none; align-items: center; gap: 6px;
  font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 20px;
  background: var(--emerald-lt); color: var(--emerald); border: 1.5px solid #a7f3d0;
  cursor: pointer; transition: background .15s;
}
.chip-result:hover { background: #d1fae5; }
.chip-result.visible { display: inline-flex; }

/* Sidebar */
.sidebar-card { background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--r-lg); margin-bottom: 16px; box-shadow: var(--shadow-xs); overflow: hidden; animation: fadeUp .45s var(--ease) both; }
.sidebar-card-head { padding: 13px 18px; border-bottom: 1.5px solid var(--line); background: var(--surface-2); }
.sidebar-card-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); }
.sidebar-card-body { padding: 16px 18px; }
.teacher-full { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
.teacher-full-avatar { width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary-lt); }
.teacher-full-ph { width: 68px; height: 68px; border-radius: 50%; background: var(--primary-lt); display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 26px; font-style: italic; color: var(--primary); }
.teacher-full-name { font-size: 14px; font-weight: 800; color: var(--ink); letter-spacing: -.01em; }
.teacher-full-tag  { font-size: 11px; font-weight: 700; color: var(--teal); background: var(--teal-lt); padding: 3px 10px; border-radius: 20px; display: inline-block; }
.teacher-full-bio  { font-size: 12.5px; color: var(--ink-3); line-height: 1.6; margin-top: 4px; }
.outline-list { list-style: none; }
.outline-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 13px; color: var(--ink-2); font-weight: 500; cursor: pointer; transition: color .15s; }
.outline-item:last-child { border-bottom: none; }
.outline-item:hover { color: var(--primary); }
.outline-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--primary-lt); border: 1.5px solid #fca5a5; flex-shrink: 0; }
.outline-item:hover .outline-dot { background: var(--primary); }

/* ═══════════════════════════════════════════
   PDF LIGHTBOX
═══════════════════════════════════════════ */
.pdf-lightbox {
  position: fixed; inset: 0; z-index: 10000;
  display: none; align-items: center; justify-content: center; padding: 16px;
}
.pdf-lightbox.open { display: flex; }
.pdf-lightbox-bg { position: absolute; inset: 0; background: rgba(13,14,20,.72); backdrop-filter: blur(6px); }
.pdf-lightbox-box {
  position: relative; z-index: 1; background: var(--surface);
  border-radius: var(--r-xl); box-shadow: var(--shadow-lg);
  width: 100%; max-width: 900px; height: 90vh;
  display: flex; flex-direction: column; overflow: hidden;
  animation: slideUp .25s var(--ease);
}
.pdf-lightbox-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 20px; border-bottom: 1.5px solid var(--line);
  background: var(--surface-2); flex-shrink: 0;
}
.pdf-lightbox-title { font-size: 14px; font-weight: 700; color: var(--ink); }
.pdf-lightbox-close {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--surface); border: 1.5px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--ink-3); transition: all .15s;
}
.pdf-lightbox-close:hover { background: var(--rose-lt); color: var(--rose); }
.pdf-lightbox-body { flex: 1; overflow: hidden; }
.pdf-lightbox-body iframe { width: 100%; height: 100%; border: none; display: block; }

/* ═══════════════════════════════════════════
   SPEAKING MODAL
═══════════════════════════════════════════ */
.modal-overlay {
  position: fixed; inset: 0; z-index: 9999;
  display: none; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.open { display: flex; }
.modal-bg { position: absolute; inset: 0; background: rgba(13,14,20,.55); backdrop-filter: blur(6px); }
.modal-box {
  position: relative; z-index: 1; background: var(--surface);
  border: 1.5px solid var(--line); border-radius: var(--r-xl);
  box-shadow: var(--shadow-lg); max-width: 540px; width: 100%;
  max-height: 92vh; overflow-y: auto;
  animation: slideUp .25s var(--ease);
}
.modal-header { display: flex; align-items: flex-start; justify-content: space-between; padding: 20px 24px 16px; border-bottom: 1.5px solid var(--line); }
.modal-q-text { font-size: 15px; font-weight: 600; color: var(--ink); line-height: 1.5; padding-right: 12px; flex: 1; }
.modal-close {
  width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
  background: var(--surface-2); border: 1.5px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--ink-3); transition: all .15s;
}
.modal-close:hover { background: var(--rose-lt); color: var(--rose); border-color: #fecdd3; }
.modal-body { padding: 20px 24px; }
.phase-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.phase-badge { font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px; border: 1.5px solid var(--line); color: var(--ink-3); background: var(--surface-2); }
.phase-badge.prep  { background: var(--primary-lt); color: var(--primary); border-color: #fca5a5; }
.phase-badge.speak { background: var(--rose-lt);    color: var(--rose);    border-color: #fecdd3; }
.phase-badge.done  { background: var(--emerald-lt); color: var(--emerald); border-color: #a7f3d0; }
.phase-badge.eval  { background: var(--amber-lt);   color: var(--amber);   border-color: #fde68a; }
.timer-display { font-family: var(--font-mono); font-size: 28px; font-weight: 700; color: var(--ink); letter-spacing: -1px; }
.timer-track { height: 5px; background: var(--line); border-radius: 3px; overflow: hidden; margin-bottom: 16px; }
.timer-fill  { height: 100%; background: var(--primary); border-radius: 3px; width: 100%; transition: width 1s linear, background .3s; }
.timer-fill.speaking { background: var(--rose); }
.waveform { display: flex; align-items: center; justify-content: center; gap: 3px; height: 36px; margin-bottom: 14px; opacity: 0; transition: opacity .3s; }
.waveform.active { opacity: 1; }
.wf-bar { width: 3px; border-radius: 2px; background: var(--rose); animation: wave .7s ease-in-out infinite; }
.transcript-box { background: var(--surface-2); border: 1.5px solid var(--line); border-radius: var(--r-md); padding: 14px; margin-bottom: 16px; }
.transcript-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin-bottom: 8px; }
.transcript-content { font-size: 14px; line-height: 1.75; color: var(--ink-2); max-height: 140px; overflow-y: auto; word-wrap: break-word; white-space: pre-wrap; scroll-behavior: smooth; }
.transcript-content::-webkit-scrollbar { width: 4px; }
.transcript-content::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }
.t-placeholder { color: var(--ink-3); font-style: italic; }
.t-interim     { color: var(--ink-3); font-style: italic; }
.result-panel { display: none; }
.result-panel.visible { display: block; animation: fadeUp .3s var(--ease); }
.result-overall { text-align: center; padding: 16px; background: var(--emerald-lt); border: 1.5px solid #a7f3d0; border-radius: var(--r-md); margin-bottom: 12px; }
.result-band-num   { font-family: var(--font-mono); font-size: 40px; font-weight: 700; color: var(--emerald); line-height: 1; }
.result-band-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--emerald); margin-top: 4px; }
.result-scores { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
.score-item  { background: var(--surface-2); border: 1.5px solid var(--line); border-radius: var(--r-sm); padding: 10px 12px; }
.score-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-3); margin-bottom: 3px; }
.score-val   { font-family: var(--font-mono); font-size: 20px; font-weight: 700; color: var(--ink); }
.result-feedback { background: var(--surface-2); border: 1.5px solid var(--line); border-left: 3px solid var(--primary); border-radius: 0 var(--r-sm) var(--r-sm) 0; padding: 12px 14px; font-size: 13.5px; line-height: 1.7; color: var(--ink-2); }
.status-msg { padding: 10px 13px; border-radius: var(--r-sm); font-size: 13px; font-weight: 500; margin-bottom: 12px; display: none; }
.status-msg.info    { background: var(--primary-lt); color: var(--primary); border: 1px solid #fca5a5; display: block; }
.status-msg.success { background: var(--emerald-lt); color: var(--emerald); border: 1px solid #a7f3d0; display: block; }
.status-msg.warn    { background: var(--amber-lt);   color: var(--amber);   border: 1px solid #fde68a; display: block; }
.status-msg.error   { background: var(--rose-lt);    color: var(--rose);    border: 1px solid #fecdd3; display: block; }
.modal-footer { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px 24px; border-top: 1.5px solid var(--line); background: var(--surface-2); border-radius: 0 0 var(--r-xl) var(--r-xl); }
.mbtn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: var(--r-sm); border: none; font-family: var(--font); font-size: 13px; font-weight: 700; cursor: pointer; transition: all .2s var(--ease); white-space: nowrap; }
.mbtn:disabled { opacity: .4; cursor: not-allowed; }
.mbtn.hidden   { display: none !important; }
.mbtn-primary { background: var(--primary); color: #fff; box-shadow: 0 2px 8px var(--primary-glow); }
.mbtn-primary:hover:not(:disabled) { background: #b91c1c; }
.mbtn-danger  { background: var(--rose-lt); color: var(--rose); border: 1.5px solid #fecdd3; }
.mbtn-danger:hover:not(:disabled)  { background: #ffe4e6; }
.mbtn-ghost   { background: transparent; color: var(--ink-3); border: 1.5px solid var(--line); }
.mbtn-ghost:hover:not(:disabled)   { border-color: var(--ink-3); color: var(--ink-2); background: var(--surface-2); }
.mbtn-success { background: var(--emerald); color: #fff; }
.mbtn-success:hover:not(:disabled) { background: #047857; }

/* ═══════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════ */
@media (max-width: 980px) {
  .course-hero-inner { grid-template-columns: 1fr; }
  .lms-layout { grid-template-columns: 1fr; }
  .lms-sidebar { position: static; }
}
@media (max-width: 640px) {
  .course-hero-inner, .lms-layout { padding-left: 20px; padding-right: 20px; }
}
</style>

<!-- ═══════ COURSE HERO ═══════ -->
<section class="course-hero">
  <% if @course.thumbnail.attached? %>
    <div class="course-hero-bg" style="background-image:url('<%= url_for(@course.thumbnail) %>')"></div>
  <% else %>
    <div class="course-hero-bg no-image"></div>
  <% end %>

  <div class="course-hero-inner">
    <!-- LEFT -->
    <div>
      <nav class="breadcrumb">
        <a href="<%= students_dashboard_path %>">Home</a>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="<%= students_courses_path %>">Courses</a>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        <span><%= @course.title.truncate(30) %></span>
      </nav>

      <% if @course.band_min.present? && @course.band_max.present? %>
        <div class="course-hero-eyebrow">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Band <%= @course.band_min %> – <%= @course.band_max %> Course
        </div>
      <% end %>

      <h1 class="course-hero-title">
        <em><%= @course.title.split.first(2).join(' ') %></em>
        <% rest = @course.title.split.drop(2).join(' ') %>
        <%= " #{rest}" if rest.present? %>
      </h1>

      <% if @course.description.present? %>
        <p class="course-hero-desc"><%= @course.description %></p>
      <% end %>

      <div class="course-stats-row">
        <div class="stat-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <%= @sections.count %> Sections
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          <%= @sections.sum { |s| s.lessons.count } %> Lessons
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/></svg>
          Speaking Practice
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Self-paced
        </div>
      </div>

      <% teacher = @course.teacher_profile rescue nil %>
      <% if teacher %>
        <div class="teacher-mini">
          <% if teacher.avatar.attached? %>
            <%= image_tag teacher.avatar.variant(resize_to_fill: [34,34]), class: "teacher-mini-avatar", alt: teacher.full_name %>
          <% else %>
            <div class="teacher-mini-avatar-ph"><%= teacher.full_name[0] %></div>
          <% end %>
          <div>
            <div class="teacher-mini-name"><%= teacher.full_name %></div>
            <div class="teacher-mini-role"><%= teacher.expertise %> · <%= teacher.experience_years %> yrs exp</div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- RIGHT: enroll panel -->

  </div>
</section>

<!-- ═══════ MAIN LMS CONTENT ═══════ -->
<div class="lms-layout">

  <div class="lms-main">

    <!-- Progress -->
    <div class="progress-card">
      <div class="progress-card-head">
        <span class="progress-card-title">Your Progress</span>
        <span class="progress-pct">0%</span>
      </div>
      <div class="progress-track"><div class="progress-fill" style="width:0%"></div></div>
      <div class="progress-stats">
        <div class="pstat"><div class="pstat-num"><%= @sections.sum { |s| s.lessons.count } %></div><div class="pstat-label">Lessons</div></div>
        <div class="pstat"><div class="pstat-num"><%= @sections.sum { |s| s.lessons.sum { |l| l.speaking_topics.count rescue 0 } } %></div><div class="pstat-label">Topics</div></div>
        <div class="pstat"><div class="pstat-num">0</div><div class="pstat-label">Completed</div></div>
      </div>
    </div>

    <!-- Curriculum -->
    <% @sections.each_with_index do |section, si| %>
      <div class="section-group" style="animation-delay:<%= si * 0.06 %>s">
        <div class="section-header-bar <%= si == 0 ? 'open' : '' %>" onclick="toggleSection(this)">
          <div class="section-header-left">
            <div class="section-num"><%= si + 1 %></div>
            <div>
              <div class="section-name"><%= section.title %></div>
              <div class="section-count"><%= section.lessons.count %> lesson<%= section.lessons.count != 1 ? 's' : '' %></div>
            </div>
          </div>
          <svg class="section-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </div>

        <div class="section-body <%= si == 0 ? 'open' : '' %>">
          <div class="section-body-inner">
            <% section.lessons.each do |lesson| %>
              <%
                has_video = lesson.video.attached?
                has_pdfs  = lesson.pdfs.attached?
                has_content = has_video || has_pdfs
              %>
              <div class="lesson-item" id="lesson-item-<%= lesson.id %>">

                <div class="lesson-item-head" onclick="<%= has_content ? "toggleLesson(#{lesson.id})" : '' %>">
                  <div class="lesson-icon-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  </div>
                  <div class="lesson-info">
                    <div class="lesson-name"><%= lesson.title %></div>
                    <div class="lesson-meta">
                      <% if has_video %><span class="lesson-tag tag-video">📹 Video</span><% end %>
                      <% if has_pdfs  %><span class="lesson-tag tag-pdf">📄 PDF</span><% end %>
                      <% if lesson.speaking_topics.any? %><span class="lesson-tag tag-speaking">🎤 Speaking</span><% end %>
                      <% if lesson.duration.present? %><span class="lesson-tag tag-duration">⏱ <%= lesson.duration %>min</span><% end %>
                    </div>
                  </div>
                  <% if has_content %>
                    <svg class="lesson-expand-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                  <% end %>
                </div>

                <% if has_content %>
                  <div class="lesson-content" id="lesson-content-<%= lesson.id %>">
                    <div class="lesson-content-inner">
                      <div class="lesson-content-body">

                        <% if has_video %>
                          <div>
                            <div class="content-label">📹 Video Lesson</div>
                            <div class="video-player-wrap">
                              <video controls preload="none">
                                <source src="<%= url_for(lesson.video) %>" type="video/mp4">
                              </video>
                            </div>
                          </div>
                        <% end %>

                        <% if has_pdfs %>
                          <div>
                            <div class="content-label">📄 Lesson Materials</div>
                            <div class="pdf-list">
                              <% lesson.pdfs.each do |pdf| %>
                                <a class="pdf-link"
                                   href="<%= url_for(pdf) %>"
                                   onclick="openPdf(event, '<%= url_for(pdf) %>', '<%= pdf.filename %>')">
                                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/>
                                  </svg>
                                  <%= pdf.filename %>
                                </a>
                              <% end %>
                            </div>
                          </div>
                        <% end %>

                      </div>
                    </div>
                  </div>
                <% end %>

              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Speaking Practice -->
    <% all_topics = @sections.flat_map { |s| s.lessons.flat_map(&:speaking_topics) } %>
    <% if all_topics.any? %>
      <div class="speaking-area">
        <div class="speaking-area-title">Speaking Practice</div>
        <% @sections.each do |section| %>
          <% section.lessons.each do |lesson| %>
            <% lesson.speaking_topics.each do |topic| %>
              <div class="topic-card" id="topic-<%= topic.id %>">
                <div class="topic-head">
                  <div class="topic-left">
                    <div class="topic-icon">🎤</div>
                    <div>
                      <div class="topic-title"><%= topic.title %></div>
                      <div class="topic-sub"><%= lesson.title %> · <%= section.title %></div>
                    </div>
                  </div>
                  <span class="part-chip <%= topic.part %>"><%= topic.part.upcase %></span>
                </div>
                <% topic.speaking_questions.each_with_index do |q, qi| %>
                  <div class="question-row" id="qrow-<%= q.id %>">
                    <p class="q-text">
                      <span class="q-number"><%= qi + 1 %></span>
                      <%= q.question_text %>
                    </p>
                    <% if q.cue_card.present? %>
                      <div class="cue-card">
                        <p class="cue-label">📋 Cue Card</p>
                        <p class="cue-text"><%= q.cue_card %></p>
                      </div>
                    <% end %>
                    <div class="q-meta">
                      <% if q.preparation_time.present? %><span class="meta-pill meta-prep">⏱ Prep <%= q.preparation_time %>s</span><% end %>
                      <% if q.speaking_time.present? %><span class="meta-pill meta-speak">🎤 Speaking <%= q.speaking_time %>s</span><% end %>
                    </div>
                    <div class="q-footer">
                      <button class="btn-start-speaking open-modal-btn"
                        data-prep="<%= q.preparation_time || 60 %>"
                        data-speak="<%= q.speaking_time || 120 %>"
                        data-topic="<%= topic.id %>"
                        data-course="<%= @course.id %>"
                        data-part="<%= topic.part %>"
                        data-question="<%= q.question_text %>"
                        data-qid="<%= q.id %>">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/></svg>
                        Start Speaking
                      </button>
                      <span class="chip-result" id="chip-<%= q.id %>" onclick="showPrevResult('<%= q.id %>')">
                        <svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                        View last result
                      </span>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

  </div>

  <!-- SIDEBAR -->
  <div class="lms-sidebar">
    <% teacher = @course.teacher_profile rescue nil %>
    <% if teacher %>
      <div class="sidebar-card" style="animation-delay:.05s">
        <div class="sidebar-card-head"><div class="sidebar-card-title">Your Instructor</div></div>
        <div class="sidebar-card-body">
          <div class="teacher-full">
            <% if teacher.avatar.attached? %>
              <%= image_tag teacher.avatar.variant(resize_to_fill: [68,68]), class: "teacher-full-avatar", alt: teacher.full_name %>
            <% else %>
              <div class="teacher-full-ph"><%= teacher.full_name[0] %></div>
            <% end %>
            <div class="teacher-full-name"><%= teacher.full_name.upcase %></div>
            <span class="teacher-full-tag"><%= teacher.expertise %></span>
            <% if teacher.bio.present? %><p class="teacher-full-bio"><%= teacher.bio.truncate(120) %></p><% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="sidebar-card" style="animation-delay:.10s">
      <div class="sidebar-card-head"><div class="sidebar-card-title">Course Outline</div></div>
      <div class="sidebar-card-body" style="padding-top:8px;padding-bottom:8px;">
        <ul class="outline-list">
          <% @sections.each_with_index do |section, i| %>
            <li class="outline-item" onclick="document.querySelectorAll('.section-group')[<%= i %>]?.scrollIntoView({behavior:'smooth',block:'start'})">
              <div class="outline-dot"></div>
              <span><%= section.title %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="sidebar-card" style="animation-delay:.15s">
      <div class="sidebar-card-head"><div class="sidebar-card-title">What You'll Learn</div></div>
      <div class="sidebar-card-body">
        <% ["Master IELTS Speaking Parts 1, 2 & 3","AI-powered instant band score feedback","Build fluency with real exam topics","Improve grammar & vocabulary range","Confidence in pronunciation & delivery"].each do |pt| %>
          <div class="include-item" style="margin-bottom:8px">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
            <span style="font-size:13px;color:var(--ink-2);font-weight:500"><%= pt %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

</div>

<!-- ═══════ PDF LIGHTBOX ═══════ -->
<div class="pdf-lightbox" id="pdf-lightbox">
  <div class="pdf-lightbox-bg" onclick="closePdf()"></div>
  <div class="pdf-lightbox-box">
    <div class="pdf-lightbox-header">
      <span class="pdf-lightbox-title" id="pdf-lightbox-title">Document</span>
      <button class="pdf-lightbox-close" onclick="closePdf()">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="pdf-lightbox-body">
      <iframe id="pdf-frame" src="" title="PDF Viewer"></iframe>
    </div>
  </div>
</div>

<!-- ═══════ SPEAKING MODAL ═══════ -->
<div class="modal-overlay" id="speaking-modal">
  <div class="modal-bg" onclick="closeModal()"></div>
  <div class="modal-box">
    <div class="modal-header">
      <p class="modal-q-text" id="modal-question-text">Question</p>
      <button class="modal-close" id="modal-close-btn">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div class="phase-row">
        <span class="phase-badge" id="phase-badge">Ready</span>
        <span class="timer-display" id="timer-display">—</span>
      </div>
      <div class="timer-track"><div class="timer-fill" id="timer-fill" style="width:100%"></div></div>
      <div class="waveform" id="waveform">
        <% 18.times do |i| %><div class="wf-bar" style="animation-delay:<%= i * 0.045 %>s"></div><% end %>
      </div>
      <div class="transcript-box">
        <div class="transcript-label">Live Transcript</div>
        <div class="transcript-content" id="transcript-content">
          <span class="t-placeholder">Your words will appear here as you speak…</span>
        </div>
      </div>
      <div class="result-panel" id="result-panel">
        <div class="result-overall">
          <div class="result-band-num" id="res-overall">—</div>
          <div class="result-band-label">Overall Band Score</div>
        </div>
        <div class="result-scores">
          <div class="score-item"><div class="score-label">Fluency</div><div class="score-val" id="res-fluency">—</div></div>
          <div class="score-item"><div class="score-label">Lexical Resource</div><div class="score-val" id="res-lexical">—</div></div>
          <div class="score-item"><div class="score-label">Grammar</div><div class="score-val" id="res-grammar">—</div></div>
          <div class="score-item"><div class="score-label">Pronunciation</div><div class="score-val" id="res-pronunciation">—</div></div>
        </div>
        <div class="result-feedback" id="res-feedback"></div>
      </div>
      <div class="status-msg" id="status-msg"></div>
    </div>
    <div class="modal-footer">
      <button class="mbtn mbtn-primary"  id="btn-start">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/></svg>
        Begin Session
      </button>
      <button class="mbtn mbtn-danger  hidden" id="btn-done">Stop &amp; Submit</button>
      <button class="mbtn mbtn-ghost   hidden" id="btn-rerecord">Re-record</button>
      <button class="mbtn mbtn-success hidden" id="btn-submit">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
        Submit
      </button>
      <button class="mbtn mbtn-ghost   hidden" id="btn-retry">↩ Try Again</button>
    </div>
  </div>
</div>
<%= render "chat_widget", course: @course %>
<script>
/* ══════════ ACCORDION ══════════ */
function toggleSection(el) {
  el.classList.toggle('open');
  el.nextElementSibling.classList.toggle('open');
}
function toggleLesson(id) {
  const item    = document.getElementById('lesson-item-' + id);
  const content = document.getElementById('lesson-content-' + id);
  if (!content) return;
  item.classList.toggle('open');
  content.classList.toggle('open');
}

/* ══════════ PDF LIGHTBOX ══════════ */
function openPdf(e, url, name) {
  e.preventDefault();
  document.getElementById('pdf-lightbox-title').textContent = name;
  document.getElementById('pdf-frame').src = url;
  document.getElementById('pdf-lightbox').classList.add('open');
}
function closePdf() {
  document.getElementById('pdf-lightbox').classList.remove('open');
  document.getElementById('pdf-frame').src = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') { closePdf(); closeModal(); } });

/* ══════════ SPEAKING MODAL ══════════ */
const log  = (m, d) => d !== undefined ? console.log('[Speaking]', m, d) : console.log('[Speaking]', m);
const logE = (m, e) => console.error('[Speaking] ❌', m, e || '');

let mediaRecorder, audioChunks = [];
let recognition, finalTranscript = '', interimTranscript = '';
let currentData = {}, currentQid = null;
let currentPhase = 'idle';

/* Prep timer state */
let prepInterval  = null;
let resolvePrep   = null;

/* Speaking timer state — SHARED across re-records
   speakTotal    : set once when session begins
   speakRemaining: counts down, never reset by re-record
   speakInterval : single interval, never cleared by re-record
   resolveSpeakDone: resolves the startSpeakTimer() promise when time hits 0
*/
let speakTotal         = 0;
let speakRemaining     = 0;
let speakInterval      = null;
let resolveSpeakDone   = null;

let audioContext = null, analyser = null, monitorAudioInterval = null;
let userManuallyScrolled = false;
const resultCache = {};

const modal        = document.getElementById('speaking-modal');
const modalQText   = document.getElementById('modal-question-text');
const phaseBadge   = document.getElementById('phase-badge');
const timerDisp    = document.getElementById('timer-display');
const timerFill    = document.getElementById('timer-fill');
const waveform     = document.getElementById('waveform');
const transcriptEl = document.getElementById('transcript-content');
const resultPanel  = document.getElementById('result-panel');
const statusMsg    = document.getElementById('status-msg');
const btnStart     = document.getElementById('btn-start');
const btnDone      = document.getElementById('btn-done');
const btnRerecord  = document.getElementById('btn-rerecord');
const btnSubmit    = document.getElementById('btn-submit');
const btnRetry     = document.getElementById('btn-retry');

/* ── Open ── */
document.querySelectorAll('.open-modal-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    currentData = {
      prep: parseInt(btn.dataset.prep), speak: parseInt(btn.dataset.speak),
      topic: btn.dataset.topic, course: btn.dataset.course,
      part: btn.dataset.part, question: btn.dataset.question
    };
    currentQid = btn.dataset.qid;
    modalQText.textContent = btn.dataset.question;
    resetModal();
    if (resultCache[currentQid]) showResult(resultCache[currentQid]);
    modal.classList.add('open');
  });
});
document.getElementById('modal-close-btn').addEventListener('click', closeModal);
modal.addEventListener('click', e => { if (e.target === modal || e.target.classList.contains('modal-bg')) closeModal(); });

function closeModal() {
  if (currentPhase === 'speaking' || currentPhase === 'prep') {
    stopRecording(); stopRecognition();
    clearInterval(prepInterval); clearInterval(speakInterval); clearInterval(monitorAudioInterval);
    resolvePrep = null; resolveSpeakDone = null;
  }
  currentPhase = 'idle';
  modal.classList.remove('open');
}

function resetModal() {
  finalTranscript = ''; interimTranscript = '';
  currentPhase = 'idle';
  resolvePrep = null; resolveSpeakDone = null;
  speakTotal = 0; speakRemaining = 0;
  userManuallyScrolled = false;
  clearInterval(prepInterval); clearInterval(speakInterval); clearInterval(monitorAudioInterval);
  transcriptEl.innerHTML = '<span class="t-placeholder">Your words will appear here as you speak…</span>';
  resultPanel.classList.remove('visible');
  statusMsg.className = 'status-msg'; statusMsg.textContent = '';
  setPhaseBadge('Ready', '');
  timerDisp.textContent = '—'; timerFill.style.width = '100%';
  timerFill.classList.remove('speaking'); waveform.classList.remove('active');
  btnStart.classList.remove('hidden'); btnStart.disabled = false; btnStart.textContent = 'Begin Session';
  [btnDone, btnRerecord, btnSubmit, btnRetry].forEach(b => b.classList.add('hidden'));
}

function setPhaseBadge(text, cls) {
  phaseBadge.textContent = text;
  phaseBadge.className = 'phase-badge' + (cls ? ' ' + cls : '');
}

/* ── Prep timer (runs once per session) ── */
function runPrepTimer(seconds) {
  return new Promise(resolve => {
    let rem = seconds;
    setPhaseBadge('Preparation', 'prep');
    timerFill.className = 'timer-fill';
    timerDisp.textContent = rem; timerFill.style.width = '100%';
    resolvePrep = () => { clearInterval(prepInterval); resolve(); };
    clearInterval(prepInterval);
    prepInterval = setInterval(() => {
      rem--;
      timerDisp.textContent = rem;
      timerFill.style.width = (rem / seconds * 100) + '%';
      if (rem <= 0) { clearInterval(prepInterval); resolvePrep = null; resolve(); }
    }, 1000);
  });
}

/* ── Speaking timer — starts ONE interval for the whole session.
      Re-record does NOT touch this interval at all.
      Returns a Promise that resolves when speakRemaining hits 0. ── */
function startSpeakTimer() {
  return new Promise(resolve => {
    setPhaseBadge('Speaking', 'speak');
    timerFill.className = 'timer-fill speaking';
    timerDisp.textContent = speakRemaining;
    timerFill.style.width = (speakRemaining / speakTotal * 100) + '%';

    resolveSpeakDone = () => { clearInterval(speakInterval); resolve(); };
    clearInterval(speakInterval);
    speakInterval = setInterval(() => {
      speakRemaining--;
      timerDisp.textContent = speakRemaining;
      timerFill.style.width = Math.max(0, speakRemaining / speakTotal * 100) + '%';
      if (speakRemaining <= 0) {
        clearInterval(speakInterval); resolveSpeakDone = null; resolve();
      }
    }, 1000);
  });
}

/* Audio helpers */
function startRecognition() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { showStatus('error', '🎙️ Browser không hỗ trợ Speech Recognition'); return; }
  recognition = new SR();
  recognition.continuous = true; recognition.interimResults = true; recognition.lang = 'en-US';
  recognition.onstart  = () => showStatus('info', '🎤 Listening… Speak now!');
  recognition.onerror  = e => { if (currentPhase === 'speaking') showStatus('error', `❌ Mic error: ${e.error}`); };
  recognition.onend    = () => {
    /* Auto-restart recognition if still in speaking phase (browser sometimes stops it) */
    if (currentPhase === 'speaking') { try { recognition.start(); } catch(e) {} }
  };
  recognition.onresult = event => {
    interimTranscript = '';
    for (let i = event.resultIndex; i < event.results.length; i++) {
      const t = event.results[i][0].transcript;
      if (event.results[i].isFinal) finalTranscript += t + ' ';
      else interimTranscript += t;
    }
    transcriptEl.innerHTML =
      '<span>' + finalTranscript + '</span>' +
      '<span class="t-interim">' + interimTranscript + '</span>';
    if (!userManuallyScrolled) transcriptEl.scrollTop = transcriptEl.scrollHeight;
  };
  transcriptEl.addEventListener('scroll', () => {
    userManuallyScrolled = !(transcriptEl.scrollTop + transcriptEl.clientHeight >= transcriptEl.scrollHeight - 10);
  }, { passive: true });
  try { recognition.start(); } catch(e) { showStatus('error', '❌ Cannot start microphone'); }
}

function stopRecognition() { try { if (recognition) { recognition.onend = null; recognition.stop(); } } catch(e) {} }

async function startRecording() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    if (audioContext) try { audioContext.close(); } catch(e) {}
    audioContext = new (window.AudioContext || window.webkitAudioContext)();
    analyser = audioContext.createAnalyser();
    audioContext.createMediaStreamSource(stream).connect(analyser);
    analyser.fftSize = 256;
    const dataArray = new Uint8Array(analyser.frequencyBinCount);
    clearInterval(monitorAudioInterval);
    monitorAudioInterval = setInterval(() => {
      analyser.getByteFrequencyData(dataArray);
      waveform.classList.toggle('active', dataArray.reduce((a,b)=>a+b)/dataArray.length > 10);
    }, 100);
    audioChunks = [];
    mediaRecorder = new MediaRecorder(stream);
    mediaRecorder.ondataavailable = e => { if (e.data.size > 0) audioChunks.push(e.data); };
    mediaRecorder.start(200); /* timeslice so data accumulates incrementally */
    mediaRecorder.onstop = () => { clearInterval(monitorAudioInterval); try { audioContext.close(); } catch(e) {} };
    return true;
  } catch(err) {
    const msgs = { NotAllowedError: 'Microphone permission denied', NotFoundError: 'Microphone not found' };
    showStatus('error', '❌ ' + (msgs[err.name] || err.message));
    return false;
  }
}

function stopRecording() {
  return new Promise(resolve => {
    if (!mediaRecorder || mediaRecorder.state === 'inactive') { resolve(null); return; }
    mediaRecorder.onstop = () => {
      const blob = new Blob(audioChunks, { type: 'audio/webm' });
      audioChunks = []; resolve(blob);
    };
    try { mediaRecorder.stop(); mediaRecorder.stream.getTracks().forEach(t => t.stop()); } catch(e) { resolve(null); }
  });
}

async function uploadAttempt(audioBlob) {
  const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
  const form = new FormData();
  form.append('audio',             audioBlob, 'recording.webm');
  form.append('transcript',        finalTranscript.trim());
  form.append('speaking_topic_id', currentData.topic);
  form.append('course_id',         currentData.course);
  form.append('part',              currentData.part);
  const res  = await fetch('/students/speaking_attempts', {
    method: 'POST', headers: csrf ? { 'X-CSRF-Token': csrf } : {}, body: form
  });
  const text = await res.text();
  if (!res.ok) throw new Error(`Server ${res.status}: ${text}`);
  return JSON.parse(text);
}

async function finishSpeaking() {
  if (currentPhase !== 'speaking') return;
  currentPhase = 'uploading';
  [btnDone, btnRerecord, btnSubmit].forEach(b => b.classList.add('hidden'));
  waveform.classList.remove('active');
  stopRecognition();
  clearInterval(speakInterval);
  if (resolveSpeakDone) { resolveSpeakDone(); resolveSpeakDone = null; }
  setPhaseBadge('Evaluating…', 'eval');
  timerDisp.textContent = '—';
  showStatus('warn', '⏳ AI is evaluating… You can close this window and come back later.');
  const audioBlob = await stopRecording();
  if (!audioBlob || audioBlob.size === 0) { showStatus('error', 'Recording is empty. Try again.'); showRetryBtn(); return; }
  try {
    const result = await uploadAttempt(audioBlob);
    resultCache[currentQid] = result;
    showResult(result);
    const chip = document.getElementById('chip-' + currentQid);
    if (chip) chip.classList.add('visible');
  } catch(err) {
    showStatus('error', 'Upload failed: ' + err.message); showRetryBtn();
  }
}

function showResult(result) {
  currentPhase = 'done';
  document.getElementById('res-overall').textContent       = result.overall       ?? '—';
  document.getElementById('res-fluency').textContent       = result.fluency       ?? '—';
  document.getElementById('res-lexical').textContent       = result.lexical       ?? '—';
  document.getElementById('res-grammar').textContent       = result.grammar       ?? '—';
  document.getElementById('res-pronunciation').textContent = result.pronunciation ?? '—';
  document.getElementById('res-feedback').textContent      = result.feedback      ?? '';
  resultPanel.classList.add('visible');
  setPhaseBadge('Completed', 'done');
  showStatus('success', 'Evaluation complete!');
  showRetryBtn();
}

function showRetryBtn() {
  [btnStart, btnDone, btnRerecord, btnSubmit].forEach(b => b.classList.add('hidden'));
  btnRetry.classList.remove('hidden');
}

function showPrevResult(qid) { document.querySelector(`[data-qid="${qid}"]`)?.click(); }

function showStatus(type, msg) { statusMsg.className = 'status-msg ' + type; statusMsg.textContent = msg; }

/* ── BEGIN SESSION ── */
btnStart.addEventListener('click', async () => {
  btnStart.disabled = true; btnStart.textContent = 'Starting…';
  currentPhase = 'prep';
  showStatus('info', 'Preparation phase. Read the question carefully !');
  await runPrepTimer(currentData.prep);
  if (currentPhase !== 'prep') return;

  const ok = await startRecording();
  if (!ok) { btnStart.disabled = false; btnStart.textContent = 'Begin Session'; currentPhase = 'idle'; return; }
  startRecognition();

  /* Initialise speaking timer ONCE */
  speakTotal     = currentData.speak;
  speakRemaining = currentData.speak;
  currentPhase   = 'speaking';

  btnStart.classList.add('hidden');
  btnDone.classList.remove('hidden');
  btnRerecord.classList.remove('hidden');
  showStatus('info', '🔴 Recording… "Stop & Submit" to finish early, "Re-record" to restart mic.');

  /* Start the single speaking countdown */
  await startSpeakTimer();

  /* Only reached when time runs out naturally */
  if (currentPhase === 'speaking') {
    btnDone.classList.add('hidden');
    btnRerecord.classList.remove('hidden'); /* still allow re-record even after time! */
    btnSubmit.classList.remove('hidden');
    showStatus('warn', '⏱️ Time up! Click "Submit" to send, or "Re-record" for one more take.');
  }
});

/* ── STOP & SUBMIT ── */
btnDone.addEventListener('click', () => finishSpeaking());

/* ── SUBMIT (after time-up) ── */
btnSubmit.addEventListener('click', () => finishSpeaking());

/* ── RE-RECORD
     3. Stops mic & recognition, clears transcript, restarts mic.
        The speaking countdown (speakInterval) is NOT touched — it keeps running.
        User can re-record as many times as they want until time hits 0.
── */
btnRerecord.addEventListener('click', async () => {
  if (currentPhase !== 'speaking') return;
  log('Re-record requested, remaining:', speakRemaining);

  /* Temporarily hide action buttons while mic restarts */
  btnDone.classList.add('hidden');
  btnRerecord.classList.add('hidden');
  btnSubmit.classList.add('hidden');

  /* Stop previous mic & recognition (do NOT clear speakInterval!) */
  stopRecognition();
  await stopRecording();
  waveform.classList.remove('active');

  /* Clear transcript for fresh take */
  finalTranscript = ''; interimTranscript = '';
  transcriptEl.innerHTML = '<span class="t-placeholder">Your words will appear here as you speak…</span>';

  /* If time ran out during the mic switch */
  if (speakRemaining <= 0) {
    btnSubmit.classList.remove('hidden');
    btnRerecord.classList.remove('hidden');
    showStatus('warn', '⏱️ Time up! Submit or try again.');
    return;
  }

  showStatus('info', '🔄 Restarting mic… timer still running!');

  const ok = await startRecording();
  if (!ok) {
    /* Mic failed, restore buttons so user isn't stuck */
    btnDone.classList.remove('hidden');
    btnRerecord.classList.remove('hidden');
    return;
  }
  startRecognition();

  /* Restore appropriate buttons based on whether time is still left */
  if (speakRemaining > 0) {
    btnDone.classList.remove('hidden');
    btnRerecord.classList.remove('hidden');
    showStatus('info', '🔴 Recording again… timer still running.');
  } else {
    btnSubmit.classList.remove('hidden');
    btnRerecord.classList.remove('hidden');
    showStatus('warn', '⏱️ Time up! Submit or re-record again.');
  }
});

/* ── TRY AGAIN — full reset, new session ── */
btnRetry.addEventListener('click', () => {
  stopRecording(); stopRecognition();
  clearInterval(prepInterval); clearInterval(speakInterval); clearInterval(monitorAudioInterval);
  resetModal();
});
</script>
