<%= render "students/shared/navbar" %>

<div class="pt-28 pb-20 bg-slate-100 min-h-screen">

<div class="max-w-6xl mx-auto px-6">

<!-- COURSE HEADER -->
<div class="mb-12">
  <h1 class="text-4xl font-bold text-slate-900 mb-3">
    <%= @course.title %>
  </h1>

  <% if @course.description.present? %>
    <p class="text-slate-600 max-w-3xl">
      <%= @course.description %>
    </p>
  <% end %>
</div>

<!-- SECTIONS -->
<% @sections.each do |section| %>

<div class="mb-14">

  <div class="flex items-center gap-3 mb-6">
    <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-indigo-600 text-white font-bold">
      📚
    </div>
    <h2 class="text-2xl font-semibold text-slate-800">
      <%= section.title %>
    </h2>
  </div>

  <!-- LESSONS -->
  <div class="space-y-8">

  <% section.lessons.each do |lesson| %>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-7">

    <!-- LESSON HEADER -->
    <div class="flex justify-between items-center mb-5">
      <h3 class="text-lg font-semibold text-slate-800">
        🎬 <%= lesson.title %>
      </h3>

      <% if lesson.duration.present? %>
        <span class="text-xs px-3 py-1 bg-slate-100 rounded-full text-slate-600">
          ⏱ <%= lesson.duration %> mins
        </span>
      <% end %>
    </div>

    <!-- VIDEO -->
    <% if lesson.video.attached? %>
      <div class="overflow-hidden rounded-xl border mb-6">
        <video controls class="w-full">
          <source src="<%= url_for(lesson.video) %>" type="video/mp4">
        </video>
      </div>
    <% end %>

    <!-- PDF MATERIALS -->
    <% if lesson.pdfs.attached? %>
      <div class="mb-6">
        <p class="font-semibold text-slate-700 mb-3">
          📄 Lesson Materials
        </p>

        <div class="flex flex-wrap gap-3">
          <% lesson.pdfs.each do |pdf| %>
            <%= link_to pdf.filename,
                  url_for(pdf),
                  target: "_blank",
                  class:"px-4 py-2 rounded-lg bg-indigo-50
                         text-indigo-700 text-sm
                         hover:bg-indigo-100 transition
                         border border-indigo-200" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- SPEAKING -->
    <% if lesson.speaking_topics.any? %>

    <div class="mt-6 bg-slate-50 border rounded-2xl p-6">

      <h4 class="text-lg font-semibold text-slate-800 mb-6">
        🎤 Speaking Practice
      </h4>

      <div class="space-y-6">

      <% lesson.speaking_topics.each do |topic| %>

      <div class="bg-white border rounded-xl p-5 shadow-sm">

        <div class="flex justify-between items-center mb-4">

          <p class="font-semibold text-slate-800">
            <%= topic.title %>
          </p>

          <span class="px-3 py-1 text-xs rounded-full
                       bg-indigo-100 text-indigo-700 font-medium">
            <%= topic.part.upcase %>
          </span>

        </div>

        <!-- QUESTIONS -->
        <div class="space-y-5">

        <% topic.speaking_questions.each do |q| %>

        <div class="border-t pt-4">

          <p class="font-medium text-slate-700 mb-2">
            ❓ <%= q.question_text %>
          </p>

          <% if q.cue_card.present? %>
          <div class="bg-yellow-50 border border-yellow-200
                      rounded-xl p-4 text-sm text-slate-700 mb-3">
            <p class="font-semibold text-yellow-700 mb-1">
              📝 Cue Card
            </p>
            <p class="whitespace-pre-line">
              <%= q.cue_card %>
            </p>
          </div>
          <% end %>

          <div class="flex flex-wrap gap-3 text-xs">

            <% if q.preparation_time.present? %>
              <span class="px-3 py-1 rounded-full
                           bg-blue-50 text-blue-700
                           border border-blue-200">
                ⏱ Preparation: <b><%= q.preparation_time %> sec</b>
              </span>
            <% end %>

            <% if q.speaking_time.present? %>
              <span class="px-3 py-1 rounded-full
                           bg-emerald-50 text-emerald-700
                           border border-emerald-200">
                🎙 Speaking: <b><%= q.speaking_time %> sec</b>
              </span>
            <% end %>

          </div>

        </div>
        <div class="mt-4">

        <button
          class="start-speaking px-4 py-2 bg-indigo-600 text-white rounded-lg"
          data-prep="<%= q.preparation_time %>"
          data-speak="<%= q.speaking_time %>"
          data-topic="<%= topic.id %>"
          data-course="<%= @course.id %>"
          data-part="<%= topic.part %>">
      
          🎤 Start Speaking
        </button>
      
        <div class="timer-display mt-3 text-xl font-bold text-red-600"></div>
      
      </div>
      
        <% end %>

        </div>

      </div>

      <% end %>

      </div>

    </div>

    <% end %>

  </div>

  <% end %>

  </div>

</div>

<% end %>

</div>
</div>

<script>
let mediaRecorder;
let chunks = [];

async function startRecording() {
  const stream = await navigator.mediaDevices.getUserMedia({ audio: true });

  mediaRecorder = new MediaRecorder(stream);

  mediaRecorder.ondataavailable = e => {
    chunks.push(e.data);
  };

  mediaRecorder.start();
}

function stopRecording() {
  return new Promise(resolve => {

    mediaRecorder.onstop = () => {
      const blob = new Blob(chunks, { type: "audio/webm" });
      chunks = [];
      resolve(blob);
    };

    mediaRecorder.stop();
  });
}

function countdown(sec, el, label) {
  return new Promise(resolve => {

    let s = sec;

    const i = setInterval(() => {
      el.innerText = `${label}: ${s}s`;
      s--;

      if (s < 0) {
        clearInterval(i);
        resolve();
      }

    }, 1000);

  });
}

document.addEventListener("click", async e => {

  if (!e.target.classList.contains("start-speaking")) return;

  const btn = e.target;
  const timer = btn.parentElement.querySelector(".timer-display");

  btn.disabled = true;

  await countdown(btn.dataset.prep, timer, "🧠 Preparation");

  timer.innerText = "🎙 Time to complete your speaking task";

  await startRecording();

  await countdown(btn.dataset.speak, timer, "🎤 Speaking");

  const audioBlob = await stopRecording();

  timer.innerText = "⬆ Uploading...";

  const form = new FormData();

  form.append("audio", audioBlob);
  form.append("speaking_topic_id", btn.dataset.topic);
  form.append("course_id", btn.dataset.course);
  form.append("part", btn.dataset.part);

  await fetch("/students/speaking_attempts", {
    method: "POST",
    body: form
  });

  timer.innerText = "🤖 AI is evaluating...";
});
</script>